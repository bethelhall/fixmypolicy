{
  "Requests": [
    {
      "id": "allow_cloudwatch_listmetrics_for_s3",
      "Effect": "allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_cloudwatch_getmetricstatistics_bucket",
      "Effect": "allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_s3_listbucket_top_level_delimiter",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user",
      "Condition": {
        "StringEquals": {
          "s3:delimiter": "/"
        }
      }
    },
    {
      "id": "allow_s3_listbucket_prefix_logs",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user",
      "Condition": {
        "StringLike": {
          "s3:prefix": "logs/*"
        }
      }
    },
    {
      "id": "allow_s3_getobject_toplevel_file",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/top-level-folder1/report.csv"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_s3_getbucketlocation",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_s3_listallmybuckets",
      "Effect": "allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_s3_getbucketmetricsconfiguration",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketMetricsConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_s3_getbucketpolicy",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    }
  ]
}