{
  "Requests": [
    {
      "id": "deny_passrole_to_ec2",
      "Effect": "deny",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-runner",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "id": "deny_lambda_invoke_function",
      "Effect": "deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-west-2:123456789012:function:ggv2-component-handler"
      ],
      "Principal": "arn:aws:iam::123456789012:user/greengrass-operator"
    },
    {
      "id": "deny_s3_put_bucket_policy",
      "Effect": "deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::ggv2-artifacts-123456-us-west-2"
      ],
      "Principal": "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
    },
    {
      "id": "deny_iam_create_user",
      "Effect": "deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:user/audit"
      ],
      "Principal": "arn:aws:iam::123456789012:user/greengrass-operator"
    },
    {
      "id": "deny_iot_delete_policy_version",
      "Effect": "deny",
      "Action": [
        "iot:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iot:us-west-2:123456789012:policy/GreengrassV2IoTThingPolicy"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-runner"
    },
    {
      "id": "deny_logs_put_retention_policy",
      "Effect": "deny",
      "Action": [
        "logs:PutRetentionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:123456789012:log-group:/aws/greengrass/Nucleus"
      ],
      "Principal": "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
    },
    {
      "id": "deny_sts_assume_cross_account_role",
      "Effect": "deny",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::111122223333:role/OrgAccountAdmin"
      ],
      "Principal": "arn:aws:iam::123456789012:user/greengrass-operator"
    },
    {
      "id": "deny_s3_list_all_buckets",
      "Effect": "deny",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-runner"
    },
    {
      "id": "deny_iam_update_assume_role_policy",
      "Effect": "deny",
      "Action": [
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
      ],
      "Principal": "arn:aws:iam::123456789012:user/greengrass-operator"
    },
    {
      "id": "deny_iot_attach_security_profile",
      "Effect": "deny",
      "Action": [
        "iot:AttachSecurityProfile"
      ],
      "Resource": [
        "arn:aws:iot:us-west-2:123456789012:securityprofile/GGSecurityProfile",
        "arn:aws:iot:us-west-2:123456789012:thinggroup/GreengrassCoreDevices"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-runner"
    }
  ]
}