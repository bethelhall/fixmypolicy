{
  "Requests": [
    {
      "id": "allow_passrole_prod_role_by_user_ec2_operator",
      "Effect": "allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/EC2AppRole-Prod"
      ],
      "Principal": "arn:aws:iam::123456789012:user/ec2-operator",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "id": "allow_passrole_dev_role_by_role_operations_team",
