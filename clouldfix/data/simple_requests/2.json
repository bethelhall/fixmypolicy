{
  "Requests": [
    {
      "id": "test_1_iam_user_console_access",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {
        "StringEquals": {
          "aws:SourceIp": "192.168.1.1"
        }
      }
    },
    {
      "id": "test_2_iam_user_list_objects",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {
        "StringEquals": {
          "aws:UserAgent": "AWS Management Console"
        }
      }
    },
    {
      "id": "test_3_iam_user_put_object",
      "Effect": "allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name/file.txt"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_4_iam_user_delete_object",
      "Effect": "allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name/logs/*"
      ],
      "Principal": "IAM User ARN",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpce": "vpce-different"
        }
      }
    },
    {
      "id": "test_5_iam_user_get_bucket_policy",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_6_wrong_bucket_correct_vpce",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name/data.json"
      ],
      "Principal": "arn:aws:iam::123456789012:user/different-user",
      "Condition": {
        "StringEquals": {
          "aws:SourceVpce": "vpce-1a2b3c4d"
        }
      }
    },
    {
      "id": "test_7_iam_user_bucket_acl",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_8_iam_user_multipart_upload",
      "Effect": "allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name/*"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_9_wrong_resource_name",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "arn:aws:iam::123456789012:user/another-user",
      "Condition": {
        "StringEquals": {
          "aws:SourceVpce": "vpce-1a2b3c4d"
        }
      }
    },
    {
      "id": "test_10_iam_user_put_bucket_policy",
      "Effect": "allow",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_11_iam_user_bucket_versioning",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    },
    {
      "id": "test_12_iam_user_object_tagging",
      "Effect": "allow",
      "Action": [
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::S3 bucket Name/config/*"
      ],
      "Principal": "IAM User ARN",
      "Condition": {}
    }
  ]
}