{
  "Requests": [
    {
      "id": "allow_ecr_get_auth_token_cross_account_role",
      "Effect": "allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:sts::111111111111:assumed-role/CrossAccountEcrPullerRole/ProdSession"
    },
    {
      "id": "allow_ecr_batch_get_image_my_app",
      "Effect": "allow",
      "Action": [
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:222222222222:repository/my-app"
      ],
      "Principal": "arn:aws:sts::111111111111:assumed-role/CrossAccountEcrPullerRole/ProdSession"
    },
    {
      "id": "allow_ecr_get_download_url_backend",
      "Effect": "allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:us-west-2:222222222222:repository/backend"
      ],
      "Principal": "arn:aws:sts::111111111111:assumed-role/CrossAccountEcrPullerRole/ProdSession"
    },
    {
      "id": "allow_ecr_batch_check_layer_availability_prod_web",
      "Effect": "allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:222222222222:repository/prod-web"
      ],
      "Principal": "arn:aws:sts::111111111111:assumed-role/CrossAccountEcrPullerRole/ProdSession"
    },
    {
      "id": "deny_s3_getobject_root_my_bucket",
      "Effect": "deny",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::mybucket/secret.json"
      ],
      "Principal": "arn:aws:iam::222222222222:root",
      "Condition": {
        "StringEquals": {
          "identitystore:UserId": "<UserId>"
        }
      }
    },
    {
      "id": "deny_s3_getobjectversion_root_my_bucket",
      "Effect": "deny",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::mybucket/config.yaml"
      ],
      "Principal": "arn:aws:iam::222222222222:root",
      "Condition": {
        "StringEquals": {
          "identitystore:UserId": "<UserId>"
        }
      }
    },
    {
      "id": "allow_ecr_batch_get_image_analytics",
      "Effect": "allow",
      "Action": [
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:222222222222:repository/analytics"
      ],
      "Principal": "arn:aws:sts::111111111111:assumed-role/CrossAccountEcrPullerRole/ProdSession"
    },
    {
      "id": "allow_ecr_get_download_url_analytics_eu",
      "Effect": "allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:222222222222:repository/analytics"
      ]
    }
  ]
}