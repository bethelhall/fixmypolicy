{
  "Requests": [
    {
      "id": "ssm_putobject_correct_bucket",
      "Effect": "allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/logs/ssm-output.log"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "ssm_putobjectacl_correct_bucket",
      "Effect": "allow",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/maintenance-window/output.txt"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "ssm_get_encryption_config",
      "Effect": "allow",
      "Action": [
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "non_ssm_putobject_denied",
      "Effect": "deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/data.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/regular-user"
    },
    {
      "id": "ssm_getobject_denied",
      "Effect": "deny",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/logs/output.log"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "ssm_listbucket_denied",
      "Effect": "deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "external_account_putobject_denied",
      "Effect": "deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/external-data.json"
      ],
      "Principal": "arn:aws:iam::999999999999:root"
    },
    {
      "id": "ssm_deleteobject_denied",
      "Effect": "deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/logs/old-output.log"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "regular_user_putobjectacl_denied",
      "Effect": "deny",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/config.json"
      ],
      "Principal": "arn:aws:iam::123456789012:user/developer"
    },
    {
      "id": "ssm_wrong_bucket_denied",
      "Effect": "deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::different-bucket/output.log"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    },
    {
      "id": "lambda_getencryption_denied",
      "Effect": "deny",
      "Action": [
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name"
      ],
      "Principal": "arn:aws:iam::123456789012:role/lambda-execution-role"
    },
    {
      "id": "ssm_putobject_with_acl",
      "Effect": "allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket_name/ssm-logs/2024/output.log"
      ],
      "Principal": "arn:aws:iam::SSM_account_id:root"
    }
  ]
}