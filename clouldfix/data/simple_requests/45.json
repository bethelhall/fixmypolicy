{
  "Requests": [
    {
      "id": "allow_iot_create_role_alias_1",
      "Effect": "allow",
      "Action": [
        "iot:CreateRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:rolealias/dev-alias"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "allow_iot_update_role_alias_1",
      "Effect": "allow",
      "Action": [
        "iot:UpdateRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:rolealias/dev-alias"
      ],
      "Principal": "arn:aws:iam::123456789012:role/Developer"
    },
    {
      "id": "allow_iot_describe_role_alias_1",
      "Effect": "allow",
      "Action": [
        "iot:DescribeRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-west-2:123456789012:rolealias/telemetry-alias"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "allow_iot_list_tags_for_role_alias_1",
      "Effect": "allow",
      "Action": [
        "iot:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:rolealias/dev-alias"
      ],
      "Principal": "arn:aws:iam::123456789012:role/Developer"
    },
    {
      "id": "deny_s3_put_bucket_cors_public_bucket_1",
      "Effect": "deny",
      "Action": [
        "s3:PutBucketCORS"
      ],
      "Resource": [
        "arn:aws:s3:::myapp-us-east-1-12345-pub"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "deny_s3_put_encryption_config_private_bucket_1",
      "Effect": "deny",
      "Action": [
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::myapp-us-east-1-12345-prv"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "deny_cloudwatch_put_metric_data_1",
      "Effect": "deny",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/Developer",
      "Condition": {
        "StringEquals": {
          "cloudwatch:Namespace": "MyApp/Dev"
        }
      }
    },
    {
      "id": "deny_ec2_describe_tags_1",
      "Effect": "deny",
      "Action": [
        "ec2:DescribeTags"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "deny_ses_send_email_1",
      "Effect": "deny",
      "Action": [
        "ses:SendEmail"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/devuser"
    },
    {
      "id": "deny_s3_delete_object_1",
      "Effect": "deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/Developer"
    }
  ]
}