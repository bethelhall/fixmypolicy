{
  "Requests": [
    {
      "id": "allow_iam_user_putobject_from_allowed_ip",
      "Effect": "allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::{bucket_name}/*"
      ],
      "Principal": "IAM User ARN",
      "Condition": {
        "IpAddress": {
          "aws:VpcSourceIp": "124.215.101.111/32"
        }
      }
    },
    {
      "id": "allow_backup_role_listbucket",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::{bucket_name}"
      ],
      "Principal": "AWS Backup Service Role ARN"
    },
    {
      "id": "allow_backup_role_getobject",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::{bucket_name}/*"
      ],
      "Principal": "AWS Backup Service Role ARN"
    },
    {
      "id": "deny_cloudfront_create_vpc_origin",
      "Effect": "deny",
      "Action": [
        "cloudfront:CreateVpcOrigin"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/unrelated"
    },
    {
      "id": "deny_cloudfront_tag_resource",
      "Effect": "deny",
      "Action": [
        "cloudfront:TagResource"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/RandomRole"
    },
    {
      "id": "deny_cloudfront_delete_vpc_origin",
      "Effect": "deny",
      "Action": [
        "cloudfront:DeleteVpcOrigin"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/someuser"
    }
  ]
}