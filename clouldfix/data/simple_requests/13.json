{
  "Requests": [
    {
      "id": "allow_create_log_group_us_east_2_pipeline_group",
      "Effect": "allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/my-pipeline"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "allow_create_log_stream_source_action_stream",
      "Effect": "allow",
      "Action": [
        "logs:CreateLogStream"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/my-pipeline:log-stream:Source-Action"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "allow_put_log_events_source_action_stream",
      "Effect": "allow",
      "Action": [
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/my-pipeline:log-stream:Source-Action"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "allow_put_log_events_any_stream_under_pipeline_group",
      "Effect": "allow",
      "Action": [
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/my-pipeline:log-stream:*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "deny_put_log_events_other_pipeline_log_group",
      "Effect": "deny",
      "Action": [
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/other-pipeline:log-stream:Source-Action"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "deny_create_log_group_wrong_region_us_east_1",
      "Effect": "deny",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:123456789012:log-group:/aws/codepipeline/my-pipeline"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    },
    {
      "id": "allow_create_log_stream_build_action_stream",
      "Effect": "allow",
      "Action": [
        "logs:CreateLogStream"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:123456789012:log-group:/aws/codepipeline/my-pipeline:log-stream:Build-Action"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CodePipelineServiceRole"
    }
  ]
}