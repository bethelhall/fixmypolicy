{
  "Requests": [
    {
      "id": "allow_spectrum_getobject_vpce",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::xxxxxxx-159170848751291/spectrum-data/table1/part-00000.parquet"
      ],
      "Principal": "Redshift IAM Role ARN",
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "vpce-xxxxxxxxxxxxxxxxx",
          "aws:PrincipalArn": "Redshift IAM Role ARN"
        }
      }
    },
    {
