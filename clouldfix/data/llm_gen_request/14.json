{
  "Requests": [
    {
      "id": "greengrass_iot_device_test_request",
      "Effect": "allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
      ],
      "Principal": "arn:aws:iam::123456789012:user/greengrass-test-user",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "greengrass.amazonaws.com"
        }
      }
    }
  ]
}