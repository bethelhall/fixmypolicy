{
  "Requests": [
    {
      "id": "allow_a1b2c3",
      "Effect": "allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:123456789012:instance/*"
      ],
      "Condition": {
