{
  "Requests": [
    {
      "id": "test_iot_role_alias_request",
      "Effect": "allow",
      "Action": [
        "iot:CreateRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:rolealias/MyDeviceRoleAlias"
      ],
      "Principal": "arn:aws:iam::123456789012:user/developer",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}