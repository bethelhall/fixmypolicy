{
  "Requests": [
    {
      "id": "redshift_spectrum_s3_access",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::xxxxxxx-159170848751291/external-table-data/*"
      ],
      "Principal": "Redshift IAM Role ARN",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "Redshift IAM Role ARN"
        }
      }
    }
  ]
}