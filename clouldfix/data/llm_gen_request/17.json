{
  "Requests": [
    {
      "id": "ssm_port_forwarding_request",
      "Effect": "allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:123456789012:document/AWS-StartPortForwardingSessionToRemoteHost"
      ],
      "Principal": "arn:aws:iam::123456789012:user/developer",
      "Condition": {
        "StringEquals": {
          "ssm:SessionDocumentAccessCheck": "true"
        }
      }
    }
  ]
}