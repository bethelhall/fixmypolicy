{
  "Requests": [
    {
      "id": "dynamodb_query_request",
      "Effect": "allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:123456789012:table/MyTable"
      ],
      "Principal": "arn:aws:iam::123456789012:role/lambda-execution-role",
      "Condition": {
        "Bool": {
          "aws:PrincipalIsAWSService": "true"
        }
      }
    }
  ]
}