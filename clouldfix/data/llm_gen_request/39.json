{
  "Requests": [
    {
      "id": "config_conformance_pack_access",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::awsconfigconforms-example-suffix/conformance-pack-template.yaml"
      ],
      "Principal": "arn:aws:iam::123456789012:role/aws-service-role/config-conforms.amazonaws.com/AWSServiceRoleForConfigConforms",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-example123456"
        }
      }
    }
  ]
}