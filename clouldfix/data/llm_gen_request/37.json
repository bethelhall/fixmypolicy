{
  "Requests": [
    {
      "id": "test_eventbridge_putevents",
      "Effect": "allow",
      "Action": [
        "events:PutEvents"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:accountID:event-bus/eventbusname"
      ],
      "Principal": "arn:aws:iam::123456789012:user/orguser",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "OrgID"
        }
      }
    }
  ]
}