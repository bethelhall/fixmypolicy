{
  "Requests": [
    {
      "id": "ecr_access_request",
      "Effect": "allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/CrossAccountRole",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}