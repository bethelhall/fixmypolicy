{
  "Requests": [
    {
      "id": "sns_sqs_sendmessage_request",
      "Effect": "allow",
      "Action": [
        "SQS:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:af-south-1:XXXXXXXXXXXX:second-queue.fifo"
      ],
      "Principal": "arn:aws:iam::XXXXXXXXXXXX:root",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:sns:af-south-1:XXXXXXXXXXXX:topic.fifo"
        }
      }
    }
  ]
}