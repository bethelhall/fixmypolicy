{
  "Requests": [
    {
      "id": "route53resolver_log_delivery_request",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::my-backups-sn"
      ],
      "Principal": "delivery.logs.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceOrgID": "o-XXXXX"
        }
      }
    }
  ]
}