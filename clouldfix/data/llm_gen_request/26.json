{
  "Requests": [
    {
      "id": "vpc_origin_creation_request",
      "Effect": "allow",
      "Action": [
        "cloudfront:CreateVpcOrigin"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789:role/lambda-execution-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}