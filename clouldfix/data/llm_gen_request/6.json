{
  "Requests": [
    {
      "id": "test_iam_identity_center_secret_access",
      "Effect": "allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:my-secret-abc123"
      ],
      "Principal": "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/us-east-1/AWSReservedSSO_Role",
      "Condition": {
        "StringNotEquals": {
          "aws:sourceVpce": "vpce-myvpce"
        }
      }
    }
  ]
}