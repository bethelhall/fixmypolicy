{
  "Requests": [
    {
      "id": "ec2_create_tags_production",
      "Effect": "allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:010526265345:instance/i-1234567890abcdef0"
      ],
      "Principal": "arn:aws:iam::010526265345:role/EC2TaggingRole",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/environment": "production"
        }
      }
    }
  ]
}