{
  "Requests": [
    {
      "id": "s3_metrics_access_test",
      "Effect": "allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/testuser",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}