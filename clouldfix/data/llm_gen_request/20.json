{
  "Requests": [
    {
      "id": "ec2_attach_instance_profile_request",
      "Effect": "allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/EC2InstanceRole"
      ],
      "Principal": "arn:aws:iam::123456789012:user/ec2-user",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}