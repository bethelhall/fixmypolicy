{
  "Requests": [
    {
      "id": "allow_get_bucket_acl_bucket_root",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket arn}"
    },
    {
      "id": "allow_put_object_valid_key_vpc_logs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "${bucket arn}/AWSLogs/123456789012/vpcflowlogs/af-south-1/2025/10/15/0001.gz"
    },
    {
      "id": "deny_get_bucket_acl_on_object_arn",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket arn}/README.txt"
    },
    {
      "id": "deny_put_object_other_bucket",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::someone-elses-bucket/path/file.gz"
    },
    {
      "id": "deny_get_bucket_acl_other_bucket",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::someone-elses-bucket"
    },
    {
      "id": "deny_delete_object_not_allowed",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "${bucket arn}/old/file.gz"
    },
    {
      "id": "deny_put_object_bucket_root",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "${bucket arn}"
    },
    {
      "id": "deny_get_bucket_location",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "${bucket arn}"
    },
    {
      "id": "allow_put_object_valid_key_generic",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "${bucket arn}/some/prefix/another.gz"
    },
    {
      "id": "allow_get_bucket_acl_bucket_root_again",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket arn}"
    }
  ]
}
