{
"Requests": [
{
"id": "allow_subscribe_dev_updates",
"Effect": "Allow",
"Action": "iot:Subscribe",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter//resource/dev/updates"
},
{
"id": "allow_receive_prod_metrics",
"Effect": "Allow",
"Action": "iot:Receive",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic//resource/prod/metrics"
},
{
"id": "allow_connect_any",
"Effect": "Allow",
"Action": "iot:Connect",
"Resource": "*"
},
{
"id": "deny_subscribe_wrong_single_slash",
"Effect": "Deny",
"Action": "iot:Subscribe",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter/resource/dev/updates"
},
{
"id": "deny_receive_wrong_single_slash",
"Effect": "Deny",
"Action": "iot:Receive",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic/resource/dev/alerts"
},
{
"id": "deny_subscribe_outside_resource_prefix",
"Effect": "Deny",
"Action": "iot:Subscribe",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter/foo/bar/baz"
},
{
"id": "deny_receive_outside_resource_prefix",
"Effect": "Deny",
"Action": "iot:Receive",
"Resource": "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic/anything/goes/here"
}
]
}