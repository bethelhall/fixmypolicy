{
  "Requests": [
    {
      "id": "allow_get_bucket_acl_root",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs"
    },
    {
      "id": "allow_put_object_awslogs_key",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/AWSLogs/123456789012/CloudTrail/us-east-2/2025/10/15/0001.gz"
    },
    {
      "id": "allow_put_object_generic_path",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/some/prefix/file.log"
    },
    {
      "id": "allow_put_object_nested_dirs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/x/y/z/part-0000"
    },
    {
      "id": "allow_put_object_zero_byte",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/healthcheck"
    },

    {
      "id": "deny_get_bucket_acl_on_object_arn",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/readme.txt"
    },
    {
      "id": "deny_put_object_bucket_root",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs"
    },
    {
      "id": "deny_put_object_other_bucket",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::some-other-bucket/path/file.gz"
    },
    {
      "id": "deny_get_bucket_location",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs"
    },
    {
      "id": "deny_list_bucket",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs"
    },
    {
      "id": "deny_delete_object",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/old/file.gz"
    },
    {
      "id": "deny_get_object",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bkt-trulab-auth0-logs/some/prefix/file.log"
    }
  ]
}
