{
  "Requests": [
    {
      "id": "allow_iot_create_role_alias_dev",
      "Effect": "allow",
      "Action": [
        "iot:CreateRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:111122223333:rolealias/devDeviceRoleAlias"
      ],
      "Principal": "arn:aws:iam::111122223333:user/dev-user1"
    },
    {
      "id": "allow_iot_update_role_alias_edge",
      "Effect": "allow",
      "Action": [
        "iot:UpdateRoleAlias"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:111122223333:rolealias/edgeRoleAlias"
      ],
      "Principal": "arn:aws:iam::111122223333:role/Developer"
    },
    {
      "id": "allow_iot_list_tags_role_alias_dev",
      "Effect": "allow",
      "Action": [
        "iot:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:111122223333:rolealias/devDeviceRoleAlias"
      ],
      "Principal": "arn:aws:iam::111122223333:user/dev-ops"
    },
    {
      "id": "deny_s3_put_object_dev_app_data",
      "Effect": "deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::dev-app-data/uploads/file1.txt"
      ],
      "Principal": "arn:aws:iam::111122223333:user/dev-app"
    },
    {
      "id": "deny_s3_put_bucket_website_pub_bucket",
      "Effect": "deny",
      "Action": [
        "s3:PutBucketWebsite"
      ],
      "Resource": [
        "arn:aws:s3:::myapp-app1-dev-pub"
      ],
      "Principal": "arn:aws:iam::111122223333:user/web-admin"
    },
    {
      "id": "deny_ses_send_raw_email",
      "Effect": "deny",
      "Action": [
        "ses:SendRawEmail"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::111122223333:user/dev-ses"
    },
    {
      "id": "deny_cloudwatch_put_metric_data",
      "Effect": "deny",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::111122223333:role/monitoring"
    },
    {
      "id": "deny_ec2_describe_tags",
      "Effect": "deny",
      "Action": [
        "ec2:DescribeTags"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::111122223333:user/dev-ec2"
    }
  ]
}