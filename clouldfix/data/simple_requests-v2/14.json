{
  "Requests": [
    {
      "id": "deny_iam_passrole_to_ec2",
      "Effect": "deny",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/GreengrassV2TokenExchangeRole"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "id": "deny_s3_put_bucket_policy",
      "Effect": "deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::ggv2-idt-artifacts"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_logs_delete_log_group",
      "Effect": "deny",
      "Action": [
        "logs:DeleteLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:123456789012:log-group:/aws/greengrass/NucleusIdt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_iot_create_policy_version",
      "Effect": "deny",
      "Action": [
        "iot:CreatePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iot:us-west-2:123456789012:policy/GreengrassV2IoTThingPolicy"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_iot_update_account_audit_config",
      "Effect": "deny",
      "Action": [
        "iot:UpdateAccountAuditConfiguration"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_iam_create_user",
      "Effect": "deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_lambda_add_permission",
      "Effect": "deny",
      "Action": [
        "lambda:AddPermission"
      ],
      "Resource": [
        "arn:aws:lambda:us-west-2:123456789012:function:ggv2-idt-test-fn"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    },
    {
      "id": "deny_execute_api_manage_connections",
      "Effect": "deny",
      "Action": [
        "execute-api:ManageConnections"
      ],
      "Resource": [
        "arn:aws:execute-api:us-west-2:123456789012:abcdefghij/test/POST/@connections/*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/idt-operator"
    }
  ]
}