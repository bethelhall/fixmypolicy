{
  "Requests": [
    {
      "id": "allow_list_bucket_sso_role_alice",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::acme-data-bucket"
      ],
      "Principal": "arn:aws:sts::123456789012:assumed-role/SSOAccessRole/alice",
      "Condition": {
        "StringEquals": {
          "aws:userid": "AROA123456789EXAMPLE:alice"
        }
      }
    },
