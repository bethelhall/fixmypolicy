      ],
      "Resource": [
        "arn:aws:s3:::bucket-name/README.md"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "id": "allow_putobject_https_logs_daily",
      "Effect": "allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-name/logs/2025-08-21.log"
