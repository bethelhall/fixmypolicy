{
  "Requests": [
    {
      "id": "allow_listbucket_https",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-name"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "id": "allow_getobject_https_reports_2025",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-name/reports/2025/summary.pdf"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "id": "allow_putobject_https_uploads_newfile",
      "Effect": "allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-name/uploads/newfile.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "id": "allow_deleteobject_https_tmp_oldlog",
      "Effect": "allow",
