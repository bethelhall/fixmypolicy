{
  "Requests": [
    {
      "id": "allow_iot_connect_webapp_client",
      "Effect": "allow",
      "Action": [
        "iot:Connect"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:client/webapp-123"
      ]
    },
    {
      "id": "allow_subscribe_exact_resource_event",
      "Effect": "allow",
      "Action": [
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter//resource/abc123/event"
      ]
    },
    {
      "id": "allow_receive_exact_resource_event",
      "Effect": "allow",
      "Action": [
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic//resource/abc123/event"
      ]
    },
    {
      "id": "allow_subscribe_single_level_wildcard",
      "Effect": "allow",
      "Action": [
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter//resource/abc123/+/status"
      ]
    },
    {
      "id": "allow_receive_deeper_child_topic",
      "Effect": "allow",
      "Action": [
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic//resource/abc123/event/child"
      ]
    },
    {
      "id": "allow_subscribe_multi_level_wildcard",
      "Effect": "allow",
      "Action": [
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topicfilter//resource/def456/#"
      ]
    },
    {
      "id": "allow_receive_other_resource_event",
      "Effect": "allow",
      "Action": [
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-1:ACCOUNT_ID:topic//resource/def456/event"
      ]
    }
  ]
}