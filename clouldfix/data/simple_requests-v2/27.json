{
  "Requests": [
    {
      "id": "allow_list_bucket_for_folders",
      "Effect": "allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_cloudwatch_list_metrics_for_s3",
      "Effect": "allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_cloudwatch_get_metric_statistics_for_s3",
      "Effect": "allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_list_all_buckets_console_access",
      "Effect": "allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_get_bucket_location",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_get_bucket_metrics_configuration",
      "Effect": "allow",
      "Action": [
        "s3:GetBucketMetricsConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    },
    {
      "id": "allow_get_object_for_size_checks",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/metrics-user"
    }
  ]
}