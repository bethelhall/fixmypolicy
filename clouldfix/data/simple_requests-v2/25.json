    {
      "id": "deny_execute_api_invoke_from_stg_root",
      "Effect": "deny",
      "Action": [
        "execute-api:Invoke"
      ],
      "Resource": [
        "arn:aws:execute-api:region:api_gw_account_id:xsdxxxsdx/*"
      ],
      "Principal": "arn:aws:iam::here_stg_account_id:root"
    },
    {
      "id": "deny_execute_api_invoke_from_api_gw_root",
