{
  "Requests": [
    {
      "id": "allow_index_html_via_cloudfront_oac",
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::<S3 bucket name>/index.html"
      ],
      "Principal": "cloudfront.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::111122223333:distribution/<CloudFront distribution ID>"
        }
      }
    },
    {
      "id": "allow_css_asset_via_cloudfront_oac",
      "Effect": "allow",
