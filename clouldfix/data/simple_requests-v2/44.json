{
  "Requests": [
    {
      "id": "allow_sqs_send_by_role1",
      "Effect": "allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:123456789012:queue1"
      ],
      "Principal": "arn:aws:iam::111122223333:role/role1"
    },
    {
      "id": "allow_sqs_receive_delete_by_user1",
      "Effect": "allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:123456789012:queue1"
      ],
      "Principal": "arn:aws:iam::111122223333:user/username1"
    },
    {
      "id": "allow_sqs_get_set_attrs_by_role1",
      "Effect": "allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:123456789012:queue1"
      ],
      "Principal": "arn:aws:iam::111122223333:role/role1"
    },
    {
      "id": "allow_sqs_purge_by_user1",
      "Effect": "allow",
      "Action": [
        "sqs:PurgeQueue"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:123456789012:queue1"
      ],
      "Principal": "arn:aws:iam::111122223333:user/username1"
    },
    {
      "id": "deny_s3_putobject_by_000_user",
      "Effect": "deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucketname/snapshots/redis-snap.rdb"
      ],
      "Principal": "arn:aws:iam::000:user/username"
    },
    {
      "id": "deny_s3_listbucket_by_000_user",
      "Effect": "deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucketname"
      ],
      "Principal": "arn:aws:iam::000:user/username"
    },
    {
      "id": "allow_sqs_deletequeue_by_role1",
      "Effect": "allow",
      "Action": [
        "sqs:DeleteQueue"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:123456789012:queue1"
      ],
      "Principal": "arn:aws:iam::111122223333:role/role1"
    }
  ]
}