{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSSSMWrite",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws-us-gov:iam::<acct#>:root"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws-us-gov:s3:::prod-ssm/Patching/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control"
        }
      }
    },
    {
      "Sid": "AWSSSMRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws-us-gov:iam::<acct#>:root"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws-us-gov:s3:::prod-ssm/Patching/*"
    },
    {
      "Sid": "LambdaInvoke",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws-us-gov:iam::<acct#>:root"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:444455556666:function:function-name"
    }
  ]
}