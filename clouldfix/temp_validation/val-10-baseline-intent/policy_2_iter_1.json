{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "s3Access",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "sesEmailAccess",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Cloudwatch",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ec2Access",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3PublicBucketConfig",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketWebsite",
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::myapp-*-*-pub"
    },
    {
      "Sid": "S3PrivateBucketConfig",
      "Effect": "Allow",
      "Action": [
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::myapp-*-*-prv"
    },
    {
      "Sid": "allow_d7f3a8e2",
      "Effect": "Allow",
      "Action": "iot:CreateRoleAlias",
      "Resource": "arn:aws:iot:us-east-1:123456789012:rolealias/MyRoleAlias"
    },
    {
      "Sid": "allow_c4e9b1f6",
      "Effect": "Allow",
      "Action": "iot:DescribeRoleAlias",
      "Resource": "*"
    },
    {
      "Sid": "allow_e5a2f8d9",
      "Effect": "Allow",
      "Action": "iot:UpdateRoleAlias",
      "Resource": "arn:aws:iot:eu-west-1:123456789012:rolealias/ProductionAlias"
    },
    {
      "Sid": "allow_f1e8d5a3",
      "Effect": "Allow",
      "Action": "iot:DeleteRoleAlias",
      "Resource": "arn:aws:iot:us-west-2:123456789012:rolealias/TempAlias"
    },
    {
      "Sid": "allow_b9f4e1a6",
      "Effect": "Allow",
      "Action": "iot:ListTagsForResource",
      "Resource": "arn:aws:iot:ap-south-1:123456789012:rolealias/DevAlias"
    },
    {
      "Sid": "deny_b2d8e4f1",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-bucket/file.txt"
    },
    {
      "Sid": "deny_a6f9c3e7",
      "Effect": "Deny",
      "Action": "ses:SendEmail",
      "Resource": "*"
    },
    {
      "Sid": "deny_d7c2b9e4",
      "Effect": "Deny",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*"
    },
    {
      "Sid": "deny_e3a8d5f2",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "*"
    },
    {
      "Sid": "deny_a1f6c9b4",
      "Effect": "Deny",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:s3:::myapp-prod-us-pub"
    },
    {
      "Sid": "deny_f8e3d2a7",
      "Effect": "Deny",
      "Action": "ses:SendRawEmail",
      "Resource": "*"
    },
    {
      "Sid": "deny_c5d7f3e8",
      "Effect": "Deny",
      "Action": "ec2:DescribeTags",
      "Resource": "*"
    }
  ]
}