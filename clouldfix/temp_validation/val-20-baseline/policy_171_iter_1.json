{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2CreationInfraOwnerTag",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/InfraOwner": "true"
        }
      }
    },
    {
      "Sid": "AllowEC2CreationProductTag",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Product": "true"
        }
      }
    },
    {
      "Sid": "AllowEC2CreationNameTag",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Name": "true"
        }
      }
    },
    {
      "Sid": "AllowLambdaCreationInfraOwnerTag",
      "Effect": "Allow",
      "Action": [
        "lambda:Create*"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/InfraOwner": "true"
        }
      }
    },
    {
      "Sid": "AllowLambdaCreationProductTag",
      "Effect": "Allow",
      "Action": [
        "lambda:Create*"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Product": "true"
        }
      }
    },
    {
      "Sid": "AllowLambdaCreationNameTag",
      "Effect": "Allow",
      "Action": [
        "lambda:Create*"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Name": "true"
        }
      }
    },
    {
      "Sid": "AllowDynamoDBCreationNameTag",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Name": "true"
        }
      }
    }
  ]
}