{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyBlockedUserOnDeniedActionsInCertainRegionsAndResources",
      "Effect": "Deny",
      "Action": [
        "sns:Publish",
        "sqs:ReceiveMessage",
        "dynamodb:PutItem",
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-0/file-0.txt",
        "arn:aws:s3:::denied-bucket-1/file-1.txt",
        "arn:aws:s3:::denied-bucket-3/file-3.txt",
        "arn:aws:iam::000001:role/XXXXXXX-runner-forbidden-resource",
        "arn:aws:s3:::denied-bucket-4/file-4.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        },
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowAliceToPerformSpecificIAMactionsOnlyWithinEUWest1andUSWest2regions",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "iam:UpdateLoginProfile",
        "sqs:ListQueueTags"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "eu-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "AllowBobtoModifyLambdafunctionsonlywithinUSEast1region",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyAdminRoleonDynamoDBoperationswithConditions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner-*",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyTestUserondeniedARNincertainAWSservices",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner-specific",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleperformCloudFormationrelatedactivities",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowDeveloperRoletoManageSQSqueuestags",
      "Effect": "Allow",
      "Action": [
        "sqs:ListQueueTags"
      ],
      "Resource": "arn:aws:iam::000001:role/XXXXXXX-runner",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyRDSDeletionfromDeveloperrolewithexceptionIPaddress",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        },
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowEC2CreationbySpecifiedPrincipals",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "*",
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::111222333444:role/developer-role"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}