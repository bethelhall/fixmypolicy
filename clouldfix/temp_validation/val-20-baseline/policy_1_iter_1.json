{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublishingToSNSTopicFromSpecificTableInGlueAndOnlyForEUWest1",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-21",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyAccessToCertainResourcesBasedOnRegionAndRole",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyDeletionOfDynamoDBItemsByCrossAccountUsers",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "AllowDescribingKinesisStreamsThatAreAccessibleViaIAMRoles",
      "Effect": "Allow",
      "Action": "kinesis:DescribeStream",
      "Resource": "arn:aws:s3:::bucket-40/file-9.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowGettingMetricsWithCloudWatchIfRequestIsMadeThroughEUWest1",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "arn:aws:s3:::bucket-6/file-6.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowListingBucketsUsingCorrectIAMUserAndRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-16/table-11",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyCreationOfUnauthorizedUsersInUnwantedRegions",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowDeletingLogsGroupsWithinEUWest1",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-3",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowPuttingObjectsIntoSpecifiedS3BucketWhenMakingRequestsInEUWest1",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bucket-20/file-7.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowListingABucketBecauseTheRequesterHasPermissions",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-6/table-6",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCreatingRepositoriesDueToPolicyRequirements",
      "Effect": "Allow",
      "Action": "codecommit:CreateRepository",
      "Resource": "arn:aws:s3:::bucket-28/file-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyRunningInstancesOutsideUSWEST2andSecuredTransportsRequired",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}