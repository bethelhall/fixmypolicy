{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": [
        "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": [
        "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/*"
      ],
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "s3:GetObjectAcl",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-39-15.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "lambda:InvokeFunction",
      "Resource": "authorized/arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/*/file.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::111222333444:user/temp-user",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/file-49-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-12-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Action": "kms:GetKeyPolicy",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-7-9.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/*-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "ec2:RunInstances",
      "Resource": "forbidden-arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/*-specific",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*-forbidden-resource",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Action": "sns:Subscribe",
      "Resource": "forbidden-arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*-specific",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Action": "rds:CreateDBInstance",
      "Resource": "authorized/arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Action": "glue:UpdateTable",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/file-48-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::111222333444:user/temp-user",
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/file-33-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Action": "kms:EnableKey",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/file-39-16.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "iam:ListRoles",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-6-8.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::111222333444:user/temp-user",
      "Action": "redshift:DeleteCluster",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-49-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Action": "config:PutConfigRule",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/file-3-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "s3:DeleteBucketWebsite",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-28-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "codedeploy:CreateDeployment",
      "Resource": "arn:aws:execute-api:ap-northeast-2:0xxxxxxxxxx2:rxxxxxx2/*/GET/user/*/api/file-32-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}