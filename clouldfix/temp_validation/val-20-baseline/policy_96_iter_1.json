    },
    {
      "Effect": "Allow",
      "Action": "codecommit:DeleteRepository",
      "Resource": "arn:aws:sns:eu-west-1:account-b-id:sns-topic-name",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
