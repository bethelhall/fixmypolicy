      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:eu-west-1:account-b-id:sns-topic-name",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": [
            "account-b-id",
            "account-a-id"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "iam:ListAccessKeys",
      "Resource": "arn:aws:sns:eu-west-1:account-b-id:sns-topic-name",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:DescribeVolumes",
      "Resource": "arn:aws:sns:eu-west-1:account-b-id:sns-topic-name",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": [
            "account-b-id",
            "account-a-id"
          ]
        }
      }
