{
  "Version": "2012-10-17",
  "Id": "example-ID",
  "Statement": [
    {
      "Sid": "Example SNS topic policy",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": [
        "SNS:Publish"
      ],
      "Resource": "SNS-topic-ARN",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "bucket-owner-account-id"
        }
      }
    },
    {
      "Sid": "allow_aa06d2e8",
      "Effect": "Allow",
      "Action": "s3:DeleteBucketLifecycle",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deny_9457dc8b",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_914e04fc",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deny_16b41556",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "forbidden-SNS-topic-ARN-specific",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_34ffc8a6",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "allow_c0aafeb3",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_48979d40",
      "Effect": "Allow",
      "Action": "athena:StopQueryExecution",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_9aebf4bb",
      "Effect": "Allow",
      "Action": "iam:ListGroups",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_41fcb782",
      "Effect": "Allow",
      "Action": "kms:ListResourceTags",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_78201e1c",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_393a7e9c",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_658c693e",
      "Effect": "Allow",
      "Action": "kms:EnableKey",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_624db7e3",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "allow_97bf3466",
      "Effect": "Allow",
      "Action": "sqs:SetQueueAttributes",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_6590733d",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "SNS-topic-ARN-forbidden-resource",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "allow_f108245f",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deny_a809935b",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "allow_faa08eb3",
      "Effect": "Allow",
      "Action": "sqs:DeleteMessage",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_d3aa06d2",
      "Effect": "Allow",
      "Action": "iam:GetUser",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_c4506745",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "authorized/SNS-topic-ARN/file.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}