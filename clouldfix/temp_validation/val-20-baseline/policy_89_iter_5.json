{
  "Version": "2012-10-17",
  "Id": "PolicyForCloudFrontPrivateContent",
  "Statement": [
    {
      "Sid": "1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::prerendered-routes/*"
    },
    {
      "Sid": "2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "guardduty:DeleteIPSet",
      "Resource": "arn:aws:s3:::prerendered-routes/file-18-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "ec2:DetachVolume",
      "Resource": "arn:aws:s3:::prerendered-routes/file-41-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "4",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "5",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::252355662767:user"
      },
      "Action": "kms:EnableKey",
      "Resource": "arn:aws:s3:::prerendered-routes/file-23-8.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "6",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::886664563454:user"
      },
      "Action": "s3:PutBucketCors",
      "Resource": "arn:aws:s3:::prerendered-routes/file-29-11.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "7",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::different-prerendered-routes/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "8",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::prerendered-routes/file-2-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "9",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "10",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "logs:CreateLogStream",
      "Resource": "arn:aws:s3:::prerendered-routes/file-14-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "11",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "12",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "s3:GetObjectTagging",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "13",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "sagemaker:DeleteNotebookInstance",
      "Resource": "arn:aws:s3:::prerendered-routes/file-17-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "14",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "s3:GetObjectAcl",
      "Resource": "arn:aws:s3:::prerendered-routes/file-37-11.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "15",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::110419703670:user"
      },
      "Action": "sqs:UntagQueue",
      "Resource": "arn:aws:s3:::prerendered-routes/file-6-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "16",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::prerendered-routes-forbidden/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "17",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::cloudfront:user"
      },
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "18",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::748639831133:user"
      },
      "Action": "sagemaker:DescribeEndpointConfig",
      "Resource": "arn:aws:s3:::prerendered-routes/file-25-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "19",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::778427856207:user"
      },
      "Action": "iam:GetUser",
      "Resource": "arn:aws:s3:::prerendered-routes/file-20-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "20",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "kms:CreateKey",
      "Resource": "arn:aws:s3:::prerendered-routes/file-22-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}