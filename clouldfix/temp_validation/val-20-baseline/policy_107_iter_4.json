{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEC2AuxilliaryInfraOwnerTag",
      "Effect": "Deny",
      "Action": [
        "autoscaling:CreateAutoScalingGroup"
      ],
      "Resource": [
        "arn:aws:autoscaling:*:*:autoScalingGroup/*"
      ]
    },
    {
      "Sid": "DenyECSContainerInstanceRolePolicy",
      "Effect": "Deny",
      "Action": [
        "ecs:RegisterContainerInstance"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "ecs:cluster": [
            "arn:aws:ecs:*:*:cluster/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyElasticsearchDomainCreation",
      "Effect": "Deny",
      "Action": [
        "es:CreateElasticsearchDomain"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyIAMUserAccessKeys",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey"
      ],
      "Resource": [
        "arn:aws:iam::*:user/${aws:username}"
      ]
    },
    {
      "Sid": "DenyKMSDecryptWithoutCMK",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "kms:ViaService": "true"
        }
      }
    },
    {
      "Sid": "DenyLambdaAddPermission",
      "Effect": "Deny",
      "Action": [
        "lambda:AddPermission"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyRDSClusterSnapshotCopy",
      "Effect": "Deny",
      "Action": [
        "rds:CopyDBClusterSnapshot"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyRoute53HostedZoneChanges",
      "Effect": "Deny",
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyS3BucketReplication",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketReplication"
      ],
      "Resource": [
        "arn:aws:s3:::*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyS3BucketWebsiteConfiguration",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketWebsite"
      ],
      "Resource": [
        "arn:aws:s3:::*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenySESOutboundSMTP",
      "Effect": "Deny",
      "Action": [
        "ses:SendRawEmail"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenySSMParameterStore",
      "Effect": "Deny",
      "Action": [
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyStepFunctionsStateMachineLogging",
      "Effect": "Deny",
      "Action": [
        "states:EnableLogging"
      ],
      "Resource": [
        "arn:aws:states:*:*:stateMachine:*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyVPCFlowLogs",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateFlowLogs"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyXRayWriteAccess",
      "Effect": "Deny",
      "Action": [
        "xray:PutTraceSegments"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    }
  ]
}