{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SAMDeployCloudFormation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DescribeStacks"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-south-1:<AccountID>:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:ap-south-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "SAMDeployCloudFormationFullAccess",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "RequestAllowedByTestSets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectAcl",
        "dynamodb:PutItem",
        "sqs:ReceiveMessage",
        "cloudsearch:CreateDomain",
        "ec2:RevokeSecurityGroupIngress",
        "dynamodb:DeleteItem",
        "iam:DeleteUser",
        "ec2:DescribeInstances",
        "kms:PutKeyPolicy",
        "kms:EnableKey",
        "ec2:CreateTags",
        "ses:SendRawEmail",
        "s3:GetBucketVersioning",
        "s3:CreateBucket",
        "cloudformation:CreateStack",
        "glue:BatchGetJobs",
        "kms:ListAliases"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:<AccountID>:table/db-*/*",
        "arn:aws:s3:::bucket-27/file-*.txt",
        "arn:aws:cloudformation:ap-south-1:<AccountID>:stack/aws-sam-cli-managed-default/*",
        "arn:aws:athena:us-east-1:<AccountID>:workgroup/wg-74",
        "arn:aws:iam::<AccountID>:user/bob",
        "arn:aws:kms:us-east-1:<AccountID>:key/*",
        "arn:aws:dynamodb:us-east-1:<AccountID>:table/db-*/*",
        "arn:aws:sqs:us-east-1:<AccountID>:queue/*",
        "arn:aws:athena:us-east-1:<AccountID>:workgroup/wg-17",
        "arn:aws:s3:::admin-bucket/document.txt",
        "arn:aws:glue:us-east-1:<AccountID>:catalog",
        "arn:aws:s3:::*/file.txt",
        "arn:aws:cloudformation:ap-south-1:<AccountID>:stack/aws-sam-cli-managed-default/*/file.txt",
        "arn:aws:athena:us-east-1:<AccountID>:workgroup/wg-74",
        "arn:aws:glue:us-east-1:<AccountID>:database/db-*",
        "arn:aws:s3:::*/*"
      ],
      "Principal": "<AccountID>",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        },
        "Bool": {
          "aws:SecureTransport": true
        }
      }
    }
  ]
}