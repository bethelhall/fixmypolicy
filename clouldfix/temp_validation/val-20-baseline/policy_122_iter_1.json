{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::name_of_bucket"
    },
    {
      "Sid": "AllowAthenaBatchGetQueryExecution",
      "Effect": "Allow",
