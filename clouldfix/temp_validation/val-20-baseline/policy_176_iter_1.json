        "arn:aws:sagemaker:*:xx:endpoint/file-7-0.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement6",
