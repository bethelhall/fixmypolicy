        "forbidden-arn:aws:sagemaker:*:xx:endpoint/*-specific"
      ],
      "Principal": [
        "arn:aws:iam::111222333444:role/developer-role"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement7",
      "Effect": "Allow",
      "Action": [
