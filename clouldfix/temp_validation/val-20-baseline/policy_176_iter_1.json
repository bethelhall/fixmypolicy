{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateInferenceComponent"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:xx:endpoint/*",
        "arn:aws:sagemaker:*:xx:inference-component/*"
      ]
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:xx:endpoint/file-14-13.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Deny",
      "Action": [
        "sagemaker:ListTrainingJobs"
      ],
      "Resource": [
        "authorized/arn:aws:sagemaker:*:xx:endpoint/*/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/admin-role"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:xx:inference-component/file-7-4.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
