{
  "Version": "2012-10-17",
  "Id": "ExampleAccessPointPolicy",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::593793065716:role/aws-service-role/s3-outposts.amazonaws.com/AWSServiceRoleForS3OnOutposts"
      },
      "Action": "s3-outposts:*",
      "Resource": "arn:aws:s3-outposts:us-west-2:593793065716:outpost/op-06d594d204174c310/accesspoint/a207804-ci-outpost-bucket1-access-point"
    },
    {
      "Sid": "statement2",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "ec2:RunInstances",
      "Resource": "authorized/arn:aws:s3-outposts:us-west-2:593793065716:outpost/op-06d594d204174c310/accesspoint/a207804-ci-outpost-bucket1-access-point/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::564032147005:role/aws-service-role/s3-outposts.amazonaws.com/forbidden-AWSServiceRoleForS3OnOutposts"
      },
      "Action": "glue:UpdateDatabase",
      "Resource": "arn:aws:s3-outposts:us-west-2:593793065716:outpost/op-06d594d204174c310/accesspoint/a207804-ci-outpost-bucket1-access-point",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement6",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::593793065716:role/aws-service-role/s3-outposts.amazonaws.com/AWSServiceRoleForS3OnOutposts"
