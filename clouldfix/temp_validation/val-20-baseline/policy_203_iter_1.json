{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "logs:CreateLogGroup",
        "logs:CreateLogStream"
      ],
      "Resource": "arn:aws:logs:*:*:*",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketPolicy",
        "s3-object-lambda:*"
      ],
      "Resource": "arn:aws:s3:::*/*",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:StartCrawler"
      ],
      "Resource": "arn:aws:s3:::*/file-5-7.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_ecd23c31"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:logs:*:*:resource-18-1",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_14f24257"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloud9:CreateEnvironmentEC2"
      ],
      "Resource": "arn:aws:s3:::*/file-11-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "allow_3eb80ec7"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:s3:::*/file-11-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_0438ca38"
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Sid": "deny_d67e6497"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:ListResourceTags"
      ],
      "Resource": "arn:aws:s3:::*/file-16-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_c95367fd"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::different-*/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Sid": "deny_d164915c"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy"
      ],
      "Resource": "arn:aws:logs:*:*:resource-24-18",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_1d6fc981"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::*/file-10-7.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "allow_cac3ef2c"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:logs:*:*:resource-16-4",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_223f92b9"
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:GetJobRun"
      ],
      "Resource": "arn:aws:logs:*:*:resource-47-2",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "allow_9ae6dffa"
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:logs:*:*:*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Sid": "deny_d6584f23"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": "*-forbidden/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Sid": "deny_7cebcbf3"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListObjectVersions"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "deny_7b27f4a8"
    },
    {
      "Effect": "Deny",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Sid": "deny_81614c9d"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:logs:*:*:resource-2-2",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_6cbf3e3a"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucketTagging"
      ],
      "Resource": "authorized/arn:aws:logs:*:*:*/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Sid": "deny_a4f14710"
    }
  ]
}