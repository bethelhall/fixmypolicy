{
  "Statement": [
    {
      "Action": "rds-db:connect",
      "Effect": "Allow",
      "Resource": "arn:aws:rds-db:*:<accountid>:dbuser:cluster-avcd/<user>",
      "Sid": "statement1"
    },
    {
      "Action": "cloudwatch:GetMetricData",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "codecommit:GetRepository",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "s3:GetObjectAcl",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sns:Publish",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Action": "athena:GetQueryExecution",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "kms:GenerateDataKey",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "sagemaker:DescribeModel",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "cloudwatch:PutDashboard",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "rds:CreateDBInstance",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Action": "iam:DeleteUser",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Action": "ec2:DescribeInstances",
      "Effect": "Deny",
      "Resource": "forbidden-arn:aws:rds-db:*:<accountid>:dbuser:cluster-avcd/<user>-specific",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "ec2:CreateTags",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "lambda:InvokeFunction",
      "Effect": "Deny",
      "Resource": "authorized/arn:aws:rds-db:*:<accountid>:dbuser:cluster-avcd/<user>/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Action": "ec2:DeleteKeyPair",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "ec2:DescribeInstances",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "dynamodb:PutItem",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Deny",
      "Resource": "arn:aws:rds-db:*:<accountid>:dbuser:cluster-avcd/<user>-forbidden-resource",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "iam:ListPolicies",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "s3:PutObject",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}