{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots"
      ],
      "Sid": "statement1"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/*"
      ],
      "Sid": "statement2"
    },
    {
      "Action": [
        "s3:PutBucketWebsite"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-2-17.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "sns:DeleteTopic"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::dining-images/file-18-0.txt",
        "arn:aws:s3:::dining-images/file-18-2.txt",
        "arn:aws:s3:::dining-images/file-18-3.txt",
        "arn:aws:s3:::dining-images/file-18-4.txt",
        "arn:aws:s3:::dining-images/file-18-5.txt",
        "arn:aws:s3:::dining-images/file-18-6.txt",
        "arn:aws:s3:::dining-images/file-18-7.txt",
        "arn:aws:s3:::dining-images/file-18-8.txt",
        "arn:aws:s3:::dining-images/file-18-9.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}