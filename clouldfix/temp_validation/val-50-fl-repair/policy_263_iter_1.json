{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::test-transferfamily-demo",
        "arn:aws:s3:::sftp-demo2"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${transfer:UserName}/*",
            "test-transferfamily-demo/${transfer:UserName}/*",
            "sftp-demo2/${transfer:UserName}/*"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::test-transferfamily-demo/${transfer:UserName}/*",
        "arn:aws:s3:::sftp-demo2/${transfer:UserName}/*"
      ],
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "kms:Encrypt",
      "Resource": "arn:aws:s3:::test-transferfamily-demo/${transfer:UserName}/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "glue:DeleteDatabase",
      "Resource": "arn:aws:s3:::sftp-demo2/${transfer:UserName}/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "codepipeline:GetPipeline",
      "Resource": "arn:aws:s3:::sftp-demo2/${transfer:UserName}/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:s3:::test-transferfamily-demo/${transfer:UserName}/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateLoginProfile",
      "Resource": "arn:aws:s3:::test-transferfamily-demo/${transfer:UserName}/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLifecycle",
      "Resource": "arn:aws:s3:::sftp-demo2/${transfer:UserName}/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
