{
  "Statement": [
    {
      "Sid": "DescribeCryptoTrail",
      "Action": "logs:GetLogEvents",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:logs:eu-west-1:ACCOUNT-ID:log-group:aws-controltower/CloudTrailLogs:log-stream:ORG-ID_CRYPTO-ACCOUNT-ID_CloudTrail_eu-west-*"
      ]
    },
    {
      "Sid": "AllowS3PutBucketWebsite",
      "Action": "s3:PutBucketWebsite",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowSNSDeleteTopic",
      "Action": "sns:DeleteTopic",
      "Effect": "Allow",
      "Resource": "*",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}