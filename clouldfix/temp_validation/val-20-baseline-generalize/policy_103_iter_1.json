{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "sample",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Action": "s3:*",
      "Resource": [
        "s3 arn",
        "s3 arn/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_4e5a20b8",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Action": "kms:ReEncrypt",
      "Resource": "s3 arn/file-14-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_764ceab4",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Action": "cloudwatch:PutDashboard",
      "Resource": "s3 arn/file-17-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_6e0e3d72",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Action": "kms:CreateKey",
      "Resource": "s3 arn/file-32-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_bb32d9c3",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Action": "cloudtrail:CreateTrail",
      "Resource": "s3 arn/file-41-13.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_11e6e807",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Action": "sagemaker:CreateNotebookInstance",
      "Resource": "s3 arn/file-38-15.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_8673077b",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Action": "s3:ListAllMyBuckets",
      "Resource": "s3 arn/file-38-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_0ed077a9",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "IAM user login to console"
        ]
      },
      "Action": "ec2:DescribeInstances",
      "Resource": "s3 arn-forbidden-resource",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "deny_1bc637c4",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "IAM user login to console"
        ]
      },
      "Action": "iam:CreateUser",
      "Resource": "authorized/s3 arn/*/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "deny_2c03e288",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "IAM user login to console"
        ]
      },
      "Action": "lambda:CreateFunction",
      "Resource": "s3 arn/*-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_41585019",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "IAM user login to console"
        ]
      },
      "Action": "iam:DeleteUser",
      "Resource": "authorized/s3 arn/file.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
}