{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendBulkEmail"
      ],
      "Resource": [
        "arn:aws:ses:eu-west-3:111222333444:identity/MyUser",
        "arn:aws:ses:eu-west-3:111222333444:template/*",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/*"
      ]
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-0.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-1.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-2.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-3.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-4.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-5.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-6.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-7.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-8.txt",
        "arn:aws:ses:eu-west-3:111222333444configuration-set/file-46-9.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:ses:eu-west-3:111222333444configuration-set/file-42-10.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketCors"
      ],
      "Resource": "arn:aws:ses:eu-west-3:111222333444configuration-set/file-45-2.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Allow",
      "Action": [
        "kinesis:DescribeStream"
      ],
      "Resource": "arn:aws:ses:eu-west-3:111222333444:template/file-28-8.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Action": [
        "config:DeleteConfigRule"
      ],
      "Resource": "arn:aws:ses:eu-west-3:111222333444:template/file-20-6.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Allow",
      "Action": [
        "kms:ReEncrypt"
      ],
      "Resource": "arn:aws:ses:eu-west-3:111222333444:template/file-5-2.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Deny",
      "Action": [
        "ses:GetIdentityDkimAttributes"
      ],
      "Resource": "forbidden-arn:aws:ses:eu-west-3:111222333444:template/*-specific",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "VisualEditor9",
      "Effect": "Deny",
      "Action": [
        "ses:DeleteIdentity"
      ],
      "Resource": "authorized/arn:aws:ses:eu-west-3:111222333444:identity/MyUser/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor10",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "forbidden-arn:aws:ses:eu-west-3:111222333444:identity/MyUser-specific",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor11",
      "Effect": "Deny",
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "authorized/arn:aws:ses:eu-west-3:111222333444:identity/MyUser/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}