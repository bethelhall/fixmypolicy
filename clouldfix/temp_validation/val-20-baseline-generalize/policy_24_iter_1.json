{
  "Statement": [
    {
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-2:<account_id>key/<key_id>",
      "Sid": "kms"
    },
    {
      "Action": "secretsmanager:GetSecretValue",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>",
      "Sid": "secretsmanager"
    },
    {
      "Action": "guardduty:CreateIPSet",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-2:<account_id>key/<key_id>",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_89845e40"
    },
    {
      "Action": "sqs:CreateQueue",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_636b32a0"
    },
    {
      "Action": "logs:CreateLogStream",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "allow_531150c3"
    },
    {
      "Action": "glue:UpdateTable",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_6adf3e51"
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-2:<account_id>key/<key_id>",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_5d537ae6"
    },
    {
      "Action": "rds:DeleteDBInstance",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-2:<account_id>key/<key_id>",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_db0c7767"
    },
    {
      "Action": "rds:DeleteDBInstance",
      "Effect": "Deny",
      "Resource": "arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>-forbidden-resource",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "deny_3eaf7cf6"
    },
    {
      "Action": "kms:GetKeyPolicy",
      "Effect": "Deny",
      "Resource": "forbidden-arn:aws:secretsmanager:us-east-2:<account_id>:secret:<secret_name>-<some_randomstuff>-specific",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "deny_8cb38696"
    },
    {
      "Action": "kms:CancelKeyDeletion",
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-2:<account_id>key/<key_id>-forbidden-resource",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Sid": "deny_e524dd45"
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Deny",
      "Resource": "forbidden-arn:aws:kms:us-east-2:<account_id>key/<key_id>-specific",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Sid": "deny_44b02a59"
    }
  ],
  "Version": "2012-10-17"
}