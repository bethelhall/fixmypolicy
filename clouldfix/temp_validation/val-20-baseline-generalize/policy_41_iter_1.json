{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-23/file-0.txt",
        "arn:aws:s3:::bucket-23/file-1.txt",
        "arn:aws:s3:::bucket-23/file-2.txt",
        "arn:aws:s3:::bucket-23/file-3.txt",
        "arn:aws:s3:::bucket-23/file-4.txt",
        "arn:aws:s3:::bucket-23/file-5.txt",
        "arn:aws:s3:::bucket-23/file-6.txt",
        "arn:aws:s3:::bucket-23/file-7.txt",
        "arn:aws:s3:::bucket-23/file-8.txt",
        "arn:aws:s3:::bucket-23/file-9.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:UpdateTable"
      ],
      "Resource": "arn:aws:s3:::bucket-44/file-3.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "config:PutConfigRule"
      ],
      "Resource": "arn:aws:s3:::bucket-35/file-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement3"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-0",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "statement4"
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-2/table-4",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "statement5"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutDashboard"
      ],
      "Resource": "arn:aws:s3:::bucket-3/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "statement6"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement7"
    },
    {
      "Effect": "Deny",
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement8"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObjectTagging"
      ],
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Sid": "statement9"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement10"
    }
  ]
}