{
  "Statement": [
    {
      "Sid": "BedrockCloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListDashboards",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      }
    },
    {
      "Sid": "allow_e49880cb",
      "Effect": "Allow",
      "Action": "athena:BatchGetQueryExecution",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-10/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "allow_af4827f5",
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:s3:::bucket-10/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "allow_e71bd8d1",
      "Effect": "Allow",
