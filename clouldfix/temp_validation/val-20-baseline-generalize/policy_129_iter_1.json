{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:athena:*:123456789012:workgroup/*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketTagging",
      "Resource": "arn:aws:glue:*:123456789012:table/*/*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudtrail:CreateTrail",
      "Resource": "arn:aws:s3:::*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:UpdateStack",
      "Resource": "arn:aws:s3:::*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutBucketVersioning",
      "Resource": "arn:aws:s3:::*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "arn:aws:glue:*:123456789012:table/*/*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:kms:*:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": true
        }
      }
    }
  ]
}