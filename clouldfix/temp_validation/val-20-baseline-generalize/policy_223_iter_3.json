{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "athena:DeleteWorkGroup"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:DeleteAutoScalingGroup"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "forbidden-arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}-specific",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "authorized/arn:aws:dynamodb:*:<accountId>:table/${credentials-iot:ThingName}/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}