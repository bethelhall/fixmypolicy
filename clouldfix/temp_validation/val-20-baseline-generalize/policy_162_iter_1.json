{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::pics-repository/*",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "sagemaker:DescribeNotebookInstance",
      "Resource": "arn:aws:s3:::pics-repository/file-16-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "autoscaling:CreateAutoScalingGroup",
      "Resource": "arn:aws:s3:::pics-repository/file-40-1.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:s3:::pics-repository/file-33-17.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "kinesis:DeleteStream",
      "Resource": "arn:aws:s3:::pics-repository/file-21-17.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pics-repository/file-4-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "athena:DeleteWorkGroup",
      "Resource": "arn:aws:s3:::pics-repository/file-7-13.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::pics-repository-forbidden/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::different-pics-repository/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}