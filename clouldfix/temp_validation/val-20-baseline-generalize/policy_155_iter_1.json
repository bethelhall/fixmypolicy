{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "config:DeleteRetentionConfiguration",
        "config:PutConfigurationRecorder",
        "config:PutDeliveryChannel",
        "config:PutRetentionConfiguration",
        "config:StopConfigurationRecorder"
      ],
      "Resource": "*",
      "Effect": "Deny",
      "Sid": "GRCOXXXXXX"
    },
    {
      "Action": [
        "cloudfront:CreateDistribution"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-15/file-4.txt",
        "arn:aws:s3:::bucket-15/file-0.txt",
        "arn:aws:s3:::bucket-15/file-1.txt",
        "arn:aws:s3:::bucket-15/file-2.txt",
        "arn:aws:s3:::bucket-15/file-3.txt",
        "arn:aws:s3:::bucket-15/file-5.txt",
        "arn:aws:s3:::bucket-15/file-6.txt",
        "arn:aws:s3:::bucket-15/file-7.txt",
        "arn:aws:s3:::bucket-15/file-8.txt",
        "arn:aws:s3:::bucket-15/file-9.txt"
      ],
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "glue:DeleteTable"
      ],
      "Resource": "arn:aws:s3:::bucket-47/file-1.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "codebuild:ListBuilds"
      ],
      "Resource": "arn:aws:s3:::bucket-3/file-3.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "arn:aws:s3:::bucket-11/file-0.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "kms:DisableKey"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-20",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::bucket-35/file-7.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Action": [
        "config:DeleteConfigRule"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
