      ],
      "Effect": "Allow",
      "Sid": "allow_97e304f3",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "s3:DeleteBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::securitylake-glue-assets-*/file-46-5.txt"
      ],
      "Effect": "Allow",
      "Sid": "allow_c8019706",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
