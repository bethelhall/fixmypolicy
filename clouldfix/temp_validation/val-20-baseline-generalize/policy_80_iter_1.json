      "Resource": [
        "arn:aws:s3:::aws-security-data-lake-*/*",
        "arn:aws:s3:::securitylake-glue-assets-*/*"
      ],
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "sqs:ChangeMessageVisibilityBatch"
      ],
      "Resource": [
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-0.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-1.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-2.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-3.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-4.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-5.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-6.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-7.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-8.txt",
        "arn:aws:s3:::securitylake-glue-assets-*/file-18-9.txt"
      ],
      "Effect": "Allow",
      "Sid": "allow_dd2b3eae",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
