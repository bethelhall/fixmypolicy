      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:s3:::aws-security-data-lake-*/file-25-6.txt"
      ],
      "Effect": "Allow",
      "Sid": "allow_6b6398bf",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::aws-security-data-lake-*/file-31-4.txt"
      ],
      "Effect": "Allow",
      "Sid": "allow_c62ae612",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "s3:DeleteBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::different-aws-security-data-lake-*/file.txt"
      ],
      "Effect": "Deny",
      "Sid": "deny_60aa8462",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:s3:::completely-different-bucket/file.txt"
      ],
      "Effect": "Deny",
      "Sid": "deny_ecf36d90",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::different-securitylake-glue-assets-*/file.txt"
      ],
      "Effect": "Deny",
      "Sid": "deny_d1b62f23",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": [
        "arn:aws:s3:::securitylake-glue-assets-*-forbidden/file.txt"
      ],
      "Effect": "Deny",
      "Sid": "deny_4f2fae9f",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}