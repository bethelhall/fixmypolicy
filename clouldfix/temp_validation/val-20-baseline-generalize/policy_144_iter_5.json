{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:AcceptDataGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "ACCOUNTID"
        }
      },
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ses:ListIdentities"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-0",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-1",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-2",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-3",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-4",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-5",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-6",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-7",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-8",
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-9"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-22",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:DeleteApplication"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-14/table-17",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachUserPolicy"
      ],
      "Resource": "arn:aws:s3:::bucket-2/file-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "not-ACCOUNTID"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "es:DescribeElasticsearchDomains"
      ],
      "Resource": "arn:aws:s3:::bucket-5/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-12/table-0",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "ORGID"
        },
        "StringNotEquals": {
          "aws:PrincipalAccount": "ACCOUNTID"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "ORGID"
        },
        "StringNotEquals": {
          "aws:PrincipalAccount": "ACCOUNTID"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/test-role"
    },
    {
      "Effect": "Deny",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "ORGID"
        },
        "StringNotEquals": {
          "aws:PrincipalAccount": "ACCOUNTID"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketTagging"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "ACCOUNTID"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}