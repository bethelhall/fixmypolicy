{
  "Statement": [
    {
      "Action": "rds-db:connect",
      "Effect": "Allow",
      "Resource": "arn:aws:rds-db:us-east-1:1234567890:dbuser:cluster-ABCVDEFGHIJKLMNOPQRSTUVWXYZ/${aws:username}",
      "Sid": "statement1"
    },
    {
      "Action": "sqs:ReceiveMessage",
      "Effect": "Allow",
