{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:*",
      "Resource": "*",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteDetector",
        "s3:PutBucketLifecycle",
        "elasticloadbalancing:DescribeLoadBalancers",
        "kms:GetKeyPolicy",
        "es:DescribeElasticsearchDomains"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-21",
        "arn:aws:s3:::bucket-40/file-3.txt",
        "arn:aws:s3:::bucket-7/file-8.txt",
        "arn:aws:s3:::bucket-31/file-7.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-44"
      ],
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob",
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}