{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowElasticBeanstalkCreateApplication",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:CreateApplication",
      "Resource": "arn:aws:s3:::bucket-9/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowRoute53ListHostedZones",
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-5",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowSqsListQueues",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "arn:aws:s3:::bucket-23/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowGlueCreateDatabase",
      "Effect": "Allow",
      "Action": "glue:CreateDatabase",
      "Resource": "arn:aws:s3:::bucket-14/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowGuardDutyListDetectors",
      "Effect": "Allow",
      "Action": "guardduty:ListDetectors",
      "Resource": "arn:aws:s3:::bucket-9/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowS3DeleteObjectTagging",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectTagging",
      "Resource": "arn:aws:s3:::bucket-25/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenySnsSubscribe",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/temp-user"
    },
    {
      "Sid": "DenyEc2CreateSecurityGroup",
      "Effect": "Deny",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Sid": "DenyDynamoDbPutItem",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyEc2DeleteSecurityGroup",
      "Effect": "Deny",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    }
  ]
}