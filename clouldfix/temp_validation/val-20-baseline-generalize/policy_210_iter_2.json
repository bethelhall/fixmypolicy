{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::import-to-ec2-*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifySnapshotAttribute",
        "ec2:CopySnapshot",
        "ec2:RegisterImage",
        "ec2:Describe*"
      ],
      "Resource": "*",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:UpdateStack"
      ],
      "Resource": [
        "arn:aws:s3:::import-to-ec2-resource-12-0",
        "arn:aws:s3:::import-to-ec2-resource-12-1",
        "arn:aws:s3:::import-to-ec2-resource-12-2",
        "arn:aws:s3:::import-to-ec2-resource-12-3",
        "arn:aws:s3:::import-to-ec2-resource-12-4",
        "arn:aws:s3:::import-to-ec2-resource-12-5",
        "arn:aws:s3:::import-to-ec2-resource-12-6",
        "arn:aws:s3:::import-to-ec2-resource-12-7",
        "arn:aws:s3:::import-to-ec2-resource-12-8",
        "arn:aws:s3:::import-to-ec2-resource-12-9"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucketLifecycle"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-10/table-13"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "kms:ListKeys"
      ],
      "Resource": [
        "arn:aws:s3:::import-to-ec2-resource-8-19"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucketLifecycle"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678"
      ],
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-0/file-0.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role"
      ],
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucketWebsite"
      ],
      "Resource": [
        "arn:aws:s3:::admin-bucket/document.txt"
      ],
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
}