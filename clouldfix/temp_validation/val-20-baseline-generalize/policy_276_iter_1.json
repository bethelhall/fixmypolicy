{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::[my-account-id]:root"
      },
      "Action": [
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::[bucket-name]/*",
        "arn:aws:s3:::[bucket-name]"
      ]
    },
    {
      "Sid": "allow_de237599",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "sagemaker:DescribeModel",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_9aee78f5",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_65431b04",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "sqs:SetQueueAttributes",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_9bb7057a",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::799954292545:root"
      },
      "Action": "kms:PutKeyPolicy",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_2438c9ba",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::389692747922:root"
      },
      "Action": "athena:StartQueryExecution",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_40b0e918",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::612261328467:root"
      },
      "Action": "elasticloadbalancing:DescribeLoadBalancers",
      "Resource": "arn:aws:s3:::[bucket-name]/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_580f9afc",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[my-account-id]:root"
      },
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_12f594e2",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[my-account-id]:root"
      },
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_4cd6cb50",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[my-account-id]:root"
      },
      "Action": "s3:PutBucketLifecycle",
      "Resource": "arn:aws:s3:::different-[bucket-name]/file.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "deny_4428b8e5",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[my-account-id]:root"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::[bucket-name]-forbidden/file.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}