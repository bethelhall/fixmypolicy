{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:StartSession",
        "ssm:ResumeSession"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:session/S(aws:userid)-*",
        "arn:aws:ssm:*:*:session/$(aws:username)-*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-0",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-1",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-2",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-3",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-4",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-5",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-6",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-7",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-8",
        "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-9"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObjectTagging",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-47-1",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "athena:StartQueryExecution",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-33-17",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-45-6",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:ReEncrypt",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-5-10",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:CreateDistribution",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-15-16",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:ssm:*:*:session/S(aws:userid)--forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "authorized/arn:aws:ssm:*:*:session/$(aws:username)-*/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "forbidden-arn:aws:ssm:*:*:session/S(aws:userid)--specific",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
}