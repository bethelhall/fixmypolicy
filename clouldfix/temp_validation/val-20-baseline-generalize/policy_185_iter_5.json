{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::account-id:role/your-irsa-role",
          "arn:aws:iam::account-id:user/your-user"
        ]
      },
      "Action": "execute-api:Invoke",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/*",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "athena:CreateWorkGroup",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-29-18.txt",
      "Principal": "arn:aws:iam::account-id:user/forbidden-your-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:ListDistributions",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-42-8.txt",
      "Principal": "arn:aws:iam::641930057962:user/your-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudsearch:CreateDomain",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-31-11.txt",
      "Principal": "arn:aws:iam::account-id:role/forbidden-your-irsa-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AttachVolume",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-47-2.txt",
      "Principal": "arn:aws:iam::account-id:role/forbidden-your-irsa-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "codedeploy:GetDeployment",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-1-5.txt",
      "Principal": "arn:aws:iam::180655097741:user/your-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/file-11-5.txt",
      "Principal": "arn:aws:iam::account-id:role/forbidden-your-irsa-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::account-id:role/your-irsa-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "authorized/arn:aws:execute-api:region:account-id:appsync-api-id/*/file.txt",
      "Principal": "arn:aws:iam::account-id:role/your-irsa-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:execute-api:region:account-id:appsync-api-id/*-forbidden-resource",
      "Principal": "arn:aws:iam::account-id:user/your-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "forbidden-arn:aws:execute-api:region:account-id:appsync-api-id/*-specific",
      "Principal": "arn:aws:iam::account-id:user/your-user",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}