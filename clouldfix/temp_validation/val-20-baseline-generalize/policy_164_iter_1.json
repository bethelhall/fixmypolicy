{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFullAccessToBucket",
      "Action": "s3:*",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::goldcoast-tvod",
        "arn:aws:s3:::goldcoast-tvod/*"
      ]
    },
    {
      "Sid": "AllowPutBucketWebsite",
      "Action": "s3:PutBucketWebsite",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowDeleteDistribution",
      "Action": "cloudfront:DeleteDistribution",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGetDashboard",
      "Action": "cloudwatch:GetDashboard",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowDescribeVolumes",
      "Action": "ec2:DescribeVolumes",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowPublish",
      "Action": "sns:Publish",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowModifyWorkspaceProperties",
      "Action": "workspaces:ModifyWorkspaceProperties",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyInvokeFunction",
      "Action": "lambda:InvokeFunction",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyRunInstances",
      "Action": "ec2:RunInstances",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyPublish",
      "Action": "sns:Publish",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::different-goldcoast-tvod/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyCreateFunction",
      "Action": "lambda:CreateFunction",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::goldcoast-tvod-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}