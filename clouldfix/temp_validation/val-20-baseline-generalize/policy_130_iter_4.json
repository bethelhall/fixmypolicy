{
  "Version": "2008-10-17",
  "Id": "PolicyForCloudFrontPrivateContent",
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalToPutBucketLifecycle",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:PutBucketLifecycle",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalToPutBucketCors",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:PutBucketCors",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalToReceiveMessage",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalToListDeadLetterSourceQueues",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "sqs:ListDeadLetterSourceQueues",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalToCreateGroup",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "iam:CreateGroup",
      "Resource": "arn:aws:s3:::mywebsite.com/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::123456789012:distribution/ABCDEF12345"
        }
      }
    },
    {
      "Sid": "DenyAllOthers",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "*",
      "Resource": "*"
    }
  ]
}