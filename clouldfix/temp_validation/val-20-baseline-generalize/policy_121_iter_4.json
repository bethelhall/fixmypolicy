{
  "Statement": [
    {
      "Sid": "AllowAccessFromAPIGateway",
      "Effect": "Allow",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::my-bucket/*"
    },
    {
      "Sid": "AllowAccessForAliceInUsWest2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:s3:::my-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowAccessForBobInUsEast1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::my-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAccessForServiceRoleInUsWest2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": [
        "cloudtrail:GetTrailStatus",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::my-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyAccessToCompletelyDifferentBucket",
      "Effect": "Deny",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": [
        "s3:DeleteObjectTagging",
        "s3:GetBucketLocation",
        "s3:PutBucketLogging"
      ],
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "DenyAccessToDeniedBucket0",
      "Effect": "Deny",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyAccessToMyBucketForbidden",
      "Effect": "Deny",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::my-bucket-forbidden/file.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}