{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:secretsmanager:sa-east-1:111111111:secret:mysecret*",
        "arn:aws:secretsmanager:sa-east-1:0:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:1:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:2:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:3:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:4:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:5:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:6:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:7:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:8:secret:mysecret",
        "arn:aws:secretsmanager:sa-east-1:9:secret:mysecret"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:ListAttachedGroupPolicies"
      ],
      "Resource": [
        "arn:aws:kms:sa-east-1:111111111:key/random-uuid"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "guardduty:GetIPSet"
      ],
      "Resource": [
        "arn:aws:secretsmanager:sa-east-1:111111111:secret:mysecret*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:kms:sa-east-1:111111111:key/random-uuid"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:secretsmanager:sa-east-1:111111111:secret:mysecret*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:kms:sa-east-1:111111111:key/random-uuid"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": [
        "forbidden-arn:aws:secretsmanager:sa-east-1:111111111:secret:mysecret-specific"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "authorized/arn:aws:kms:sa-east-1:111111111:key/random-uuid/file.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "forbidden-arn:aws:kms:sa-east-1:111111111:key/random-uuid-specific"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "authorized/arn:aws:secretsmanager:sa-east-1:111111111:secret:mysecret/file.txt"
      ],
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}