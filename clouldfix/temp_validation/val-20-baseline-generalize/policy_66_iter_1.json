{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOtherRegions",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "AllowSqsSendMessageBatch",
      "Effect": "Allow",
      "Action": "sqs:SendMessageBatch",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-0",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-1",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-2",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-3",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-4",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-5",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-6",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-7",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-8",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-9"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowIamCreateAccessKey",
      "Effect": "Allow",
      "Action": "iam:CreateAccessKey",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-1/table-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowS3DeleteBucketWebsite",
      "Effect": "Allow",
      "Action": "s3:DeleteBucketWebsite",
      "Resource": "arn:aws:s3:::bucket-31/file-6.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowDynamoDbDeleteItem",
      "Effect": "Allow",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::bucket-40/file-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowIamDeleteUser",
      "Effect": "Allow",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-61",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowDynamoDbQuery",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-14/table-7",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyEc2RunInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyIamDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Sid": "DenyLambdaInvokeFunction",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "DenyRdsDeleteDBInstance",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    }
  ]
}