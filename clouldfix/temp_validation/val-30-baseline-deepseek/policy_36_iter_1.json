{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "aoss:*"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketPolicy"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:UpdateStack"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudtrail:StartLogging"
      ],
      "Resource": "arn:aws:aoss:us-east-2:{accountNumber}:collection/{collectionId}",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      }
    }
  ]
}