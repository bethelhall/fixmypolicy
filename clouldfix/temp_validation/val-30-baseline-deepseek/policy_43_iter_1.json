{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "imagebuilder:GetComponent",
        "imagebuilder:ListComponents",
        "imagebuilder:GetComponentPolicy"
      ],
      "Resource": "arn:aws:imagebuilder:us-east-1::component///1",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": "arn:aws:s3:::-useast",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeleteLoginProfile",
        "iam:UpdateAccessKey",
        "cloudwatch:ListMetrics",
        "sqs:ReceiveMessage",
        "guardduty:CreateDetector",
        "rds:DeleteDBInstance",
        "sns:Publish",
        "workspaces:DeleteWorkspaces",
        "kms:Decrypt",
        "sagemaker:CreateEndpointConfig",
        "ec2:ModifyInstanceAttribute",
        "rds:CreateDBInstance",
        "logs:DescribeLogStreams",
        "dynamodb:DeleteItem",
        "s3:PutBucketVersioning",
        "athena:CreateWorkGroup",
        "athena:GetWorkGroup",
        "config:PutConfigRule",
        "sqs:SendMessage",
        "glue:StartCrawler",
        "iam:PutRolePolicy",
        "glue:GetDatabase",
        "lambda:InvokeFunction",
        "sns:Subscribe",
        "iam:DeleteUser",
        "dynamodb:PutItem"
      ],
      "Resource": "*",
      "Sid": "DefaultDeny"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "arn:aws:imagebuilder:us-east-1::component///1",
      "Principal": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Sid": "SpecificAllow"
    }
  ]
}