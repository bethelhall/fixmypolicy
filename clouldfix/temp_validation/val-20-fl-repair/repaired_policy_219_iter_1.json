{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "guardduty:*",
        "config:*"
      ],
      "Resource": "*",
      "Effect": "Deny",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Action": "kms:CancelKeyDeletion",
      "Resource": "arn:aws:s3:::bucket-name/file-18-17.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:s3:::bucket-name/file-23-14.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::1234567890:distribution/asdf"
        }
      }
    },
    {
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:s3:::bucket-name/file-11-12.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::1234567890:distribution/asdf"
        }
      }
    },
    {
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:s3:::bucket-name/file-34-3.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "cloudwatch:ListMetrics",
      "Resource": "arn:aws:s3:::bucket-name/file-17-5.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "codecommit:GetRepository",
      "Resource": "arn:aws:s3:::bucket-name/file-47-17.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}