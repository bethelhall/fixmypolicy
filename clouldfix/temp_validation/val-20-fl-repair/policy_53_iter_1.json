{
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-bucket*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "allow_ba3ad06d_combo_2",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectTagging",
      "Resource": "arn:aws:s3:::my-bucketresource-3-16",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_76fd2034_combo_2",
      "Effect": "Allow",
      "Action": "glue:CreateDatabase",
      "Resource": "arn:aws:s3:::my-bucketresource-3-8",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "allow_fef26ed4_combo_2",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:s3:::my-bucketresource-18-12",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "allow_7058d489_combo_2",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:s3:::my-bucketresource-0-1",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_cb7d06aa_combo_2",
      "Effect": "Allow",
      "Action": "s3:GetObjectAcl",
      "Resource": "arn:aws:s3:::my-bucketresource-25-19",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_9f209bcc_combo_2",
      "Effect": "Allow",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:s3:::my-bucketresource-4-4",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}