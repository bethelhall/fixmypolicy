{
  "Version": "2012-10-17",
  "Id": "auto-sns-1",
  "Statement": [
    {
      "Sid": "Allow access through SNS for all principals in the account that are authorized to use SNS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "xxxxxxxxxxxx",
          "kms:ViaService": "sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow direct access to key metadata to the account",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::xxxxxxxxxxxx:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:RevokeGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "route53:ListHostedZones"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": [
        "s3:PutBucketLifecycle"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::222483872342:root"
      },
      "Action": [
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": [
        "glue:UpdateDatabase"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": [
        "s3:ListObjectVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::926227334075:root"
      },
      "Action": [
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": [
        "athena:GetQueryExecution"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": [
        "athena:GetQueryResults"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": [
        "athena:GetQueryResults"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": [
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "not-sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::461448013940:root"
      },
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "xxxxxxxxxxxx",
          "kms:ViaService": "sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::696662780613:root"
      },
      "Action": [
        "sqs:TagQueue"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to specific resources based on conditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": [
        "s3:GetBucketWebsite"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}