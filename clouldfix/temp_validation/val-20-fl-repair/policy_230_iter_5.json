{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::thanos-syn-canary/*",
        "arn:aws:s3:::thanos-syn-canary"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::thanos-syn-canary"
      ],
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanos*"
      ],
      "Sid": "statement3"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "xray:PutTraceSegments"
      ],
      "Resource": [
        "*"
      ],
      "Sid": "statement4"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanos*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "CloudWatchSynthetics"
        }
      },
      "Sid": "statement5"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface"
      ],
      "Resource": [
        "*"
      ],
      "Sid": "statement6"
    },
    {
      "Effect": "Allow",
      "Action": "config:DescribeConfigRules",
      "Resource": "arn:aws:s3:::bucket-18/file-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "guardduty:GetDetector",
      "Resource": "arn:aws:s3:::thanos-syn-canary/file-13-19.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:UntagQueue",
      "Resource": "arn:aws:s3:::thanos-syn-canary/file-44-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:s3:::thanos-syn-canary/file-36-9.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "kms:UpdateKeyDescription",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-2-14",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "not-CloudWatchSynthetics"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-6-18",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "iam:GetGroup",
      "Resource": "arn:aws:s3:::thanos-syn-canary/file-42-11.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ChangeMessageVisibilityBatch",
      "Resource": "arn:aws:s3:::thanos-syn-canary/file-21-14.txt",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "not-CloudWatchSynthetics"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "cloudwatch:DeleteDashboards",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-25-0",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketTagging",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-28-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:DeleteDistribution",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-22-15",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "iam:RemoveUserFromGroup",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanosresource-28-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "authorized/arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanos*-specific",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:logs:eu-central-1:******:log-group:/aws/lambda/cwsyn-grafana-thanos*-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/developer-role"
    }
  ]
}