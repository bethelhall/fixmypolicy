{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:Connect",
        "kafka-cluster:AlterCluster",
        "kafka-cluster:DescribeCluster",
        "kafka-cluster:WriteDataIdempotently"
      ],
      "Resource": [
        "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:*Topic*",
        "kafka-cluster:WriteData",
        "kafka-cluster:ReadData"
      ],
      "Resource": [
        "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/*"
      ],
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:AlterGroup",
        "kafka-cluster:DescribeGroup"
      ],
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:group/demo-cluster-1/*",
      "Sid": "statement3"
    },
    {
      "Effect": "Allow",
      "Action": "iam:ListGroupsForUser",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/file-0-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sns:CreateTopic",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/file-31-14.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/file-20-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "authorized/arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/*/file.txt",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "authorized/arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/*/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "athena:GetQueryExecution",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/file-37-12.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/file-33-4.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "glue:StartCrawler",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:group/demo-cluster-1/file-13-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "forbidden-arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/*-specific",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "forbidden-arn:aws:kafka:us-west-2:12ditAWSID:group/demo-cluster-1/*-specific",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/file-27-12.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "codecommit:CreateRepository",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:group/demo-cluster-1/file-20-10.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:ListModels",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:group/demo-cluster-1/file-41-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "forbidden-arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/*-specific",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "autoscaling:CreateAutoScalingGroup",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/file-24-16.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "athena:GetQueryResults",
      "Resource": "arn:aws:kafka:us-west-2:12ditAWSID:topic/demo-cluster-1/file-39-5.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}