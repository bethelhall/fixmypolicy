{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::$BucketName"
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::$BucketName/*"
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "kms:CancelKeyDeletion",
      "Resource": "arn:aws:s3:::$BucketName/file-18-17.txt"
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:s3:::$BucketName/file-23-14.txt",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::1234567890:distribution/asdf"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:s3:::$BucketName/file-11-12.txt",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::1234567890:distribution/asdf"
        }
      }
    },
    {
      "Sid": "statement6",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:s3:::$BucketName/file-34-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement7",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "cloudwatch:ListMetrics",
      "Resource": "arn:aws:s3:::$BucketName/file-17-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement8",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": "codecommit:GetRepository",
      "Resource": "arn:aws:s3:::$BucketName/file-47-17.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}