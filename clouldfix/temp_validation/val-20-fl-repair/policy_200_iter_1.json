{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::tmbile",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:DeleteObject",
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::tmbile/public/*",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ListQueueTags",
      "Resource": "arn:aws:s3:::tmbile/public/file-30-15.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
