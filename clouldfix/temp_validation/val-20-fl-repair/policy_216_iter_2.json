{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucket",
        "s3:PutBucketNotification",
        "s3:PutBucketAcl",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::datalake-submissions/*",
        "arn:aws:s3:::datalake-curated-datasets/*",
        "arn:aws:s3:::datalake-published-data/*",
        "arn:aws:s3:::regional-lambda-bucket/*",
        "arn:aws:s3:::datalake-athena-query-results/*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kinesis:*",
        "kinesisanalytics:*",
        "lambda:*",
        "glue:*",
        "kinesis:CreateStream",
        "kinesis:DescribeStream",
        "kinesis:PutRecord",
        "kinesis:PutRecords",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:DeleteFunction",
        "lambda:ListFunctions",
        "athena:*",
        "redshift:*",
        "quicksight:*",
        "sns:*",
        "sagemaker:*",
        "ec2:Describe*",
        "firehose:DescribeDeliveryStream",
        "firehose:ListDeliveryStreams",
        "firehose:PutRecord",
        "firehose:PutRecordBatch",
        "ec2:CreateLaunchTemplate",
        "ec2:DescribeLaunchTemplates",
        "ec2:RunInstances",
        "ec2:DescribeInstances",
        "ec2:CreateTags",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ssm:GetParameters",
        "ssm:GetParameter",
        "ssm:DescribeParameters",
        "ec2:DeleteTags",
        "iam:CreateRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:PassRole",
        "iam:DeleteRole",
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "elasticloadbalancing:*",
        "logs:*",
        "cloudformation:*",
        "cloudwatch:*",
        "es:*"
      ],
      "Resource": "*",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-13",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:StopNotebookInstance",
      "Resource": "arn:aws:s3:::datalake-curated-datasets/file-1-13.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::datalake-athena-query-results-forbidden/file.txt",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:RetireGrant",
      "Resource": "arn:aws:s3:::datalake-curated-datasets/file-48-9.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLifecycle",
      "Resource": "arn:aws:s3:::datalake-published-data/file-45-16.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:s3:::datalake-curated-datasets-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:ListAttachedGroupPolicies",
      "Resource": "arn:aws:s3:::different-datalake-curated-datasets/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:ListAttachedGroupPolicies",
      "Resource": "arn:aws:s3:::datalake-published-data/file-24-15.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::different-datalake-published-data/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:StartNotebookInstance",
      "Resource": "arn:aws:s3:::datalake-published-data/file-18-4.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::datalake-published-data-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:s3:::datalake-athena-query-results/file-9-6.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:AddUserToGroup",
      "Resource": "arn:aws:s3:::regional-lambda-bucket-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:s3:::different-datalake-athena-query-results/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:DescribeSubnets",
      "Resource": "arn:aws:s3:::regional-lambda-bucket/file-29-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "glue:DeleteDatabase",
      "Resource": "arn:aws:s3:::datalake-athena-query-results/file-20-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "athena:BatchGetQueryExecution",
      "Resource": "arn:aws:s3:::datalake-athena-query-results/file-7-10.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::datalake-submissions-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "workspaces:DeleteWorkspaces",
      "Resource": "arn:aws:s3:::datalake-submissions/file-2-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::regional-lambda-bucket/file-9-13.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}