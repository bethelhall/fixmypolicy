{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:Connect"
      ],
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Condition": {
        "StringEquals": {
          "iot:LastWillTopic": "arn:aws:iot:region:account-id:topic/my/lastwill/topicName"
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:Connect"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iot:ConnectAttributes": [
            "PersistentConnect"
          ]
        }
      },
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-12",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "glue:GetDatabase",
      "Resource": "arn:aws:s3:::bucket-0/file-9.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "glue:UpdateTable",
      "Resource": "arn:aws:s3:::bucket-49/file-6.txt",
      "Condition": {
        "StringEquals": {
          "iot:LastWillTopic": "not-arn:aws:iot:region:account-id:topic/my/lastwill/topicName"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-2",
      "Condition": {
        "StringEquals": {
          "iot:ConnectAttributes": "not-['PersistentConnect']"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DeleteApplication",
      "Resource": "arn:aws:s3:::bucket-49/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:PurgeQueue",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-10",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "iam:DeleteAccessKey",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-24",
      "Condition": {
        "StringEquals": {
          "iot:ConnectAttributes": "not-['PersistentConnect']"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-0",
      "Condition": {
        "StringEquals": {
          "iot:ConnectAttributes": "not-['PersistentConnect']"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "kinesis:DeleteStream",
      "Resource": "arn:aws:s3:::bucket-11/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DescribeApplications",
      "Resource": "arn:aws:s3:::bucket-0/file-1.txt",
      "Condition": {
        "StringEquals": {
          "iot:LastWillTopic": "not-arn:aws:iot:region:account-id:topic/my/lastwill/topicName"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "guardduty:GetDetector",
      "Resource": "arn:aws:s3:::bucket-5/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "workspaces:StartWorkspaces",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-8",
      "Condition": {
        "StringEquals": {
          "iot:LastWillTopic": "not-arn:aws:iot:region:account-id:topic/my/lastwill/topicName"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}