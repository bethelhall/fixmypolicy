{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "rds-db:connect"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "codedeploy:GetDeployment",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "redshift:DescribeClusters",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "codepipeline:ListPipelines",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:DeleteAlias",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:ListModels",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutBucketVersioning",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kinesis:GetRecords",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:CreateAlias",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "glue:GetJob",
      "Resource": "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}