{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAppFlowDestinationActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:PutObjectAcl",
        "s3:PutObject",
        "s3:ListMultipartUploadParts",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketAcl",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/*",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp"
      ]
    },
    {
      "Sid": "AllowKMSandCloudWatch",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowCodeBuildAndRedShift",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "redshift:CreateCluster"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEC2AndSQS",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AttachVolume",
        "ec2:ImportKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGuardDuty",
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteDetector"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIAM",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers",
        "iam:DeleteUser"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketCors",
        "s3:DeleteBucketWebsite",
        "s3:DeleteObject",
        "s3:PutBucketWebsite",
        "s3:DeleteObjectTagging"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowSQS",
      "Effect": "Allow",
      "Action": [
        "sqs:ChangeMessageVisibility",
        "sqs:ChangeMessageVisibilityBatch"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowConfig",
      "Effect": "Allow",
      "Action": [
        "config:PutConfigRule"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}