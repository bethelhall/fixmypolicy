      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-8/file-8.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "authorized/arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}