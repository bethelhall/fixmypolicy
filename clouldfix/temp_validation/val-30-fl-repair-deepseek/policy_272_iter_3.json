{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "rds-db:connect"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:ListGroups"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListEndpointConfigs"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-5/file-5.txt"
      ],
      "Principal": [
        "arn:aws:iam::111222333444:user/david"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-4/file-4.txt"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:ListGrants"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "forbidden-arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test-specific"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role"
      ],
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
