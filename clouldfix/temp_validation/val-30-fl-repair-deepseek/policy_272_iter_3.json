    {
      "Effect": "Allow",
      "Action": [
        "ses:VerifyEmailIdentity"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteQueue"
      ],
      "Resource": [
        "arn:aws:rds-db:eu-west-1:11111111111:dbuser:example-db/rds-test"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteMessage"
