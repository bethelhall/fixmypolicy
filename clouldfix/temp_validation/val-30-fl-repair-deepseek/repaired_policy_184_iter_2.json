{
  "Version": "2012-10-17",
  "Id": "auto-sns-1",
  "Statement": [
    {
      "Sid": "Allow access through SNS for all principals in the account that are authorized to use SNS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "xxxxxxxxxxxx",
          "kms:ViaService": "sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow direct access to key metadata to the account",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::xxxxxxxxxxxx:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:RevokeGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Allow sqs:CreateQueue if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "sqs:CreateQueue",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-24",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow route53:ChangeResourceRecordSets if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow iam:ListAttachedUserPolicies if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "iam:ListAttachedUserPolicies",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow cloudwatch:GetMetricStatistics if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::361567453596:root"
      },
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow ses:ListIdentities if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::486757821305:root"
      },
      "Action": "ses:ListIdentities",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-14",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow ec2:ModifyInstanceAttribute if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow cloudformation:DescribeStacks if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::248284580414:root"
      },
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow glue:StartCrawler if the principal is from the same account and the requested region matches",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "glue:StartCrawler",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-10",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}