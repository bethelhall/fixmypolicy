{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificIAMActionsAndResourcesWithinUSWest2Only",
      "Effect": "Allow",
      "Action": "iam:AttachUserPolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-4/table-23",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBOperationsFromUnauthorizedUsersUnderCertainConditions",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyEC2InstanceCreationByRoleIfNotInUsWest2",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenySQSPeerChannelCommunicationsWithoutSSL",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "AllowGlueTableListingButRestrictedRegionalPermissions",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-19/table-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "PreventSuppressionOfTagsFromBuckets",
      "Effect": "Deny",
      "Action": "s3:DeleteObjectTagging",
      "Resource": "arn:aws:s3:::bucket-28/file-9.txt"
    },
    {
      "Sid": "LimitAccessBasedOnSourceIPAddress",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateLoginProfile"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "GrantSpecificPermissionsToServicePrincipals",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::bucket-45/file-1.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "AllowGlueTableRetrievalViaAPI",
      "Effect": "Allow",
      "Action": "s3:GetBucketLogging",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-1",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowInstancesCreationWithCertainConditions",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-19/table-17",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}