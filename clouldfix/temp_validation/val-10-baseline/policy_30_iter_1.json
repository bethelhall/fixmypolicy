{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActionsOnResourcesWithConditionsAndPrincipals",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLifecycle",
        "route53:GetHostedZone",
        "kinesis:CreateStream",
        "iam:GetRole",
        "elasticloadbalancing:DescribeLoadBalancers"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-19/file-5.txt",
        "arn:aws:route53:::hostedzone/*",
        "arn:aws:kinesis:*:*:stream/*",
        "arn:aws:iam::*:role/*",
        "arn:aws:elasticloadbalancing:*:*:loadbalancer/*/*"
      ],
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyLambdaCreationBasedOnTags",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringNotLike": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AllowDynamoDBDeletionOnlyInCertainRegionsForCertainUsers",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyPuttingItemsIntoAdminBucketsFromNonAdmins",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaWorkGroupOperationsWithinSpecifiedRegionByAnyUser",
      "Effect": "Allow",
      "Action": [
        "athena:ListWorkGroups",
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution"
      ],
      "Resource": "arn:aws:athena:*:*:workgroup/*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyRDSOperationIfKeyMatchesGivenValue",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AllowGlueTableAccessToServiceRoles",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:UpdateTable",
        "glue:BatchGetPartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-*/table-*",
        "arn:aws:glue:us-east-1:123456789012:catalog"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowIAMReadPermissionsViaSTSAssumeRole",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": "arn:aws:iam::123456789012:role/service-role",
      "Principal": "arn:aws:iam::123456789012:root"
    }
  ]
}