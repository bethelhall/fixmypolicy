{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccessToSpecificGlueResourcesAndActionsForServiceRoleInUsEast1",
      "Effect": "Allow",
      "Action": [
        "glue:GetConnections",
        "glue:GetTables",
        "glue:GetTableVersions",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetJob",
        "glue:StartJobRun",
        "glue:BatchStopJobRun",
        "glue:GetCrawler",
        "s3:GetObjectVersion",
        "glue:GetJob",
        "s3:PutBucketCors",
        "redshift:DeleteCluster",
        "rds:DescribeDBInstances",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:connection/*",
        "arn:aws:glue:*:248135293344:job/*",
        "arn:aws:glue:*:248135293344:database/glue*",
        "arn:aws:glue:*:248135293344:catalog",
        "arn:aws:glue:*:248135293344:table/glue*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAccessToSpecifiedJobsAndFilesOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:job/file-45-0.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowPuttingBucketcorsAsAuthorizedUser",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketCors"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:job/file-28-5.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenySendingMessagesFromUnauthorizedDeveloperRole",
      "Effect": "Deny",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:connection/*/file.txt"
      ],
      "Principal": "arn:aws:iam::111222333444:role/developer-role"
    },
    {
      "Sid": "AllowDeletingClustersWithCertainPrincipals",
      "Effect": "Allow",
      "Action": [
        "redshift:DeleteCluster"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:table/glueresource-21-8"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyDeletingUsersBasedOnTagsOrRegions",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:connection/*-forbidden-resource"
      ],
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Sid": "DenyInvokingLambdaFunctionsWithoutConditionsMet",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:database/glue*/file.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Sid": "AllowDescribingRDSInstancesWithinARegion",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:table/glueresource-1-5"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowRevokingSGIngressRulesViaIAMRoles",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:table/glueresource-14-14"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyUpdatingCatalogItemsOutsideOfUSWest2",
      "Effect": "Deny",
      "Action": [
        "glue:UpdateTable"
      ],
      "Resource": [
        "arn:aws:glue:*:248135293344:catalog/file.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    }
  ]
}