{
  "Version": "2012-10-17",
  "Id": "__default_policy_ID",
  "Statement": [
    {
      "Sid": "__default_statement_ID",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager"
    },
    {
      "Sid": "IncidentManagerSNSPublishingPermissions",
      "Effect": "Allow",
      "Principal": {
        "Service": "ssm-incidents.amazonaws.com"
      },
      "Action": "SNS:Publish",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager"
    },
    {
      "Sid": "DenyLambdaInvocation",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager-forbidden-resource",
      "Principal": {
        "AWS": "arn:aws:iam::987654321098:user/charlie"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyLambdaCreation",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager-specific",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "SQSUntagAllowed",
      "Effect": "Allow",
      "Action": "sqs:UntagQueue",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "SQSAddPermissionAllowed",
      "Effect": "Allow",
      "Action": "sqs:AddPermission",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "SQSDeleteMessageAllowed",
      "Effect": "Allow",
      "Action": "sqs:DeleteMessage",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "CodeCommitDeletionDenied",
      "Effect": "Deny",
      "Action": "codecommit:DeleteRepository",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "WorkspaceStoppingAllowed",
      "Effect": "Allow",
      "Action": "workspaces:StopWorkspaces",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/temp-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DynamoDBDeletionDenied",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/david"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "IAMUserDeletionDenied",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "EC2DescriptionAllowed",
      "Effect": "Allow",
      "Action": "ec2:DescribeVolumes",
      "Resource": "arn:aws:sns:ap-south-1:xxxxxxxxx:AWSChatBot-Incident-Manager",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}