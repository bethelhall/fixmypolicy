{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": "textract:*",
      "Resource": "*"
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::<<my_bucket_name>>",
        "arn:aws:s3:::<<my_bucket_name>>/*",
        "arn:aws:s3:::textract-console-us-east-1-<<auto_created_id_1>>",
        "arn:aws:s3:::textract-console-us-east-1-<<auto_created_id_1>>/*",
        "arn:aws:s3:::textract-adapters-us-east-1-<<auto_created_id_2>>",
        "arn:aws:s3:::textract-adapters-us-east-1-<<auto_created_id_2>>/*"
      ]
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "*"
    },
    {
      "Id": "deny_a73804fc",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Id": "allow_b96242d4",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:s3:::bucket-47/file-4.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "allow_d1b3fda9",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "arn:aws:s3:::textract-console-us-east-1-<<auto_created_id_1>>/file-13-12.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_0c067755",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::textract-console-us-east-1-<<auto_created_id_1>>-forbidden/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Id": "allow_d9cb2460",
      "Effect": "Allow",
      "Action": "kms:ListKeys",
      "Resource": "arn:aws:s3:::textract-adapters-us-east-1-<<auto_created_id_2>>/file-35-14.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Id": "allow_65aae0fa",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-10/table-6",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Id": "allow_694a2304",
      "Effect": "Allow",
      "Action": "iam:DeletePolicy",
      "Resource": "arn:aws:s3:::textract-adapters-us-east-1-<<auto_created_id_2>>/file-6-17.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Id": "deny_9f425fe1",
      "Effect": "Deny",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Id": "allow_b631630d",
      "Effect": "Allow",
      "Action": "config:GetComplianceDetailsByConfigRule",
      "Resource": "arn:aws:s3:::bucket-6/file-8.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_201497ac",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "arn:aws:s3:::different-textract-console-us-east-1-<<auto_created_id_1>>/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}