{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDynamoDBPutItemToAdminRoleInUsEast1KmsKey",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-1:123456789012:table/*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:kms:us-east-1:123456789012:key/*"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AllowSagemakerDescribeNotebookInstanceOnServiceRole",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeNotebookInstance",
      "Resource": "arn:aws:sagemaker:us-east-1:123456789012:notebookinstance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyEC2RunInstancesForDeveloperRole",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::111222333444:role/developer-role"
    },
    {
      "Sid": "AllowCodeCommitCreateRepositoryOnServiceRole",
      "Effect": "Allow",
      "Action": "codecommit:CreateRepository",
      "Resource": "arn:aws:codecommit:us-east-1:123456789012:repositories/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowRedshiftCreateClusterForUserBob",
      "Effect": "Allow",
      "Action": "redshift:CreateCluster",
      "Resource": "arn:aws:redshift:us-east-1:123456789012:cluster/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenyDynamoDBDeleteItemFromUnauthorizedUser",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:999888777666:table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Sid": "AllowSagemakerListEndpointConfigsForAlice",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpointConfigs",
      "Resource": "arn:aws:sagemaker:us-east-1:123456789012:endpoint-config/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenySQSDeletePermissionWithWrongIP",
      "Effect": "Deny",
      "Action": "sqs:RemovePermission",
      "Resource": "arn:aws:sqs:us-east-1:123456789012:queues/*",
      "Condition": {
        "NotIpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      },
      "Principal": "*"
    },
    {
      "Sid": "DenyRDSCreateDBInstanceForUnauthorizedUser",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:rds:us-east-1:123456789012:db:*",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": false
        }
      },
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Sid": "AllowGuardDutyCreateDetectorOnServiceRole",
      "Effect": "Allow",
      "Action": "guardduty:CreateDetector",
      "Resource": "arn:aws:guardduty:eu-west-1:123456789012:detector/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    }
  ]
}