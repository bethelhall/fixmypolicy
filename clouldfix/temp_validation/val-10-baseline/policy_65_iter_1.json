{
  "Version": "2012-10-17",
  "Id": "PolicyForTests",
  "Statement": [
    {
      "Sid": "Stmt1",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteGroup",
        "iam:DeleteUser",
        "sqs:SendMessage",
        "kms:UpdateKeyDescription",
        "iam:CreateUser",
        "iam:UpdateLoginProfile",
        "kms:ListKeys",
        "rds:DeleteDBInstance",
        "s3:GetBucketLogging",
        "codebuild:ListBuilds"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {}
    },
    {
      "Sid": "Stmt2",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:GetContact",
        "ses:GetContactList",
        "ses:CreateContactList",
        "ses:CreateContact",
        "ses:DeleteContact",
        "ses:DeleteContactList",
        "ses:ListContactLists",
        "ses:ListContacts"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {}
    }
  ]
}