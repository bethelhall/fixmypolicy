{
  "Version": "2012-10-17",
  "Id": "PolicyForWebsiteAccessAndRestrictions",
  "Statement": [
    {
      "Sid": "AllowWebsiteAccessForViewing",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mybucket/*",
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowWebsiteAccessForUploads",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::mybucket/*",
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "DenySQSReceiptFromCertainRoleOnCertainFileInCertainBucket",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::mybucket-forbidden/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:role/developer-role"
      },
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "DenySettingCrossOriginConfigurationOfDifferentMyBucketWithCertainUser",
      "Effect": "Deny",
      "Action": "s3:PutBucketCors",
      "Resource": "arn:aws:s3:::different-mybucket/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/temp-user"
      },
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyChangingTheLogsOfCompletelyDifferentBucketToUnauthorizedUser",
      "Effect": "Deny",
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowPuttingBucketLoggingIfRequestIsMadeByCertainRole",
      "Effect": "Allow",
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::mybucket/file-21-1.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowDescribingLogStreamsOnlyIfRequesterIsTempUserOrDeveloperRole",
      "Effect": "Allow",
      "Action": "logs:DescribeLogStreams",
      "Resource": "arn:aws:s3:::mybucket/file-20-12.txt",
      "Principal": {
        "AWS": [
          "arn:aws:iam::111222333444:user/temp-user",
          "arn:aws:iam::111222333444:role/developer-role"
        ]
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowCreatingEndpointConfigsBasedOnConditions",
      "Effect": "Allow",
      "Action": "sagemaker:CreateEndpointConfig",
      "Resource": "arn:aws:s3:::mybucket/file-25-13.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDisablingKeysViaKMSButNotOutsideRegions",
      "Effect": "Allow",
      "Action": "kms:DisableKey",
      "Resource": "arn:aws:s3:::mybucket/file-6-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/temp-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowLambdaCreationWithinEUWest1",
      "Effect": "Allow",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::mybucket/file-22-9.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyRestoringObjectsThatAreDenied",
      "Effect": "Deny",
      "Action": "s3:RestoreObject",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:role/developer-role"
      },
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://example.com/*",
            "https://example.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowRestoringSpecificFilesWhenIPMatches",
      "Effect": "Allow",
      "Action": "s3:RestoreObject",
      "Resource": "arn:aws:s3:::mybucket/file-30-7.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/temp-user"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}