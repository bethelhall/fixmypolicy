{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "es:DeleteTags",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-31-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "cloudformation:DeleteStack",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-30-16.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-10-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/*-specific",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/*/file.txt",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "ec2:AttachVolume",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-4-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/*-forbidden-resource",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-26-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-8-15.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "es:*",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/*",
      "Sid": "statement1"
    }
  ]
}