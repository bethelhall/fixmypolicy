{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "codepipeline:StartPipelineExecution",
        "logs:CreateLogGroup",
        "sagemaker:DescribeTrainingJob",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "kms:GetKeyPolicy",
        "cloudwatch:PutDashboard"
      ],
      "Resource": "arn:aws:dynamodb:*:<ACCOUNT>:table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:<ACCOUNT>:table/<TABLE>"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "part123"
          ],
          "dynamodb:Attributes": [
            "mykey",
            "mymap"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "rds:CreateDBInstance",
        "dynamodb:CreateTable",
        "dynamodb:BatchWriteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateTable"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "part123"
          ],
          "dynamodb:Attributes": [
            "mykey",
            "mymap"
          ]
        }
      },
      "Principal": "arn:aws:iam::111222333444:user/david"
    },
    {
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "part123"
          ],
          "dynamodb:Attributes": [
            "mykey",
            "mymap"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    }
  ]
}