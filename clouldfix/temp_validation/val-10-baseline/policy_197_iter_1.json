{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowESDomainCreationInUsEast1Only",
      "Effect": "Allow",
      "Action": "es:CreateElasticsearchDomain",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-28-4.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBOperationsFromCrossAccountRole",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:s3:::different-great-expectations-docs/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "vpce-0c0f4bb767f820bda"
        }
      }
    },
    {
      "Sid": "DenyDeletingItemsViaAPIForBobUser",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "vpce-0c0f4bb767f820bda"
        }
      }
    },
    {
      "Sid": "AllowPuttingBucketTagsByTempUser",
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-47-15.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/temp-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyRDSOperationIfSourceVpceMatchesAndNotTheRightUser",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam::987654321098:user/charlie"
      },
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "vpce-0c0f4bb767f820bda"
        }
      }
    },
    {
      "Sid": "DenyLambdaInvocationBasedOnVPCEndpoint",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:s3:::great-expectations-docs-forbidden/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "vpce-0c0f4bb767f820bda"
        }
      }
    },
    {
      "Sid": "AllowListingOfIAMKeysWithCorrectVPCEndpoint",
      "Effect": "Allow",
      "Action": "iam:ListAccessKeys",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-37-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:sourceVpce": "not-vpce-0c0f4bb767f820bda"
        }
      }
    },
    {
      "Sid": "AllowGettingSpecificS3ObjectVersion",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-3-7.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowRunningEC2InstancesAsTestRole",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-10-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowRoute53RequestingEuWest1",
      "Effect": "Allow",
      "Action": "route53:GetHostedZone",
      "Resource": "arn:aws:s3:::great-expectations-docs/file-46-3.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}