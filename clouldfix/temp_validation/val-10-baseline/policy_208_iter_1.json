{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "s3-object-lambda:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "DenySQSRoleAccessToSpecificFileInDeniedBucket",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:role/test-role"
        }
      }
    },
    {
      "Sid": "DenyRDSRoleCreationFromCrossAccountAndRequireSecureTransport",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::555666777888:role/cross-account-role"
        }
      }
    },
    {
      "Sid": "AllowKMSEncryptionKeyPoliciesRetrievalForUserAlice",
      "Effect": "Allow",
      "Action": "kms:GetKeyPolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-15/table-2",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    },
    {
      "Sid": "AllowAthenaDeletionOfExistingWorkGroupsOnlyIfRequestIsMadeWithinTheSameRegionAsTheirDataLocation",
      "Effect": "Allow",
      "Action": "athena:DeleteWorkGroup",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:role/service-role"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBOperationOnKMSProtectedKeysBasedOnIPandIAMPrincipals",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "NotIpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/temp-user"
        }
      }
    },
    {
      "Sid": "AllowGlueTableLiftcycleManagementBySpecifiedUsers",
      "Effect": "Allow",
      "Action": "s3:GetBucketLifecycle",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-10/table-0",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/bob"
        }
      }
    },
    {
      "Sid": "AllowAthenasEndPointConfigsDescriptionViaServiceRolesWithCertainConditions",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeEndpointConfig",
      "Resource": "arn:aws:s3:::bucket-25/file-6.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:role/service-role"
        }
      }
    },
    {
      "Sid": "AllowSQSDeleteMessagesUsingARoleThatHasPermissionsOverASpecificQueue",
      "Effect": "Allow",
      "Action": "sqs:DeleteMessageBatch",
      "Resource": "arn:aws:s3:::bucket-33/file-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:role/service-role"
        }
      }
    },
    {
      "Sid": "DenyBlockedUserSendingAMessageThroughSQS",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/blocked-user"
        }
      }
    },
    {
      "Sid": "DenyEC2OperationsDependingUponMaxNumberOfObjectsAllowedPerRequest",
      "Effect": "Deny",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-69",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/bob"
        }
      }
    }
  ]
}