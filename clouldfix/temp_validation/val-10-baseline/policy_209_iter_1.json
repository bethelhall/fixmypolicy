{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetAccelerateConfiguration",
        "s3:PutAccelerateConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::<our_bucket_name>/*",
        "arn:aws:s3:::<our_bucket_name>"
      ]
    },
    {
      "Sid": "DenyRestorationOfObjectsInForbiddenBucket",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "s3:RestoreObject",
      "Resource": "arn:aws:s3:::<our_bucket_name>-forbidden/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "AllowCancellationOfKeyDeletionFromDifferentBucket",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "kms:CancelKeyDeletion",
      "Resource": "arn:aws:s3:::<our_bucket_name>/file-1-8.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyListingOfAllMyBucketsByUnauthorizedUser",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "s3:ListAllMyBuckets",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyModificationOfBucketVersioningOnDifferentBucketByNameCharlie",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::987654321098:user/charlie"
      },
      "Action": "s3:PutBucketVersioning",
      "Resource": "arn:aws:s3:::different-<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AllowCreationOfIAMLoginProfilesAsRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "iam:CreateLoginProfile",
      "Resource": "arn:aws:s3:::<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyGettingBucketCorsWithSpecificConditionsTempUser",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/temp-user"
      },
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:s3:::completely-different-bucket/*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowCreatingNewPoliciesWithinOurBucketTestUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "iam:CreatePolicy",
      "Resource": "arn:aws:s3:::<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowStartingNotebookInstancesEUWest1Only",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "sagemaker:StartNotebookInstance",
      "Resource": "arn:aws:s3:::<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDynamoDBQueriesBlockedUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:s3:::<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDescribingAlarmsCrossAccountRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "arn:aws:s3:::<our_bucket_name>/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}