{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": "iot:AssumeRoleWithCertificate",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias"
    },
    {
      "Sid": "DenyRDS",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/temp-user"
    },
    {
      "Sid": "AllowRoute53",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenyDynamoDB",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenyIAM",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowIAM",
      "Effect": "Allow",
      "Action": "iam:ListAccessKeys",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenySNSErrors",
      "Effect": "Deny",
      "Action": "sns:Publish",
      "Resource": "*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Principal": "arn:aws:iam::111222333444:role/developer-role"
    },
    {
      "Sid": "AllowLogs",
      "Effect": "Allow",
      "Action": "logs:PutLogEvents",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowGlueErrors",
      "Effect": "Allow",
      "Action": "glue:GetJobRun",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowKinesis",
      "Effect": "Allow",
      "Action": "kinesis:PutRecord",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowS3",
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:iot:us-west-2:831490426837:rolealias/GreengrassCoreTokenExchangeRoleAlias",
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    }
  ]
}