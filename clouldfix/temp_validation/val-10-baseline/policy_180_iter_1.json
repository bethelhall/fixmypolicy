{
  "Version": "2012-10-17",
  "Id": "PolicyForBob",
  "Statement": [
    {
      "Sid": "DenySubscriptionToSSM",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:ssm:*:*:session/S(aws:userid)--forbidden-resource",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowCreationOfIAMRolesByBobInEUWest1",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-43-11",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowPuttingTagsOnObjectsInUSWest2",
      "Effect": "Allow",
      "Action": "s3:PutObjectTagging",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-47-1",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowAthenaQueriesFromServiceRoleInUSWest2",
      "Effect": "Allow",
      "Action": "athena:StartQueryExecution",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-33-17",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowListingHostedZonesWithBobInUSEast1",
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-45-6",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowKeyReEncryptionForBobInUSWest2",
      "Effect": "Allow",
      "Action": "kms:ReEncrypt",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-5-10",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyDescribingEC2instancesAuthorizedFileAccessOnly",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-*/*/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowCreatingCloudFrontDistributionsByBobInUSWest2",
      "Effect": "Allow",
      "Action": "cloudfront:CreateDistribution",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-resource-15-16",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyCreationOfUsersSpecificARN",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:ssm:*:*:session/S(aws:userid)--specific",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyReceivingSQSMessagesBasedOnTagValue",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:ssm:*:*:session/$(aws:username)-*-forbidden-resource",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
}