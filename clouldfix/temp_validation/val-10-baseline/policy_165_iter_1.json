{
  "Version": "2012-10-17",
  "Id": "PolicyForTests",
  "Statement": [
    {
      "Sid": "DenyIAMCreateUserInAdminBucket",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringLike": {
          "aws:ResourceOrgPaths": [
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku70xxx/*",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku7xxx/",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxxx/ou-eihy-3ku70xxx",
            "*ou-eihy-3ku70yzx*"
          ]
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "AllowSagemakerListNotebookInstances",
      "Effect": "Allow",
      "Action": "sagemaker:ListNotebookInstances",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-14/table-23",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowCodebuildStopBuildOnEuWest1",
      "Effect": "Allow",
      "Action": "codebuild:StopBuild",
      "Resource": "arn:aws:s3:::bucket-24/file-6.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyDynamoDBDeleteItemFromDeniedBucket",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringLike": {
          "aws:ResourceOrgPaths": [
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku70xxx/*",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku7xxx/",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxxx/ou-eihy-3ku70xxx",
            "*ou-eihy-3ku70yzx*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyEC2DescribeInstancesToTestUser",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringLike": {
          "aws:ResourceOrgPaths": [
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku70xxx/*",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku7xxx/",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxxx/ou-eihy-3ku70xxx",
            "*ou-eihy-3ku70yzx*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Sid": "DenyRDSDeletDBInstanceByBlockedUser",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:ResourceOrgPaths": [
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku70xxx/*",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxx/ou-eihy-3ku7xxx/",
            "o-xxxxx/r-eihy/ou-eihy-xihtvxxxx/ou-eihy-3ku70xxx",
            "*ou-eihy-3ku70yzx*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Sid": "AllowIAMCreateLoginProfile",
      "Effect": "Allow",
      "Action": "iam:CreateLoginProfile",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-0/table-1",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowRedshiftDescribeClustersOnlyFromSpecificIP",
      "Effect": "Allow",
      "Action": "redshift:DescribeClusters",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-18",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowKMDescribeKeyOnlyFromSpecificIP",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "arn:aws:s3:::bucket-44/file-7.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowRDSDeleteDBInstanceWithUserIDStartingWithAIDAI",
      "Effect": "Allow",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-6/table-4",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    }
  ]
}