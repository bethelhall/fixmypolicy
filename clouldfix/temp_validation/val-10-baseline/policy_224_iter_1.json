{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActionsOnSpecifiedResourcesAndConditions",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-37-7.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenySQSRestrictedToCertainSourcesOnly",
      "Effect": "Deny",
      "Action": [
        "sqs:ReceiveMessage"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx-forbidden/file.txt",
      "Principal": {
        "AWS": "cloudfront.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxx:distribution/something"
        }
      }
    },
    {
      "Sid": "RestrictCFDistributionViewingOfStackDetails",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-42-16.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAliceFullControlOverHerFilesInTheBucket",
      "Effect": "Allow",
      "Action": [
        "cloud9:CreateEnvironmentEC2"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-35-10.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "PreventUnauthorizedDeletionFromDifferentBuckets",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "cloudfront.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxx:distribution/something"
        }
      }
    },
    {
      "Sid": "LimitSettingQueueAttributesByIPandIAMUsers",
      "Effect": "Allow",
      "Action": [
        "sqs:SetQueueAttributes"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-46-19.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "BobCanManageHisOwnKeysButNotOthers'",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-22-1.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "GrantPermissionsBasedOnRequestorIdentity",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:s3:::xxxx-bucket-name-xxxx/file-38-6.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxx:distribution/something"
        }
      }
    },
    {
      "Sid": "BlockAllExceptForWhitelistedServices",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "cloudfront.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxx:distribution/something"
        }
      }
    }
  ]
}