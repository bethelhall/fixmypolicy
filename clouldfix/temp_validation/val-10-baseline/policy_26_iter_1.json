{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Stmt1721248399622",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      },
      "Action": "ses:SendRawEmail",
      "Resource": "arn:aws:ses:eu-west-1:222222222222:identity/mydomain.com"
    },
    {
      "Sid": "createkey",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "getrepository",
      "Effect": "Allow",
      "Action": "codecommit:GetRepository",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "updatedatabase",
      "Effect": "Allow",
      "Action": "glue:UpdateDatabase",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::875797485194:root"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "encryptdata",
      "Effect": "Allow",
      "Action": "kms:Encrypt",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::335557960228:root"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deletestack",
      "Effect": "Allow",
      "Action": "cloudformation:DeleteStack",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "createsecuritygroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "verifyemailidentity",
      "Effect": "Deny",
      "Action": "ses:VerifyEmailIdentity",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "getidentitydkimattributes",
      "Effect": "Deny",
      "Action": "ses:GetIdentityDkimAttributes",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "receivedmessage",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      },
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "receivemessagedenied",
      "Effect": "Deny",
      "Action": "s3:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      }
    }
  ]
}