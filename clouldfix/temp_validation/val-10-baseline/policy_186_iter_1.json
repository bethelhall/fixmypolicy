{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement2"
    },
    {
      "Action": [
        "sqs:TagQueue"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-20-5.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "sagemaker:CreateEndpointConfig"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/file-25-5.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "kms:Encrypt"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Action": [
        "codepipeline:StartPipelineExecution"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-6-15.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "kms:ReEncrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Action": [
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-14-12.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:user/david"
    },
    {
      "Action": [
        "s3:GetBucketCors"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/file-29-4.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": [
        "kms:ReEncrypt"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-27-13.txt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}