{
  "Version": "2012-10-17",
  "Id": "Policy1637840001466",
  "Statement": [
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "deny_6ba2520a",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::different-angular-upload-files-2023-2024/file.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      }
    },
    {
      "Sid": "allow_6c45b0ce",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "athena:CreateWorkGroup",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-27-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_d91cdbcb",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_9bfc52d1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "iam:ListAttachedGroupPolicies",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-23-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deny_bc19d480",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "sqs:ReceiveMessage",
