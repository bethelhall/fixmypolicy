        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "allow_9a832b03",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
