{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "allowed_operations_from_alice",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteFunction",
        "sqs:DeleteQueue",
        "iam:DeleteUser",
        "codecommit:DeleteRepository",
        "s3:GetBucketLocation",
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:bedrock:eu-west-1:814089719562:inference-profile/file-0-7.txt",
        "arn:aws:bedrock:us-east-1::foundation-model/file-11-4.txt",
        "arn:aws:bedrock:us-west-2::foundation-model/file-48-16.txt",
        "arn:aws:bedrock:eu-west-1:814089719562:inference-profile/file-49-0.txt",
        "arn:aws:bedrock:us-west-2:814089719562:inference-profile/file-16-18.txt",
        "arn:aws:bedrock:us-west-2::foundation-model/file-19-7.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "eu-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "prevent_unauthorized_deletion",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:bedrock:*:814089719562:inference-profile/*/file.txt",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "explicitly_denied_actions",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*-forbidden-resource",
        "arn:aws:bedrock:*::foundation-model/*-specific"
      ],
      "Principal": [
        "arn:aws:iam::111222333444:user/david",
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}