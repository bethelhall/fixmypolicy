{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyIAMCreateUserInCertainKMSKeyAndRegionForSpecificUser",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:kms:us-east-1:123456789012:key/*"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/test-user"
        }
      }
    },
    {
      "Sid": "AllowKMSEditKeyDescriptionToBobOnlyIfRequestIsMadeInUSWest1OrEUWest1",
      "Effect": "Allow",
      "Action": "kms:UpdateKeyDescription",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-8",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "eu-west-1"
          ]
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/bob"
        }
      }
    },
    {
      "Sid": "DisallowSQSPermissionRemovalByAliceEvenThoughTheRegionMatches",
      "Effect": "Deny",
      "Action": "sqs:RemovePermission",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-12/table-2",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    },
    {
      "Sid": "DisallowDynamoDBOperationOnAdminRoleRegardlessOfRegion",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    },
    {
      "Sid": "DisallowRemovingUsersFromGroupsThatAreNotServiceRoles",
      "Effect": "Deny",
      "Action": "iam:RemoveUserFromGroup",
      "Resource": "arn:aws:s3:::bucket-29/file-4.txt",
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:role/service-role"
        }
      }
    },
    {
      "Sid": "DisallowInvokingLambdaFunctionsBasedOnBucketName",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::111222333444:role/developer-role"
        }
      }
    },
    {
      "Sid": "AllowGlueGettingJobsRunsDoneByALiceWithCorrectRegion",
      "Effect": "Allow",
      "Action": "glue:GetJobRun",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-16/table-1",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    },
    {
      "Sid": "DisallowSNSSubscriptionBecauseItDoesntMatchARequiredTagValue",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringNotEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AllowCreatingEndpointsViaSageMakerButRestrictedToSpecifiedRegions",
      "Effect": "Allow",
      "Action": "sagemaker:CreateEndpoint",
      "Resource": "arn:aws:s3:::bucket-2/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    },
    {
      "Sid": "AllowAccessingKeysPoliciesWhenTheyBelongToASpecificUser",
      "Effect": "Allow",
      "Action": "kms:GetKeyPolicy",
      "Resource": "arn:aws:s3:::bucket-26/file-1.txt",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/alice"
        }
      }
    }
  ]
}