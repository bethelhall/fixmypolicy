{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-test-bucket",
        "arn:aws:s3:::my-test-bucketc/*"
      ]
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:11111111111:repository/my-test-ecr"
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "statement5",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-1:11111111111:my-test-app/*"
    },
    {
      "Id": "allow_d9ababa2",
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "arn:aws:s3:::bucket-0/file-9.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_59f880c2",
      "Effect": "Deny",
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:s3:::different-my-test-bucketc/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Id": "allow_a6e29560",
      "Effect": "Allow",
      "Action": "kms:ListKeys",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-14/table-14",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Id": "allow_7200a151",
      "Effect": "Allow",
      "Action": "iam:PutRolePolicy",
      "Resource": "arn:aws:s3:::bucket-4/file-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Id": "allow_93e106dc",
      "Effect": "Allow",
      "Action": "athena:GetTableMetadata",
      "Resource": "arn:aws:s3:::my-test-bucketc/file-15-10.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Id": "allow_d66e2fd3",
      "Effect": "Allow",
      "Action": "iam:DeleteRole",
      "Resource": "arn:aws:ssm:us-east-1:11111111111:my-test-app/file-40-14.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_1ca24c10",
      "Effect": "Deny",
      "Action": "s3:GetBucketLifecycle",
      "Resource": "arn:aws:ssm:us-east-1:11111111111:my-test-app/*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_ee984d42",
      "Effect": "Deny",
      "Action": "s3:PutBucketCors",
      "Resource": "arn:aws:ecr:us-east-1:11111111111:repository/my-test-ecr-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Id": "allow_71323b62",
      "Effect": "Allow",
      "Action": "iam:ListGroups",
      "Resource": "arn:aws:ssm:us-east-1:11111111111:my-test-app/file-39-15.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Id": "deny_95bfac7d",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "authorized/arn:aws:ssm:us-east-1:11111111111:my-test-app/*/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}