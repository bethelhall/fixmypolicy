{
  "Version": "2012-10-17",
  "Id": "defaultpolicy",
  "Statement": [
    {
      "Sid": "sendmessage",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "SQS:SendMessage",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    },
    {
      "Sid": "restoreobject",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "s3:RestoreObject",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "runinstances",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "ec2:RunInstances",
      "Resource": "forbidden-arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots-specific",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    },
    {
      "Sid": "setqueueattributes",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "sqs:SetQueueAttributes",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    },
    {
      "Sid": "listidentities",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "ses:ListIdentities",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "deleteitem",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    },
    {
      "Sid": "getobjectversion",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "publish",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    },
    {
      "Sid": "getbucketacl",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "getdashboard",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "cloudwatch:GetDashboard",
      "Resource": "arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deletedbinstance",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:role/developer-role"
      },
      "Action": "rds:DeleteDBInstance",
      "Resource": "authorized/arn:aws:sqs:eu-west-1:98xxxxx8745:nocodebots/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-1:98xxxxx8745:nocodebots"
        }
      }
    }
  ]
}