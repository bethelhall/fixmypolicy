{
  "Version": "2012-10-17",
  "Id": "PolicyForTests",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "logs:CancelExportTask",
        "logs:DescribeExportTasks",
        "logs:DescribeLogStreams",
        "logs:DescribeLogGroups",
        "logs:CreateExportTask",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:GetBucketLifecycle"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt",
        "kms:GenerateDataKeyWithoutPlaintext"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "glue:GetJob"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObjectTagging"
      ],
      "Resource": "*-forbidden-*",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement6",
      "Effect": "Deny",
      "Action": [
        "kms:ListAliases"
      ],
      "Resource": "forbidden--specific",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      }
    },
    {
      "Sid": "statement7",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketCors"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}