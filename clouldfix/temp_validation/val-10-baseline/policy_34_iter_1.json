{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Stmt1380877761162",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucketname/*"
    },
    {
      "Sid": "DenyPutBucketTaggingOnForbiddenBucketAndInEUWestOnly",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      },
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:s3:::bucketname-forbidden/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowPutBucketTaggingOnAllowedBucketAndInUSEastOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:s3:::bucketname/file-13-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyDeleteBucketFromDifferentBucketNameAndInUSEastOnly",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "s3:DeleteBucket",
      "Resource": "arn:aws:s3:::different-bucketname/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaActionsWithCorrectPrincipalsAndConditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/forbidden-role",
          "arn:aws:iam::111222333444:user/temp-user"
        ]
      },
      "Action": [
        "athena:GetDatabase"
      ],
      "Resource": "arn:aws:s3:::bucketname/file-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyDeletingObjectsOutsideOfDeniedIPRange",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-*.txt",
      "Condition": {
        "NotIpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenySQSRcvMsgIfSrcIsntOverSSLandHasWrongPrinicpal",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}