{
  "Version": "2012-10-17",
  "Id": "PolicyCorrection",
  "Statement": [
    {
      "Sid": "AllowBE47035E",
      "Effect": "Allow",
      "Action": "s3:GetBucketLifecycle",
      "Resource": "arn:aws:s3:::bucket-19/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "Deny29A70055",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:role/developer-role"
      }
    },
    {
      "Sid": "AllowRDSAndDynamoDBActionsInCertainRegions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-0/file-0.txt",
        "arn:aws:s3:::admin-bucket/document.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/david"
      }
    },
    {
      "Sid": "DenyBBBAAAAUDenyUnauthorizedKMSUsage",
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": false
        }
      },
      "Principal": {
        "AWS": "*"
      }
    },
    {
      "Sid": "DenyCCCCEEERRDDenyUnauthorizedRDSCreation",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "AllowIAMGetRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-2/table-18",
