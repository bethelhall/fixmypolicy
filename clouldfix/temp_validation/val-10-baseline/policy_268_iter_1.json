{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessForFTP",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::image.k-sale.com",
        "arn:aws:s3:::image.k-sale.com/*"
      ]
    },
    {
      "Sid": "AllowCodeBuild",
      "Effect": "Allow",
      "Action": "codebuild:BatchGetBuilds",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-46-5.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyEC2RunInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::different-image.k-sale.com/file.txt",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AllowCodePipeline",
      "Effect": "Allow",
      "Action": "codepipeline:StartPipelineExecution",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-20-5.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowElasticBeanstalkDeleteApplication",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DeleteApplication",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-1-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEC2RunInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-12-15.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyS3DeleteBucket",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIamListPolicies",
      "Effect": "Allow",
      "Action": "iam:ListPolicies",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-35-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketVersioning",
      "Effect": "Deny",
      "Action": "s3:PutBucketVersioning",
      "Resource": "arn:aws:s3:::image.k-sale.com-forbidden/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowGuardDutyListDetectors",
      "Effect": "Allow",
      "Action": "guardduty:ListDetectors",
      "Resource": "arn:aws:s3:::image.k-sale.com/file-29-4.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketVersioning",
      "Effect": "Deny",
      "Action": "s3:PutBucketVersioning",
      "Resource": "arn:aws:s3:::image.k-sale.com-forbidden/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    }
  ]
}