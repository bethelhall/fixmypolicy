{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2DescribeInstancesAndEndPoints",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceConnectEndpoints"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Sid": "EC2InstanceConnectActions",
      "Action": [
        "ec2-instance-connect:SendSSHPublicKey",
        "ec2-instance-connect:OpenTunnel",
        "ec2-instance-connect:SendSerialConsoleSSHPublicKey",
        "ec2:CreateInstanceConnectEndpoint",
        "ec2:CreateNetworkInterface",
        "ec2:CreateTags",
        "iam:CreateServiceLinkedRole"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Sid": "AllowsAliceToRunATrainingJobInUsEast1WithGlueTableArn",
      "Effect": "Allow",
      "Action": "sagemaker:CreateTrainingJob",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-6",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DeniesDeletionOfAdminRolesByKeyPairsOrKMSKeys",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteKeyPair",
        "kms:DeleteKey"
      ],
      "Resource": "*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AltersPermissionsForBobOnAthenaWorkgroups",
      "Effect": "Allow",
      "Action": "s3:DeleteBucketWebsite",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-85",
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "GrantsPermissionToModifyQueriesFromSpecificUsersOnly",
      "Effect": "Allow",
      "Action": "athena:GetQueryExecution",
      "Resource": "arn:aws:s3:::bucket-38/file-2.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "PreventsUpdatesForKeyBasedAccessChangesByNonAdmins",
      "Effect": "Deny",
      "Action": "iam:UpdateAccessKey",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "PreventCreationOfNewIAMUsersOutsideSpecifiedRegions",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "RestrictListingOfAccessKeysViaPolicy",
      "Effect": "Deny",
      "Action": "iam:ListAccessKeys",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "GrantAListBucketsRoute53PermissiveOverHTTPSToAlice",
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "arn:aws:s3:::bucket-31/file-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "EnablesDescribingModelsThroughAPIAccessibleToBob",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeModel",
      "Resource": "arn:aws:s3:::bucket-45/file-5.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "EnableStartingJupyterNotebooksAccessibleWithinARegion",
      "Effect": "Allow",
      "Action": "sagemaker:StartNotebookInstance",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-6/table-7",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}