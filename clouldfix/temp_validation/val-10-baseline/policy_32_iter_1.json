{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyLambdaCreationFromBlockedIPAndSpecificARN",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "ArnNotLike": {
          "aws:SourceArn": [
            "forbidden-arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/CLIENT_ID/*"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      }
    },
    {
      "Sid": "AllowS3BucketPolicyModificationByAliceInEUWest1Only",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/CLIENT_ID/file-15-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowCloudTrailLoggingStartingForServiceRoleInUSWest2Only",
      "Effect": "Allow",
      "Action": "cloudtrail:StartLogging",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/$aws/things/CLIENT_ID/shadow/file-1-9.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "AllowSESDeletionOfIdentitiesByBobInUSEast1Only",
      "Effect": "Allow",
      "Action": "ses:DeleteIdentity",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/$aws/things/CLIENT_ID/shadow/file-45-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      }
    },
    {
      "Sid": "DenyDynamoDBDeletionWithUnauthorizedARNandCrossAccountAccess",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/CLIENT_ID/file.txt",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalType": "IAM"
        },
        "ArnNotLike": {
          "aws:SourceArn": [
            "authorized/arn:aws:iot:eu-west-3:ACCOUNT_ID:client/CLIENT_ID/file.txt"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      }
    },
    {
      "Sid": "AllowKinesisDeletionByAuthorizedUsersInEUWest1Only",
      "Effect": "Allow",
      "Action": "kinesis:DeleteStream",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/$aws/things/CLIENT_ID/shadow/file-12-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "DenyDynamoDBDeletionWithUnauthorizedARNinUSEast1Only",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/CLIENT_ID/file-27-10.txt",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalType": "IAM"
        },
        "ArnNotLike": {
          "aws:SourceArn": [
            "authorized/arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/$aws/things/CLIENT_ID/shadow/*/file.txt"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "DenyIAMUserDeletionAcrossAccountsViaAPIorSDKsWithSpecifiedIP",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/$aws/things/CLIENT_ID/shadow/*/file.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "ArnNotLike": {
          "aws:SourceArn": [
            "authorized/arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/$aws/things/CLIENT_ID/shadow/*/file.txt"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      }
    },
    {
      "Sid": "AllowKMSGrantsOnResourcesAccessibleToBobInUSEast1Only",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/$aws/things/CLIENT_ID/shadow/file-11-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      }
    },
    {
      "Sid": "DenyDynamoDBInsertionBasedOnARNSpecificity",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:client/CLIENT_ID-forbidden-resource",
      "Condition": {
        "ArnNotLike": {
          "aws:SourceArn": [
            "*"
          ]
        }
      },
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    }
  ]
}