{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteTags",
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Allow",
      "Action": "guardduty:CreateDetector",
      "Resource": "arn:aws:s3:::bucket-46/file-8.txt",
      "Condition": {
        "StringNotEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "config:DescribeConfigRules",
      "Resource": "arn:aws:s3:::bucket-12/file-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "workspaces:RebootWorkspaces",
      "Resource": "arn:aws:s3:::bucket-20/file-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-0/table-22",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Effect": "Deny",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Effect": "Allow",
      "Action": "guardduty:CreateIPSet",
      "Resource": "arn:aws:s3:::bucket-9/file-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "ses:DeleteIdentity",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-16/table-14",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/instance-id": "i-0123456789abcdef0"
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    }
  ]
}