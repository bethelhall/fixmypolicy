{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeniedDynamoDBActions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      }
    },
    {
      "Sid": "AllowedAthenaQueriesOnGlueTablesInUsEast1Only",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-10/table-13",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DeniedRDSOperationsWithNamespaceConstraint",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      }
    },
    {
      "Sid": "DeniedAccessToAdminRoleViaCrossAccount",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetDashboard"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      }
    },
    {
      "Sid": "AllowedIAMUsersDeletionByAdminsAndServiceRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      },
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/admin-role",
          "arn:aws:iam::123456789012:role/service-role"
        ]
      }
    },
    {
      "Sid": "AllowsPuttingBucketsTagsFromCertainRegions",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::bucket-10/file-1.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DisallowsCreatingNewLogsGroupsForNonWhitelistedIPAddresses",
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:s3:::bucket-11/file-9.txt",
      "Condition": {
        "NotIpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      }
    },
    {
      "Sid": "AllowsStartingPipelinesExecutionsBasedOnClientIP",
      "Effect": "Allow",
      "Action": [
        "codepipeline:StartPipelineExecution"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-16/table-10",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      }
    }
  ]
}