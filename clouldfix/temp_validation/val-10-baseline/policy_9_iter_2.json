{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAliceToDescribeLogStreams",
      "Effect": "Allow",
      "Action": "logs:DescribeLogStreams",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-4/table-4",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyAdminRoleToCreateLambdaFunction",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "76.76.21.0/24",
            "85.224.0.0/13"
          ]
        }
      }
    },
    {
      "Sid": "DenyTestUserToCreateDBInstance",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "76.76.21.0/24",
            "85.224.0.0/13"
          ]
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToRebootWorkspaces",
      "Effect": "Allow",
      "Action": "workspaces:RebootWorkspaces",
      "Resource": "arn:aws:s3:::bucket-16/file-1.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowBobToUpdateLambdaFunctionCode",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-58",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowBobToCreateGlueDatabase",
      "Effect": "Allow",
      "Action": "glue:CreateDatabase",
      "Resource": "arn:aws:s3:::bucket-17/file-1.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "192.168.1.0/24"
        }
      }
    },
    {
      "Sid": "DenyTempUserToDescribeInstances",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "76.76.21.0/24",
            "85.224.0.0/13"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnauthorizedToPutItem",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "76.76.21.0/24",
            "85.224.0.0/13"
          ]
        }
      }
    }
  ]
}