{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAliceEC2OperationsOnSpecificFileInBucketAndOnlyForHerIP",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:s3:::bucket-44/file-4.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        },
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowBobCloudWatchDeletionOfHisDashboard",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteDashboards"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-6/table-9",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ServiceRoleDetachingVolumesAllowed",
      "Effect": "Allow",
      "Action": [
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-1/table-3",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "PreventDavidDescribingInstancesWithNoPB",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "ARN of the PB"
        }
      },
      "Principal": "arn:aws:iam::111222333444:user/david"
    },
    {
      "Sid": "DeniesendmessagewithnoPB",
      "Effect": "Deny",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "ARN of the PB"
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "AllowsortinganddeletingasgforBob",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DeleteAutoScalingGroup"
      ],
      "Resource": "arn:aws:s3:::bucket-16/file-4.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "PreventsCrossaccoundeleteofinstancewitnoutPB",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "ARN of the PB"
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    },
    {
      "Sid": "allowsAthenaQueriesonGlueTablesfromWestUSonly",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryResults"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-14/table-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "preventDynamoDBdeleteitemwithoutPB",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "ARN of the PB"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Sid": "AllowUserScaningTableinUsWest2",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-8/table-23",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}