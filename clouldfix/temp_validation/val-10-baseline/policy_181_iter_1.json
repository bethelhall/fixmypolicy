{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSKafkaResourcePolicy",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::{ourAccountId}:root",
        "Service": "kafka.amazonaws.com"
      },
      "Action": [
        "secretsmanager:getSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345"
    },
    {
      "Sid": "DenySQSReceiptForSpecificSecretsAndDepartments",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345-forbidden-resource",
      "Principal": "kafka.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AuthorizedCodeCommitAccessToCertainSecret",
      "Effect": "Allow",
      "Action": "codecommit:ListRepositories",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "RootUserAccessToModifyBucketsInCertainRegions",
      "Effect": "Allow",
      "Action": "s3:PutBucketCors",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::469301550192:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "RestrictedIAMActionsOnSecretsManagerResources",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::{ourAccountId}:root",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": true
        }
      }
    },
    {
      "Sid": "LimitedSESaccessOnlyFromSpecifiedUsers",
      "Effect": "Allow",
      "Action": "ses:GetIdentityVerificationAttributes",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowedLambdaCreationByCertainPrincipals",
      "Effect": "Allow",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::532917545308:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "NoDeletionOfImportantUsers",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "PreventUnwantedDatabaseCreations",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:secretsmanager:eu-central-1:{mskAccId}:secret:AmazonMSK_eos-datapipeline-ads-all-prod-12345",
      "Principal": "arn:aws:iam::{ourAccountId}:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}