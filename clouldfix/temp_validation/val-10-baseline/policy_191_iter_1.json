{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "es:*"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/*",
      "Sid": "statement1"
    },
    {
      "Sid": "sid2",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "sid3",
      "Effect": "Allow",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-49-11.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "sid4",
      "Effect": "Allow",
      "Action": "sqs:ListQueueTags",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-2-13.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "sid5",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/*/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "sid6",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-33-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "sid7",
      "Effect": "Allow",
      "Action": "s3:PutObjectAcl",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-46-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "sid8",
      "Effect": "Allow",
      "Action": "kms:ListKeys",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-5-8.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "sid9",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/file-47-17.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "sid10",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "sid11",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:sts::xxxxxxxxxxxx:assumed-role/domain/*-specific",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}