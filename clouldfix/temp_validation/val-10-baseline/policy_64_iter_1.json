{
  "Version": "2012-10-17",
  "Id": "Policy1706347165594",
  "Statement": [
    {
      "Sid": "Stmt1706347164281",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/forbidden-role",
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:s3:::<bucket-name>/file-29-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1706347164282",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "glue:StartJobRun",
      "Resource": "arn:aws:s3:::<bucket-name>/file-36-3.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Stmt1706347164283",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::<bucket-name>-forbidden/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1706347164284",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Stmt1706347164285",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:s3:::<bucket-name>/file-17-17.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1706347164286",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "workspaces:StartWorkspaces",
      "Resource": "arn:aws:s3:::<bucket-name>/file-11-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1706347164287",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "Stmt1706347164288",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Action": "guardduty:CreateIPSet",
      "Resource": "arn:aws:s3:::<bucket-name>/file-1-2.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1706347164289",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::different-<bucket-name>/file.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1706347164290",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:s3:::<bucket-name>/file-12-16.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}