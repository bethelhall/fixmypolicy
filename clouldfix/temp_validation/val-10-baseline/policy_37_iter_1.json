{
  "Version": "2012-10-17",
  "Id": "PolicyWithConditionsAndPrincipals",
  "Statement": [
    {
      "Sid": "DeniedDynamoDBDeletion",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "My Account ID"
          ]
        }
      }
    },
    {
      "Sid": "DeniedS3BucketWebsiteDeletion",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketWebsite",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceAccount": [
            "[My Account ID]"
          ]
        }
      }
    },
    {
      "Sid": "AllowedAthenaQueriesOnlyForAlice",
      "Effect": "Allow",
      "Action": "athena:StartQueryExecution",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-1-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control"
        }
      }
    },
    {
      "Sid": "AllowedGlueJobsAccessByRole",
      "Effect": "Allow",
      "Action": "glue:GetJobRun",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-35-15.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DeniedListingOfAllMyBuckets",
      "Effect": "Deny",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "arn:aws:s3:::[destination-bucket]-forbidden/file.txt",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "My Account ID"
          ]
        }
      }
    },
    {
      "Sid": "DeniedDeletingBucketCors",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketCors",
      "Resource": "arn:aws:s3:::different-[destination-bucket]/file.txt",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "My Account ID"
          ]
        }
      }
    },
    {
      "Sid": "AllowedListingOfAllMyBucketsForAlice",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-37-3.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringNotEquals": {
          "aws:SourceAccount": [
            "My Account ID"
          ]
        }
      }
    },
    {
      "Sid": "AllowedKMSGrantListingByBob",
      "Effect": "Allow",
      "Action": "kms:ListGrants",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-45-1.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      }
    },
    {
      "Sid": "AllowedKMSEncryptionAliasCreationByBob",
      "Effect": "Allow",
      "Action": "kms:CreateAlias",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-1-10.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringNotEquals": {
          "aws:SourceAccount": [
            "My Account ID"
          ]
        }
      }
    },
    {
      "Sid": "AllowedCloud9EnvDeletionByBob",
      "Effect": "Allow",
      "Action": "cloud9:DeleteEnvironment",
      "Resource": "arn:aws:s3:::[destination-bucket]/AWSLogs/[My Account ID]/file-26-17.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}