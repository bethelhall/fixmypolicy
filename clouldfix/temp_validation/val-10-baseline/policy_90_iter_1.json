{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocuFlowSID",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/*"
    },
    {
      "Sid": "AllowAliceToManageSpecificFilesInTheSameBucketAndOnlyFromCertainRegions",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketWebsite"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/file-21-16.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "PreventBobFromGettingPoliciesOfDifferentBucketsOrIPRange",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::different-<bucketname>/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AdminRoleCannotChangeWebSiteSettingsForAnyBucketNorBasedOnTags",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketWebsite"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/admin-role"
      }
    },
    {
      "Sid": "RestrictLambdaInvocationByMaxKeysConstraint",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/temp-user"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AlllowAliceToSeeDetailsAboutHerOwnResources",
      "Effect": "Allow",
      "Action": [
        "es:DescribeElasticsearchDomains"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/file-28-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "ServiceRolesCanHaveFullControlOverTheirOwnedResoucesButNotOutsideThese",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/file-39-17.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "NoOneShouldBeAbleToSetUpLogsIfTheyAreAlreadyThere",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketLogging"
      ],
      "Resource": "arn:aws:s3:::<bucketname>-forbidden/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/temp-user"
      }
    },
    {
      "Sid": "GiveSomePermissionsViaIAMRules",
      "Effect": "Allow",
      "Action": [
        "config:PutConfigRule"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/file-29-19.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    },
    {
      "Sid": "RemoveUserAbilityToModifyHisCredentials",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:s3:::<bucketname>/file-31-6.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      }
    }
  ]
}