{
  "Version": "2012-10-17",
  "Id": "PolicyForCloudFrontPrivateContent",
  "Statement": [
    {
      "Sid": "AccessToSpecificUserInCertainRegionOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "kms:CancelKeyDeletion",
      "Resource": "arn:aws:s3:::bucket-name/file-18-17.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyIAMActionsOnSpecifiedResourcesAndSources",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLogging",
        "ec2:RunInstances",
        "rds:CreateDBInstance",
        "iam:ListAttachedRolePolicies",
        "logs:CreateLogGroup",
        "ec2:DeleteSecurityGroup",
        "cloudwatch:ListMetrics",
        "codecommit:GetRepository",
        "s3:GetBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-0/file-0.txt",
        "arn:aws:s3:::bucket-name-forbidden/file.txt",
        "arn:aws:s3:::different-bucket-name/file.txt",
        "arn:aws:s3:::bucket-name/file-*",
        "arn:aws:s3:::completely-different-bucket/file.txt"
      ],
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/admin-role",
          "cloudfront.amazonaws.com",
          "arn:aws:iam::999888777666:user/unauthorized"
        ]
      },
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipalWithDifferentSourceArn",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket-name/*",
      "Condition": {
        "StringNotEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "CrossAccountAssumeRolePermissionFromAnotherAccount",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "sts:AssumeRole",
      "Resource": "*"
    },
    {
      "Sid": "TestRolePermissionsToListAttachedRolePolicies",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "*"
    }
  ]
}