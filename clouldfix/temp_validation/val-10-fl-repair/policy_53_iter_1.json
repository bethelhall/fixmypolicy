{
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-bucket*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectTagging",
      "Resource": "arn:aws:s3:::my-bucketresource-3-16",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": "cloudfront.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "cloudfront.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Allow",
      "Action": "glue:CreateDatabase",
      "Resource": "arn:aws:s3:::my-bucketresource-3-8",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Deny",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Principal": "cloudfront.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:s3:::my-bucketresource-18-12",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:s3:::my-bucketresource-0-1",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor9",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Principal": "cloudfront.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "VisualEditor10",
      "Effect": "Allow",
      "Action": "s3:GetObjectAcl",
      "Resource": "arn:aws:s3:::my-bucketresource-25-19",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor11",
      "Effect": "Allow",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:s3:::my-bucketresource-4-4",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}