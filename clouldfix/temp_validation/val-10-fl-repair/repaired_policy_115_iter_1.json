{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecureBucketPolicy0",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::east1-vcc-test",
        "arn:aws:s3:::east1-vcc-test/*"
      ]
    },
    {
      "Sid": "SecureBucketPolicy1",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowIAMUserCreation",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicyVersion",
        "iam:DeleteAccessKey",
        "iam:GetPolicy",
        "iam:AttachUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:DeletePolicy",
        "iam:DeleteUser",
        "iam:ListUserPolicies",
        "iam:CreateUser",
        "iam:TagUser",
        "iam:CreateAccessKey",
        "iam:CreatePolicy",
        "iam:ListPolicyVersions",
        "iam:GetUserPolicy",
        "iam:PutUserPolicy",
        "iam:ListAttachedUserPolicies",
        "iam:GetUser",
        "iam:CreatePolicyVersion",
        "iam:DetachUserPolicy",
        "iam:DeletePolicyVersion",
        "iam:ListAccessKeys",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::*:user/Veeam-*"
    },
    {
      "Sid": "allow_e6dcdcae_combo_2",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpoints",
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_58de3a43_combo_2",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "arn:aws:iot:us-east-1:123456789012:topic/${iot:ClientId}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
