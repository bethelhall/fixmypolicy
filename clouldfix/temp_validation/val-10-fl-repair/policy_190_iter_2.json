{
  "Version": "2012-10-17",
  "Id": "Policy1637840001466",
  "Statement": [
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::different-angular-upload-files-2023-2024/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "athena:CreateWorkGroup",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-27-5.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Deny",
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "iam:ListAttachedGroupPolicies",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-23-18.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "kms:CreateAlias",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-12-2.txt",
      "Principal": "arn:aws:iam::123456789012:role/forbidden-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-29-15.txt",
      "Principal": "arn:aws:iam::123456789012:role/forbidden-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "es:DescribeElasticsearchDomains",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-4-17.txt",
      "Principal": "arn:aws:iam::123456789012:role/forbidden-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Action": "kms:UpdateKeyDescription",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/file-28-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}