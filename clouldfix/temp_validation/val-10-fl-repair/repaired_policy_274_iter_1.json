{
  "Version": "2008-10-17",
  "Id": "Policy1408118342443",
  "Statement": [
    {
      "Sid": "Stmt1408118336209",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::owrvideos/*",
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "MY FIRST DOMAIN/*",
            " MY NEW DOMAIN/*"
          ]
        }
      }
    },
    {
      "Sid": "allow_e6dcdcae_combo_2",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpoints",
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_58de3a43_combo_2",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
