{
  "Version": "2012-10-17",
  "Id": "Cross-account account A to account B SNS, and Cloudwatch encryption key",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111222333:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "Allow use of the key in account a when account b calls",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111222333:root"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "444555666"
        }
      }
    },
    {
      "Sid": "AllowAccessThroughSNS",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowAccessThroughCloudwatch",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudwatch.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowUseOfKeyFor444555666",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::444555666:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "Allow use of the key in Account B when Account A calls",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::444555666:root"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "111222333"
        }
      }
    },
    {
      "Sid": "AllowSNSServiceForAccountB",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "AllowCloudwatchServiceForAccountB",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudwatch.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "allow_04f626cd",
      "Effect": "Allow",
      "Action": "cloudwatch:DeleteDashboards",
      "Resource": "arn:aws:s3:::bucket-6/file-7.txt",
      "Principal": "arn:aws:iam::837297855427:root",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "allow_a0656f10",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-13",
      "Principal": "arn:aws:iam::205804136229:root",
      "Condition": {
        "StringNotEquals": {
          "kms:CallerAccount": "111222333"
        }
      }
    },
    {
      "Sid": "deny_ed9e3da5",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "sns.amazonaws.com",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "deny_2e0b346b",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::111222333:root",
      "Condition": {
        "StringNotEquals": {
          "kms:CallerAccount": "111222333"
        }
      }
    },
    {
      "Sid": "deny_060ae36a",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::111222333:root",
      "Condition": {
        "StringNotEquals": {
          "kms:CallerAccount": "444555666"
        }
      }
    },
    {
      "Sid": "allow_cc5e08bf",
      "Effect": "Allow",
      "Action": "sagemaker:CreateModel",
      "Resource": "arn:aws:s3:::bucket-15/file-2.txt",
      "Principal": "arn:aws:iam::528277625333:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_a77e3770",
      "Effect": "Allow",
      "Action": "sns:CreateTopic",
      "Resource": "arn:aws:s3:::bucket-44/file-8.txt",
      "Principal": "arn:aws:iam::959179362309:root",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "deny_38b2e9c0",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::111222333:root",
      "Condition": {
        "StringNotEquals": {
          "kms:CallerAccount": "111222333"
        }
      }
    },
    {
      "Sid": "allow_76794a8e",
      "Effect": "Allow",
      "Action": "ses:ListIdentities",
      "Resource": "arn:aws:s3:::bucket-38/file-2.txt",
      "Principal": "arn:aws:iam::128780411674:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_40a4f4f3",
      "Effect": "Allow",
      "Action": "workspaces:CreateWorkspaces",
      "Resource": "arn:aws:s3:::bucket-12/file-4.txt",
      "Principal": "arn:aws:iam::438067052466:root",
      "Condition": {
        "StringNotEquals": {
          "kms:CallerAccount": "111222333"
        }
      }
    }
  ]
}