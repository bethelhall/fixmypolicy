{
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": "SNS:Publish",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic"
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": "cloudfront:ListDistributions",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DeleteLoadBalancer",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Allow",
      "Action": "ec2:DeleteTags",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Action": "codedeploy:ListDeployments",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic-forbidden-resource",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "authorized/arn:aws:sns:ap-southeast-1:406745342818:snowpipe_topic/file.txt",
      "Principal": "s3.amazonaws.com",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}