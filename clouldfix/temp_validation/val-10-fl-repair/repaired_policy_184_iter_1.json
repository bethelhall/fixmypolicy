{
  "Version": "2012-10-17",
  "Id": "auto-sns-1",
  "Statement": [
    {
      "Sid": "Allow access through SNS for all principals in the account that are authorized to use SNS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "xxxxxxxxxxxx",
          "kms:ViaService": "sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow direct access to key metadata to the account",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::xxxxxxxxxxxx:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:RevokeGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "allow_e6dcdcae_combo_2",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpoints",
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_58de3a43_combo_2",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "arn:aws:iot:us-east-1:123456789012:topic/${iot:ClientId}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_5de4e5f8_combo_2",
      "Effect": "Allow",
      "Action": "glue:UpdateTable",
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_f01118b0_combo_2",
      "Effect": "Allow",
      "Action": "iam:ListPolicies",
      "Resource": "arn:aws:iot:us-east-1:123456789012:topic/${iot:ClientId}",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_ceab9b2f_combo_2",
      "Effect": "Allow",
      "Action": "ses:GetIdentityVerificationAttributes",
      "Resource": "arn:aws:iot:us-east-1:123456789012:topic/${iot:ClientId}",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_3196ea81_combo_2",
      "Effect": "Allow",
      "Action": "ses:GetIdentityDkimAttributes",
      "Resource": "arn:aws:iot:us-east-1:123456789012:client/client1",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}