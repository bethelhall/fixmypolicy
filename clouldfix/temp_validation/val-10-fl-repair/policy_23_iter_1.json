        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Action": "glue:GetPartitions",
      "Resource": "arn:aws:sms-voice:us-east-2:{{accountB}}:phone-number/phone-abcdefabcdef",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::859634547654:root"
        ]
      },
