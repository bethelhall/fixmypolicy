{
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::{{accountA}}:root"
        ]
      },
      "Action": [
        "sms-voice:DescribePhoneNumbers",
        "sms-voice:SendTextMessage",
        "sms-voice:SendVoiceMessage"
      ],
      "Resource": "arn:aws:sms-voice:us-east-2:{{accountB}}:phone-number/phone-abcdefabcdef"
    },
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::918158873077:root"
        ]
      },
      "Action": "athena:CreateWorkGroup",
      "Resource": "arn:aws:sms-voice:us-east-2:{{accountB}}:phone-number/phone-abcdefabcdef",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::136627060758:root"
        ]
      },
