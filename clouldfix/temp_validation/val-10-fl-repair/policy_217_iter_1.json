{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": "ssm:*",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflow*"
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": "workspaces:DescribeWorkspaces",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-25-7",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "authorized/arn:aws:ssm:us-east-1:<account_id>:parameter/airflow*/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflow*-forbidden-resource",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Allow",
      "Action": "iam:GetUser",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-49-2",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Action": "athena:GetQueryExecution",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-47-16",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Allow",
      "Action": "workspaces:DeleteWorkspaces",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-10-16",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Allow",
      "Action": "redshift:CreateCluster",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-31-2",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor9",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "forbidden-arn:aws:ssm:us-east-1:<account_id>:parameter/airflow*-specific",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor10",
      "Effect": "Allow",
      "Action": "es:DeleteElasticsearchDomain",
      "Resource": "arn:aws:ssm:us-east-1:<account_id>:parameter/airflowresource-36-12",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}