{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "logs:PutLogEvents",
        "logs:CreateLogStream"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "Logs"
    },
    {
      "Action": "kms:DescribeKey",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-37/file-8.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "dynamodb:DeleteItem",
      "Effect": "Allow",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-40",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "kms:UpdateKeyDescription",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-17/file-7.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "sqs:ListQueueTags",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-27/file-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "dynamodb:DeleteItem",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Action": "iam:DeleteUser",
      "Effect": "Deny",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sagemaker:ListEndpointConfigs",
      "Effect": "Allow",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-17/table-13",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "ec2:ImportKeyPair",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-15/file-3.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}