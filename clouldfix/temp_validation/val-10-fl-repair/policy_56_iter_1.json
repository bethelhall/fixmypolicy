{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": "dynamodb:DeleteItem",
      "Resource": "authorized/arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*/file.txt",
      "Effect": "Deny",
      "Sid": "statement2",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Action": "kms:GenerateDataKey",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-14-12.txt",
      "Effect": "Allow",
      "Sid": "statement3",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-15-11.txt",
      "Effect": "Allow",
      "Sid": "statement4",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-46-14.txt",
      "Effect": "Allow",
      "Sid": "statement5",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*-forbidden-resource",
      "Effect": "Deny",
      "Sid": "statement6",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Action": "lambda:InvokeFunction",
      "Resource": "forbidden-arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*-specific",
      "Effect": "Deny",
      "Sid": "statement7",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-29-9.txt",
      "Effect": "Allow",
      "Sid": "statement8",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-36-14.txt",
      "Effect": "Allow",
      "Sid": "statement9",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Effect": "Deny",
      "Sid": "statement10",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Action": "sqs:ListQueues",
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-44-7.txt",
      "Effect": "Allow",
      "Sid": "statement11",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}