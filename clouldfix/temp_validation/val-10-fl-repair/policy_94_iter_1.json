{
  "Version": "2012-10-17",
  "Id": "example-ID",
  "Statement": [
    {
      "Sid": "Example SNS topic policy",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": [
        "SNS:Publish"
      ],
      "Resource": "SNS-topic-ARN",
      "StringEquals": {
        "aws:SourceAccount": "bucket-owner-account-id"
      }
    },
    {
      "Sid": "allow_f0f74420_combo_2",
      "Effect": "Allow",
      "Action": "glue:UpdateTable",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_1998f261_combo_2",
      "Effect": "Allow",
      "Action": "sagemaker:StopNotebookInstance",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_d70c3b6f_combo_2",
      "Effect": "Allow",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_7a7c4df3_combo_2",
      "Effect": "Allow",
      "Action": "iam:ListGroupsForUser",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_e83b47ad_combo_2",
      "Effect": "Allow",
      "Action": "ec2:ImportKeyPair",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_952fe94d_combo_2",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "SNS-topic-ARN",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}