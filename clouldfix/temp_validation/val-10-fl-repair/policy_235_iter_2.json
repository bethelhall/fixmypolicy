{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestrictVPCPeering",
      "Effect": "Deny",
      "Action": "ec2:CreateVpcPeeringConnection",
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalOrgPaths": "o-abcdef/r-1234/ou-1234-abc5678/"
        }
      }
    },
    {
      "Sid": "AllowElasticBeanstalkDeleteApplication",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DeleteApplication",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-52",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyEC2DescribeSecurityGroups",
      "Effect": "Deny",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalOrgPaths": "o-abcdef/r-1234/ou-1234-abc5678/"
        }
      },
      "Principal": "arn:aws:iam::111222333444:role/developer-role"
    },
    {
      "Sid": "AllowS3PutBucketLogging",
      "Effect": "Allow",
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::bucket-4/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowGlueCreateLogStream",
      "Effect": "Allow",
      "Action": "logs:CreateLogStream",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-19/table-1",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowGlueDetachVolume",
      "Effect": "Allow",
      "Action": "ec2:DetachVolume",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-11/table-17",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenyIamDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalOrgPaths": "o-abcdef/r-1234/ou-1234-abc5678/"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyEc2ModifyInstanceAttribute",
      "Effect": "Deny",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalOrgPaths": "o-abcdef/r-1234/ou-1234-abc5678/"
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "DenyEc2DetachVolume",
      "Effect": "Deny",
      "Action": "ec2:DetachVolume",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalOrgPaths": "o-abcdef/r-1234/ou-1234-abc5678/"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/test-role"
    },
    {
      "Sid": "AllowSesVerifyEmailIdentity",
      "Effect": "Allow",
      "Action": "ses:VerifyEmailIdentity",
      "Resource": "arn:aws:s3:::bucket-36/file-7.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowElasticBeanstalkDescribeApplications",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DescribeApplications",
      "Resource": "arn:aws:s3:::bucket-25/file-8.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}