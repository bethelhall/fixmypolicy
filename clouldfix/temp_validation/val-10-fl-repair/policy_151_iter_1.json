{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots"
      ],
      "Sid": "statement1"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/*"
      ],
      "Sid": "statement2"
    },
    {
      "Action": [
        "kms:ListGrants"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-1-0.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_5ec6b9de"
    },
    {
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-34-2.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_7e696147"
    },
    {
      "Action": [
        "iam:DeleteRole"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-10-12.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_9c9a4d0f"
    },
    {
      "Action": [
        "sagemaker:DeleteNotebookInstance"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-13-15.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "allow_2d4b2ef2"
    },
    {
      "Action": [
        "config:PutConfigRule"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-8-2.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_ec20655a"
    },
    {
      "Action": [
        "iam:PutRolePolicy"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots/file-11-1.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "allow_660db66c"
    },
    {
      "Action": [
        "s3:PutBucketLifecycle"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::different-yyyyy-opensearch-snapshots/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::111222333444:role/developer-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "deny_6eb533be"
    },
    {
      "Action": [
        "s3:ListObjectVersions"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::denied-bucket-0/file-0.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      },
      "Sid": "deny_68dfb1c6"
    },
    {
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::yyyyy-opensearch-snapshots-forbidden/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Sid": "deny_1d315589"
    },
    {
      "Action": [
        "s3:GetBucketLogging"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::completely-different-bucket/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::999888777666:user/unauthorized"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Sid": "deny_f0e4b62d"
    }
  ]
}