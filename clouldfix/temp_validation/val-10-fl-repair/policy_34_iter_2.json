{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucketname/*"
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}