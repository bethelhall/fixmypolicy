{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateInferenceComponent"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:xx:endpoint/*",
        "arn:aws:sagemaker:*:xx:inference-component/*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "iam:GetUser",
      "Resource": "arn:aws:sagemaker:*:xx:inference-component/file-5-9.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sagemaker:ListModels",
      "Resource": "forbidden-arn:aws:sagemaker:*:xx:endpoint/*-specific",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RevokeSecurityGroupIngress",
      "Resource": "arn:aws:sagemaker:*:xx:inference-component/file-9-2.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:DeleteDistribution",
      "Resource": "arn:aws:sagemaker:*:xx:inference-component/file-2-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "forbidden-arn:aws:sagemaker:*:xx:inference-component/*-specific",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateLoginProfile",
      "Resource": "arn:aws:sagemaker:*:xx:endpoint/file-38-10.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudsearch:DescribeDomains",
      "Resource": "arn:aws:sagemaker:*:xx:inference-component/file-28-5.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:sagemaker:*:xx:inference-component/*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "glue:UpdateDatabase",
      "Resource": "arn:aws:sagemaker:*:xx:endpoint/file-15-14.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:sagemaker:*:xx:endpoint/*-forbidden-resource",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}