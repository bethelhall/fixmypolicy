{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:Get*"
      ],
      "Resource": "arn:aws:s3:::Bucket-Name/*"
    },
    {
      "Sid": "DenyDescribeInstances",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenySendMessage",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::Bucket-Name-forbidden/file.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDescribeEndpoint",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeEndpoint",
      "Resource": "arn:aws:s3:::Bucket-Name/file-7-1.txt",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDecrypt",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:s3:::Bucket-Name/file-46-7.txt",
      "Principal": "arn:aws:iam::111222333444:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyDeletePolicy",
      "Effect": "Deny",
      "Action": "iam:DeletePolicy",
      "Resource": "arn:aws:s3:::Bucket-Name/file-8-14.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyDeleteItem",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSendRawEmail",
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": "arn:aws:s3:::Bucket-Name/file-17-4.txt",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGetTable",
      "Effect": "Allow",
      "Action": "glue:GetTable",
      "Resource": "arn:aws:s3:::Bucket-Name/file-13-8.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::different-Bucket-Name/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}