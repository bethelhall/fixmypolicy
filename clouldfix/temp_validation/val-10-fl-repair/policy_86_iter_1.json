{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:ListQueues",
        "sqs:SendMessage",
        "tag:GetResources",
        "iam:GetRole",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": "sqs:ChangeMessageVisibilityBatch",
      "Resource": "arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_aab752be"
    },
    {
      "Action": "kms:RevokeGrant",
      "Resource": "arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "allow_e06235bd"
    },
    {
      "Action": "logs:DescribeLogStreams",
      "Resource": "arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que",
