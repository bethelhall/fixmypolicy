      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "deny_235b97fe"
    },
    {
      "Action": "kms:RevokeGrant",
      "Resource": "arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que-forbidden-resource",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Sid": "deny_b6b8276b"
    },
    {
      "Action": "ec2:RunInstances",
      "Resource": "forbidden-arn:aws:sqs:us-east-1:<account_of_sqs(current_account)>:prisma-que-specific",
