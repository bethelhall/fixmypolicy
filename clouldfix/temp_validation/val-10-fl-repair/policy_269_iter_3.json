{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAppFlowDestinationActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:PutObjectAcl",
        "s3:PutObject",
        "s3:ListMultipartUploadParts",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketAcl",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/*",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp"
      ]
    },
    {
      "Sid": "AllowAppFlowSourceActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTorrent",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/*",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp"
      ]
    },
    {
      "Sid": "AllowAppFlowSourceActionsOnSpecificFiles",
      "Effect": "Allow",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTorrent",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-17-13.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-13-10.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-31-13.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-13-19.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-7-14.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-3-7.txt"
      ]
    },
    {
      "Sid": "DenyAppFlowSourceActionsOnForbiddenFiles",
      "Effect": "Deny",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTorrent",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-17-13.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-13-10.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-31-13.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-13-19.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-7-14.txt",
        "arn:aws:s3:::engagement-uat-sfmc-snowflake-dpp/file-3-7.txt"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyAppFlowSourceActionsOnDeniedBuckets",
      "Effect": "Deny",
      "Principal": {
        "Service": "appflow.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTorrent",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::different-engagement-uat-sfmc-snowflake-dpp/file.txt",
        "arn:aws:s3:::denied-bucket-0/file-0.txt"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}