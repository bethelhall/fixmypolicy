{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFullAccessToBucket",
      "Action": "s3:*",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::goldcoast-tvod",
        "arn:aws:s3:::goldcoast-tvod/*"
      ]
    },
    {
      "Sid": "AllowPutBucketWebsiteInUsEast1",
      "Action": "s3:PutBucketWebsite",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-7-4.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyRunInstancesInDeniedBucket",
      "Action": "ec2:RunInstances",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowDeleteDistributionInEuWest1",
      "Action": "cloudfront:DeleteDistribution",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-18-3.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyPublishInUsWest2",
      "Action": "sns:Publish",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::different-goldcoast-tvod/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowGetDashboardInUsWest2",
      "Action": "cloudwatch:GetDashboard",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-3-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowDescribeVolumesInUsWest2",
      "Action": "ec2:DescribeVolumes",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-42-3.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowPublishInEuWest1",
      "Action": "sns:Publish",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-45-17.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowModifyWorkspacePropertiesInUsWest2",
      "Action": "workspaces:ModifyWorkspaceProperties",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::goldcoast-tvod/file-10-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyCreateFunctionInEuWest1",
      "Action": "lambda:CreateFunction",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::goldcoast-tvod-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}