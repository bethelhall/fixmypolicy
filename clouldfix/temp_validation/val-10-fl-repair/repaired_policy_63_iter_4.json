{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:ca-central-1:xxxx:secret:yyyy",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
