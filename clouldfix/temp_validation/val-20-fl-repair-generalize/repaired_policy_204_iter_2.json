{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::aws-windows-downloads-us-east-1/*",
        "arn:aws:s3:::amazon-ssm-us-east-1/*",
        "arn:aws:s3:::amazon-ssm-packages-us-east-1/*",
        "arn:aws:s3:::us-east-1-birdwatcher-prod/*",
        "arn:aws:s3:::aws-ssm-document-attachments-us-east-1/*",
        "arn:aws:s3:::patch-baseline-snapshot-us-east-1/*",
        "arn:aws:s3:::aws-ssm-us-east-1/*",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/*"
      ],
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:CreateQueue",
      "Resource": [
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-0.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-1.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-2.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-3.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-4.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-5.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-6.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-7.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-8.txt",
        "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-1-9.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "guardduty:GetIPSet",
      "Resource": "arn:aws:s3:::us-east-1-birdwatcher-prod/file-22-7.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "codebuild:StopBuild",
      "Resource": "arn:aws:s3:::patch-baseline-snapshot-us-east-1/file-47-11.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "arn:aws:s3:::aws-ssm-document-attachments-us-east-1/file-10-12.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey",
      "Resource": "arn:aws:s3:::aws-patchmanager-macos-us-east-1/file-12-9.txt",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DescribeLoadBalancers",
      "Resource": "arn:aws:s3:::aws-windows-downloads-us-east-1/file-27-12.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::different-aws-patchmanager-macos-us-east-1/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketCors",
      "Resource": "arn:aws:s3:::different-amazon-ssm-us-east-1/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:s3:::different-aws-windows-downloads-us-east-1/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetObjectTagging",
      "Resource": "arn:aws:s3:::aws-ssm-us-east-1-forbidden/file.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}