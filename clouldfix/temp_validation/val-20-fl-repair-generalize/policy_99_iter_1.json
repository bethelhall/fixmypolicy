{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket-account-a/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "AllowCloudWatchPutMetricData",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "arn:aws:s3:::bucket-account-a/file-46-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowS3PutBucketLogging",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::bucket-account-a/file-37-*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "not-o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "AllowSqsDeleteMessage",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Action": "sqs:DeleteMessage",
      "Resource": "arn:aws:s3:::bucket-account-a/file-26-*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "not-o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "AllowSqsTagQueue",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:user/blocked-user",
      "Action": "sqs:TagQueue",
      "Resource": "arn:aws:s3:::bucket-account-a/file-38-*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "not-o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "AllowKmsReEncrypt",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::111222333444:user/temp-user",
      "Action": "kms:ReEncrypt",
      "Resource": "arn:aws:s3:::bucket-account-a/file-48-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEc2DescribeVolumes",
      "Effect": "Allow",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Action": "ec2:DescribeVolumes",
      "Resource": "arn:aws:s3:::bucket-account-a/file-10-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyS3GetObjectAcl",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Action": "s3:GetObjectAcl",
      "Resource": "arn:aws:s3:::different-bucket-account-a/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketWebsite",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "DenyS3GetBucketLogging",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Action": "s3:GetBucketLogging",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketLogging",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Action": "s3:PutBucketLogging",
      "Resource": "arn:aws:s3:::bucket-account-a-forbidden/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        }
      }
    }
  ]
}