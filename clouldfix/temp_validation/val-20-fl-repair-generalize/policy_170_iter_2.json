      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "dynamodb:PutItem",
      "Effect": "Deny",
      "Resource": "forbidden-arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>-specific",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Action": "lambda:CreateFunction",
      "Effect": "Deny",
      "Resource": "authorized/arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>/file.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "sns:Publish",
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Action": "iam:DeleteUser",
      "Effect": "Deny",
