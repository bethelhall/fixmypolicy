{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "kms:ReEncrypt*",
        "kms:GetKeyPolicy",
        "kms:GenerateDataKey*",
        "kms:Encrypt",
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:CreateGrant"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "KMSUsage"
    },
    {
      "Action": "ec2:CreateVolume",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "ses:SendRawEmail",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Action": "redshift:CreateCluster",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Action": "iam:AttachRolePolicy",
      "Effect": "Allow",
