{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalARN": "arn:aws:iam::<account-id>:role/aws-quicksight-service-role-manual"
        }
      }
    },
    {
      "Sid": "AllowListEndpointConfigs",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpointConfigs",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::111222333444:user/temp-user"
    },
    {
      "Sid": "AllowListDetectors",
      "Effect": "Allow",
      "Action": "guardduty:ListDetectors",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowChangeResourceRecordSets",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowDescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::123456789012:user/test-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowListEndpoints",
      "Effect": "Allow",
      "Action": "sagemaker:ListEndpoints",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowDescribeLoadBalancers",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DescribeLoadBalancers",
      "Resource": "arn:aws:s3:::<bucket-name>/*",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}