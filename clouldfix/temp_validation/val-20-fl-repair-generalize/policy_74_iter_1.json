{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSLogDeliveryAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::qa-nlb-lo",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "account-no"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:elasticloadbalancing:ap-south-1:account-no:*"
        }
      }
    },
    {
      "Sid": "AWSLogDeliveryWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::qa-nlb-lo/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "account-no",
          "s3:x-amz-acl": "bucket-owner-full-control"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:elasticloadbalancing:ap-south-1:account-no:*"
        }
      }
    },
    {
      "Sid": "AthenaAccess",
      "Effect": "Allow",
      "Action": "athena:StopQueryExecution",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-23-*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "not-bucket-owner-full-control"
        }
      }
    },
    {
      "Sid": "S3Access",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-49-*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "not-account-no"
        }
      }
    },
    {
      "Sid": "GlueAccess",
      "Effect": "Allow",
      "Action": "glue:GetPartitions",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-7-*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "SageMakerAccess",
      "Effect": "Allow",
      "Action": "sagemaker:CreateModel",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-5-*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "not-account-no"
        }
      }
    },
    {
      "Sid": "GlueAccess",
      "Effect": "Allow",
      "Action": "glue:GetCrawler",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-12-*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "not-account-no"
        }
      }
    },
    {
      "Sid": "IAMGroupAccess",
      "Effect": "Allow",
      "Action": "iam:ListGroupsForUser",
      "Resource": "arn:aws:s3:::qa-nlb-lo/file-0-*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "not-bucket-owner-full-control"
        }
      }
    }
  ]
}