{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement2"
    },
    {
      "Action": [
        "sqs:TagQueue"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-20-*",
      "Effect": "Allow",
      "Sid": "statement3"
    },
    {
      "Action": [
        "sagemaker:CreateEndpointConfig"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/file-25-*",
      "Effect": "Allow",
      "Sid": "statement4"
    },
    {
      "Action": [
        "codepipeline:StartPipelineExecution"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-6-*",
      "Effect": "Allow",
      "Sid": "statement5"
    },
    {
      "Action": [
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-14-*",
      "Effect": "Allow",
      "Sid": "statement6"
    },
    {
      "Action": [
        "s3:GetBucketCors"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/file-29-*",
      "Effect": "Allow",
      "Sid": "statement7"
    },
    {
      "Action": [
        "kms:ReEncrypt"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/file-27-*",
      "Effect": "Allow",
      "Sid": "statement8"
    },
    {
      "Action": [
        "kms:Encrypt"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*-specific",
      "Effect": "Deny",
      "Sid": "statement9"
    },
    {
      "Action": [
        "kms:ReEncrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*-specific",
      "Effect": "Deny",
      "Sid": "statement10"
    },
    {
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*-forbidden-resource",
      "Effect": "Deny",
      "Sid": "statement11"
    },
    {
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*-forbidden-resource",
      "Effect": "Deny",
      "Sid": "statement12"
    }
  ]
}