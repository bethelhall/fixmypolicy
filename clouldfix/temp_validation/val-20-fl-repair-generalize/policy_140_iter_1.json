{
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:key-pair/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:us-east-1::image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      }
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": "codedeploy:CreateDeployment",
      "Resource": "arn:aws:ec2:*:*:volume/file-24-18.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": "cloudtrail:CreateTrail",
      "Resource": "arn:aws:ec2:*:*:security-group/file-25-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-1::image/file-0-7.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Allow",
      "Action": "s3:PutObjectTagging",
      "Resource": "arn:aws:ec2:*:*:key-pair/file-44-18.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Allow",
      "Action": "sqs:UntagQueue",
      "Resource": "arn:aws:ec2:*:*:volume/file-33-6.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:ec2:*:*:volume/file-19-12.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Deny",
      "Action": "ec2:DescribeKeyPairs",
      "Resource": "arn:aws:ec2:*:*:key-pair/*-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Deny",
      "Action": "ec2:StartInstances",
      "Resource": "authorized/arn:aws:ec2:us-east-1::image/*/file.txt",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "VisualEditor9",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "forbidden-arn:aws:ec2:us-east-1::image/*-specific",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    },
    {
      "Sid": "VisualEditor10",
      "Effect": "Deny",
      "Action": "ec2:ImportKeyPair",
      "Resource": "arn:aws:ec2:us-east-1::image/*-forbidden-resource",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/temp-user"
    }
  ],
  "Version": "2012-10-17"
}