{
  "Statement": [
    {
      "Sid": "UpdateShadows",
      "Effect": "Allow",
      "Action": [
        "iot:UpdateThingShadow",
        "iot:ListNamedShadowsForThing",
        "iot:GetThingShadow"
      ],
      "Resource": "arn:aws:iot:[region]:[account]:thing/*"
    },
    {
      "Sid": "AllowGuardDuty",
      "Effect": "Allow",
      "Action": [
        "guardduty:CreateIPSet",
        "guardduty:GetDetector"
      ],
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowEC2",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowSageMaker",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeTrainingJob",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowSES",
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowGlue",
      "Effect": "Allow",
      "Action": "glue:GetPartitions",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenySNS",
      "Effect": "Deny",
      "Action": "sns:Publish",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyDynamoDB",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:iot:[region]:[account]:thing/*",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "DenyIAM",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "authorized/arn:aws:iot:[region]:[account]:thing/*/file.txt",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "DenyRDS",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}