{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOtherRegions",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "AllowSpecificRegions",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessageBatch",
        "iam:CreateAccessKey",
        "s3:DeleteBucketWebsite",
        "dynamodb:DeleteItem",
        "iam:DeleteUser",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-0",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-1",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-2",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-3",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-4",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-5",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-6",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-7",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-8",
        "arn:aws:glue:us-east-1:123456789012:table/db-2/table-9",
        "arn:aws:glue:us-east-1:123456789012:table/db-1/table-3",
        "arn:aws:s3:::bucket-31/file-6.txt",
        "arn:aws:s3:::bucket-40/file-2.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-61",
        "arn:aws:glue:us-east-1:123456789012:table/db-14/table-7"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "*"
    },
    {
      "Sid": "AllowSpecificRegionsForBob",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-40/file-2.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowSpecificRegionsForAlice",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketWebsite"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-31/file-6.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowSpecificRegionsForCharlie",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-61"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowSpecificRegionsForAliceAndCharlie",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-14/table-7"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyOtherRegionsForServiceRole",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyOtherRegionsForBlockedUser",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Sid": "DenyOtherRegionsForCharlie",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::987654321098:user/charlie"
    },
    {
      "Sid": "DenyOtherRegionsForCrossAccountRole",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    }
  ]
}