{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2DescribeInstances",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceConnectEndpoints"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Sid": "EC2InstanceConnect",
      "Action": [
        "ec2-instance-connect:SendSSHPublicKey",
        "ec2-instance-connect:OpenTunnel",
        "ec2-instance-connect:SendSerialConsoleSSHPublicKey",
        "ec2:CreateInstanceConnectEndpoint",
        "ec2:CreateNetworkInterface",
        "ec2:CreateTags",
        "iam:CreateServiceLinkedRole"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Sid": "SageMakerCreateTrainingJob",
      "Action": [
        "sagemaker:CreateTrainingJob"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-0",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-1",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-2",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-3",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-4",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-5",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-6",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-7",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-8",
        "arn:aws:glue:us-east-1:123456789012:table/db-3/table-9"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "S3DeleteBucketWebsite",
      "Action": [
        "s3:DeleteBucketWebsite"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-85",
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AthenaGetQueryExecution",
      "Action": [
        "athena:GetQueryExecution"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-38/file-2.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Route53ListHostedZones",
      "Action": [
        "route53:ListHostedZones"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-31/file-6.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "SageMakerDescribeModel",
      "Action": [
        "sagemaker:DescribeModel"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::bucket-45/file-5.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "SageMakerStartNotebookInstance",
      "Action": [
        "sagemaker:StartNotebookInstance"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-6/table-7",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyEc2DeleteKeyPair",
      "Action": [
        "ec2:DeleteKeyPair"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyIamUpdateAccessKey",
      "Action": [
        "iam:UpdateAccessKey"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyIamCreateUser",
      "Action": [
        "iam:CreateUser"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::987654321098:user/charlie",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyIamListAccessKeys",
      "Action": [
        "iam:ListAccessKeys"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}