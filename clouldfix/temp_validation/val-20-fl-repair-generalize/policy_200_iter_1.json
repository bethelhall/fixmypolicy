{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::tmbile",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:DeleteObject",
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::tmbile/public/*",
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": "arn:aws:s3:::tmbile/public/file-38-*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "config:DeleteConfigRule",
      "Resource": "arn:aws:s3:::tmbile/public/file-44-11.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:CreateQueue",
      "Resource": "arn:aws:s3:::tmbile/public/file-27-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Allow",
      "Action": "workspaces:DescribeWorkspaces",
      "Resource": "arn:aws:s3:::tmbile/public/file-13-11.txt",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateAccessKey",
      "Resource": "arn:aws:s3:::tmbile/public/file-7-3.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AttachVolume",
      "Resource": "arn:aws:s3:::tmbile/public/file-1-14.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::tmbile-forbidden/file.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/test-user"
    },
    {
      "Effect": "Deny",
      "Action": "s3:DeleteBucketTagging",
      "Resource": "arn:aws:s3:::different-tmbile/file.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::completely-different-bucket/file.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/test-role"
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    }
  ]
}