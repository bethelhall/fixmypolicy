{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-14-*",
      "Effect": "Allow",
      "Sid": "statement2"
    },
    {
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-15-*",
      "Effect": "Allow",
      "Sid": "statement3"
    },
    {
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-46-*",
      "Effect": "Allow",
      "Sid": "statement4"
    },
    {
      "Action": [
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-29-*",
      "Effect": "Allow",
      "Sid": "statement5"
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-36-*",
      "Effect": "Allow",
      "Sid": "statement6"
    },
    {
      "Action": [
        "sqs:ListQueues"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/file-44-*",
      "Effect": "Allow",
      "Sid": "statement7"
    },
    {
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "authorized/arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*/file.txt",
      "Effect": "Deny",
      "Sid": "statement8"
    },
    {
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*-forbidden-resource",
      "Effect": "Deny",
      "Sid": "statement9"
    },
    {
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "forbidden-arn:aws:secretsmanager:eu-west-2:#NUMBER#:secret:aws/transfer/*-specific",
      "Effect": "Deny",
      "Sid": "statement10"
    },
    {
      "Action": [
        "sqs:ReceiveMessage"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Effect": "Deny",
      "Sid": "statement11"
    }
  ]
}