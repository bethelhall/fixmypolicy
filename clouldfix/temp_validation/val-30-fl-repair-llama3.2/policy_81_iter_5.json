{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "1",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:TagResource",
        "bedrock:UntagResource",
        "bedrock:ListTagsForResource",
        "bedrock:CreateModelInvocationJob",
        "bedrock:GetModelInvocationJob",
        "bedrock:ListModelInvocationJobs",
        "bedrock:StopModelInvocationJob",
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "2",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "elasticloadbalancing:DescribeLoadBalancers",
        "glue:GetCrawlers",
        "ec2:RevokeSecurityGroupIngress",
        "iam:CreateAccessKey",
        "iam:CreateRole",
        "iam:ListAttachedUserPolicies",
        "iam:GetAccessKeyLastUsed",
        "logs:CreateLogStream",
        "glue:GetDatabase",
        "codebuild:BatchGetBuilds",
        "s3:DeleteBucketCors",
        "iam:CreateUser"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "3",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketTagging",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:DeleteBucketTagging",
        "s3:GetBucketAcl",
        "s3:PutBucketAcl",
        "s3:DeleteBucketAcl",
        "s3:RestoreObject",
        "s3:DeleteObject",
        "s3:ListBucketVersions",
        "s3:ListBucket"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "4",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "s3:DeleteBucketWebsite",
        "iam:CreateUser",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl",
        "s3:DeleteObjectAcl",
        "iam:DeleteRole",
        "lambda:CreateFunction",
        "s3:DeleteBucketCors",
        "s3:ListBucketVersions",
        "s3:ListBucket"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "5",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "6",
      "Effect": "Allow",
      "Action": [
        "glue:GetCrawlers"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "7",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "8",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "9",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "10",
      "Effect": "Allow",
      "Action": [
        "iam:ListAttachedUserPolicies"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "11",
      "Effect": "Allow",
      "Action": [
        "iam:GetAccessKeyLastUsed"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "12",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketCors"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "13",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectAcl"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "14",
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "15",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectAcl"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "16",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketTagging",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:DeleteBucketTagging",
        "s3:GetBucketAcl",
        "s3:PutBucketAcl",
        "s3:DeleteBucketAcl",
        "s3:RestoreObject",
        "s3:DeleteObject",
        "s3:ListBucketVersions",
        "s3:ListBucket"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "17",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "s3:DeleteBucketWebsite",
        "iam:CreateUser",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl",
        "s3:DeleteObjectAcl",
        "iam:DeleteRole",
        "lambda:CreateFunction",
        "s3:DeleteBucketCors",
        "s3:ListBucketVersions",
        "s3:ListBucket"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    }
  ]
}