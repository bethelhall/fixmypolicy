      "Effect": "Allow",
      "Action": [
        "kms:EnableKey"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/file-30-16.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
