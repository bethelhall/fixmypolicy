      "Sid": "CrossRegionInference",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel*"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:814089719562:inference-profile/*"
      ]
    },
    {
