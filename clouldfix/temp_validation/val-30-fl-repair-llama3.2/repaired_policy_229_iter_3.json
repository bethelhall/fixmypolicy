{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "deny_lambda_invoke",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:kafka:us-west-2:12ditAWSID:cluster/demo-cluster-1/*/file.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/admin-role"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "deny_sqs_receive_message",
      "Effect": "Deny",
      "Action": [
        "sqs:ReceiveMessage"
      ],
