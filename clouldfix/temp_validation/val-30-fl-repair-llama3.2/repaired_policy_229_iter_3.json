      ],
      "Principal": [
        "arn:aws:iam::987654321098:user/charlie"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_sqs_send_message",
      "Effect": "Deny",
