{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "kms:ReEncrypt*",
        "kms:GetKeyPolicy",
        "kms:GenerateDataKey*",
        "kms:Encrypt",
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:CreateGrant"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "KMSUsage"
    },
    {
      "Action": [
        "iam:CreateUser",
        "iam:DeleteGroup",
        "iam:DeleteUser"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "IAMAccess"
    },
    {
      "Action": [
        "glue:DeleteTable",
        "glue:StartCrawler"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "GlueAccess"
    },
    {
      "Action": [
        "s3:DeleteBucket",
        "s3:GetObjectTagging",
        "s3:DeleteBucketCors"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "S3Access"
    },
    {
      "Action": [
        "cloud9:DeleteEnvironment",
        "cloudformation:DescribeStacks"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "CloudFormationAccess"
    },
    {
      "Action": [
        "athena:GetWorkGroup"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "AthenaAccess"
    },
    {
      "Action": [
        "workspaces:RebootWorkspaces"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "WorkSpacesAccess"
    },
    {
      "Action": [
        "ec2:DeleteTags"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "EC2Access"
    },
    {
      "Action": [
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "RDSAccess"
    },
    {
      "Action": [
        "ec2:DescribeInstances",
        "ec2:RunInstances"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "EC2Access"
    },
    {
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "SQSServiceAccess"
    },
    {
      "Action": [
        "lambda:CreateFunction",
        "sns:Subscribe"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "LambdaServiceAccess"
    },
    {
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "DynamoDBAccess"
    },
    {
      "Action": [
        "cloudtrail:StartLogging"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "CloudTrailAccess"
    },
    {
      "Action": [
        "sagemaker:ListTrainingJobs"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:kms:us-east-1:<account id>:key/<key for bucketA>",
      "Sid": "SageMakerAccess"
    },
    {
      "Action": [
        "securetransport:CheckServerIdentity",
        "securetransport:VerifyServerIdentity"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "SecureTransportAccess"
    },
    {
      "Action": [
        "iam:AssumeRole",
        "iam:PassRole"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "IAMAssumeRoleAccess"
    },
    {
      "Action": [
        "sts:AssumeStadiumRole"
      ],
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "STSAccess"
    }
  ]
}