{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetAccelerateConfiguration",
        "s3:PutAccelerateConfiguration",
        "ses:DeleteIdentity",
        "logs:PutLogEvents",
        "kms:Encrypt",
        "cloudfront:ListDistributions",
        "glue:UpdateTable",
        "sns:DeleteTopic",
        "workspaces:StopWorkspaces",
        "athena:GetDatabase",
        "s3:DeleteObjectTagging",
        "iam:PutRolePolicy",
        "sqs:CreateQueue"
      ],
      "Resource": [
        "arn:aws:s3:::<our_bucket_name>/*",
        "arn:aws:s3:::<our_bucket_name>",
        "arn:aws:ses:::/*",
        "arn:aws:logs:::/*",
        "arn:aws:kms:::/*",
        "arn:aws:cloudfront:::/*",
        "arn:aws:glue:::/*",
        "arn:aws:sns:::/*",
        "arn:aws:workspaces:::/*",
        "arn:aws:athena:::/*",
        "arn:aws:s3:::/*",
        "arn:aws:iam:::/*"
      ]
    }
  ]
}