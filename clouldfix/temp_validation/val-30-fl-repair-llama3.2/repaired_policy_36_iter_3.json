{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Allow API Access All",
      "Effect": "Allow",
      "Action": "aoss:APIAccessAll",
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "Allow Dashboards Access All",
      "Effect": "Allow",
      "Action": "aoss:DashboardsAccessAll",
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "Allow S3 Delete Object",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow EC2 Modify Instance Attribute",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow SQS Change Message Visibility Batch",
      "Effect": "Allow",
      "Action": "sqs:ChangeMessageVisibilityBatch",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow SNS Publish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Allow CloudTrail Start Logging",
      "Effect": "Allow",
      "Action": "cloudtrail:StartLogging",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow Lambda Delete Function",
      "Effect": "Allow",
      "Action": "lambda:DeleteFunction",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow DynamoDB Delete Item",
      "Effect": "Allow",
      "Action": "dynamodb:DeleteItem",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Allow RDS Delete DB Instance",
      "Effect": "Allow",
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": false
        }
      }
    },
    {
      "Sid": "Allow RDS Create DB Instance",
      "Effect": "Allow",
      "Action": "rds:CreateDBInstance",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Allow IAM List Policies",
      "Effect": "Allow",
      "Action": "iam:ListPolicies",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Deny SNS Subscribe",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Deny IAM CreateUser",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Deny EC2 Run Instances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Deny Lambda Invoke Function",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "NumericLessThan": {
          "s3:maxKeys": 10
        }
      }
    },
    {
      "Sid": "Deny EC2 Describe Instances",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "Deny SQS Receive Message",
      "Effect": "Deny",
      "Action": "sqs:ReceiveMessage",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Deny SQS SendMessage",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Deny RDS Delete DB Instance (Secure Transport)",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": true
        }
      }
    },
    {
      "Sid": "Deny RDS Create DB Instance (Finance Department)",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Deny DynamoDB Delete Item (IP Address)",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}