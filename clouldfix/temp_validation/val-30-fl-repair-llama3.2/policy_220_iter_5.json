{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "lambda:CreateFunction",
        "lambda:InvokeAsync",
        "lambda:InvokeFunction",
        "iam:PassRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "cloud9:DescribeEnvironments",
        "s3:RestoreObject",
        "athena:GetWorkGroup",
        "cloudtrail:StopLogging",
        "s3:PutBucketTagging",
        "config:DescribeConfigRules",
        "kms:RevokeGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Deny",
      "Action": [
        "iam:AttachUserPolicy",
        "iam:CreateLoginProfile",
        "iam:ListRoles",
        "iam:DeleteLoginProfile",
        "iam:ListAccessKeys",
        "iam:DeleteGroup",
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:CreateUser"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "StringLike": {
          "aws:userid": "AIDAI"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}