{
  "Version": "2012-10-17",
  "Id": "Cross-account account A to account B SNS, and Cloudwatch encryption key",
  "Statement": [
    {
      "Sid": "Allow access for AWS services",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111222333:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "Allow access for SNS service",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "Allow access for CloudWatch service",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudwatch.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "Allow access for specific AWS accounts",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111222333:root"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "Allow access for specific AWS accounts (reverse)",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::444555666:root"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "Allow access for SNS service (reverse)",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "111222333",
            "444555666"
          ]
        }
      }
    },
    {
      "Sid": "Allow access for CloudWatch service (reverse)",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudwatch.amazonaws.com"
      },
