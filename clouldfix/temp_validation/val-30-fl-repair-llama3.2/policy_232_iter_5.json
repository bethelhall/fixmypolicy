{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Allow SMS Voice API Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "sms-voice:SendTextMessage",
        "sms-voice:SendVoiceMessage",
        "sms-voice:SendMediaMessage",
        "sms-voice:DescribeSenderIds"
      ],
      "Resource": "arn:aws:sms-voice:Region:A-ID:sender-id/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow Lambda Function Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "lambda:InvokeFunction",
        "lambda:CreateFunction",
        "lambda:DeleteFunction"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow SQS Queue Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow DynamoDB Table Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow EC2 Instance Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow CloudFront Distribution Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::561171820183:root"
      },
      "Action": [
        "cloudfront:ListDistributions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow S3 Bucket Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "s3:GetBucketLocation",
        "s3:PutObject",
        "s3:DeleteBucketCors"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow CloudSearch Domain Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": [
        "cloudsearch:DeleteDomain"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow IAM User Policy Attachments",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::632180862570:root"
      },
      "Action": [
        "iam:AttachUserPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow SES Identity Deletion",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::411961919111:root"
      },
      "Action": [
        "ses:DeleteIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow KMS Key Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "kms:CreateKey",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow WorkSpaces Creation",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "workspaces:CreateWorkspaces"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow CloudWatch Dashboard Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": [
        "cloudwatch:PutDashboard"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow S3 Bucket CORS Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "s3:DeleteBucketCors"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow CloudFormation Stack Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::148416912233:root"
      },
      "Action": [
        "cloudformation:CreateStack"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow RDS DB Instance Operations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    },
    {
      "Sid": "Allow SMS Voice API Operations for Specific Region",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::B-ID:root"
      },
      "Action": [
        "sms-voice:SendTextMessage",
        "sms-voice:SendVoiceMessage",
        "sms-voice:SendMediaMessage",
        "sms-voice:DescribeSenderIds"
      ],
      "Resource": "arn:aws:sms-voice:Region=A-ID:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "Region=A-ID"
        }
      }
    }
  ]
}