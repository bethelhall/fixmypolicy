      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "data/partner_2/*"
          ]
        }
      },
      "Principal": "arn:aws:iam::999888777666:user/unauthorized"
    },
    {
      "Sid": "DenyEC2StartInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": null
