{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListDirectories",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::<my-bucket>"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "data/partner_2/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyMkdir",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": null
    },
    {
      "Sid": "DenyListFilesInSubDirectory",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "data/partner_2/data/incoming/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowReadWirteInSubDirectory",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionAcl",
        "s3:PutObjectVersionTagging"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/data/partner_2/data/incoming/*",
      "Condition": null
    },
    {
      "Sid": "AllowOnlyReadInADifferentDirectory",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/data/partner_2/data/outgoing/*",
      "Condition": null
    },
    {
      "Sid": "AllowEC2CreateVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowRoute53GetHostedZone",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowAutoscalingCreateAutoScalingGroup",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowCloudFrontDeleteDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteDistribution"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowEC2ModifyInstanceAttribute",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowS3DeleteBucketLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketLifecycle"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowSagemakerListNotebookInstances",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListNotebookInstances"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowIAMCreateUser",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowEC2StartInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowGlueStartCrawler",
      "Effect": "Allow",
      "Action": [
        "glue:StartCrawler"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowCloudWatchDeleteDashboards",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteDashboards"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowS3ListObjectVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListObjectVersions"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyRDSCreateDBInstance",
