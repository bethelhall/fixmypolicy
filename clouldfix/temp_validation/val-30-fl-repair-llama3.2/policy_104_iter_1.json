    {
      "Sid": "DenyEC2DeleteVolume",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": null
    },
    {
      "Sid": "DenyGlueStartCrawler",
      "Effect": "Deny",
      "Action": [
        "glue:StartCrawler"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": null
    },
    {
      "Sid": "DenyCloudWatchDeleteDashboards",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:DeleteDashboards"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": null
    },
    {
      "Sid": "DenyS3ListObjectVersions",
      "Effect": "Deny",
      "Action": [
