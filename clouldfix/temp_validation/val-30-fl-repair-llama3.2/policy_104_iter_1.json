    {
      "Sid": "DenyS3DeleteBucketLifecycle",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucketLifecycle"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenySagemakerListNotebookInstances",
      "Effect": "Deny",
      "Action": [
        "sagemaker:ListNotebookInstances"
      ],
      "Resource": "arn:aws:s3:::<my-bucket>/*/",
      "Condition": null
