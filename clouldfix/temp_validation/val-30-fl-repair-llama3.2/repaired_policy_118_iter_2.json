{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCodeBuildServiceRoleAccessToS3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::[account A]:role/service-role/codebuild-service-role-foo-bar"
      },
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:s3:::mytestbucket/*"
        }
      }
    },
    {
      "Sid": "AllowAliceAccessToMyTestBucket",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Resource": [
        "arn:aws:s3:::mytestbucket/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowAliceAccessToMyTestBucketForOtherActions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyFinanceDepartmentAccess",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[account A]:role/service-role/codebuild-service-role-foo-bar"
      },
      "Resource": [
        "arn:aws:s3:::mytestbucket/*",
        "arn:aws:s3:::denied-bucket-0/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "DenyFinanceDepartmentAccessToSqs",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::[account A]:role/service-role/codebuild-service-role-foo-bar"
      },
      "Resource": [
        "arn:aws:s3:::mytestbucket-forbidden/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "AllowForbiddenCodebuildServiceRoleAccessToS3",
