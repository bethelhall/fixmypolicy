{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLambdaCrossAccountAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_A:role/lambda_execution_role"
      },
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::account_b_bucket_name",
        "arn:aws:s3:::account_b_bucket_name/*"
      ]
    },
    {
      "Sid": "AllowBedrockAccess",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::account_b_bucket_name/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "ACCOUNT_A"
        }
      }
    },
    {
      "Sid": "AllowS3AccessForAccountsAAndB",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_A:root"
      },
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::account_b_bucket_name",
        "arn:aws:s3:::account_b_bucket_name/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "ACCOUNT_A",
            "ACCOUNT_B"
          ]
        }
      }
    },
    {
      "Sid": "AllowEC2AccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "ec2:StartInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowSesAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::108399584563:role/lambda_execution_role"
      },
      "Action": [
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowSageMakerAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::108399584563:role/lambda_execution_role"
      },
      "Action": [
        "sagemaker:CreateEndpoint",
        "sagemaker:CreateNotebookInstance",
        "sagemaker:CreateTrainingJob",
        "sagemaker:DescribeTrainingJob",
        "sagemaker:ListModels",
        "sagemaker:GetPartitions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "AllowGuardDutyAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "guardduty:ListDetectors"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKMSAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::108399584563:role/lambda_execution_role"
      },
      "Action": [
        "kms:RetireGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowGlueAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::108399584563:role/lambda_execution_role"
      },
      "Action": [
        "glue:StartCrawler",
        "glue:GetPartitions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowIamAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": [
        "iam:ListRoles"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowRedshiftAccessForAlice",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::108399584563:role/lambda_execution_role"
      },
      "Action": [
        "redshift:DeleteCluster"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowDynamoDBAccessForAccountsAAndB",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_A:root"
      },
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:::denied-bucket-3",
        "arn:aws:dynamodb:::denied-bucket-6"
      ],
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": [
            "ACCOUNT_A",
            "ACCOUNT_B"
          ]
        }
      }
    },
    {
      "Sid": "DenyLambdaAccessToAccountsA",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_A:root"
      },
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "ACCOUNT_A"
        }
      }
    },
    {
      "Sid": "DenySNSAccessToAccountsA",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_A:root"
      },
      "Action": [
        "sns:Publish",
        "sns:Subscribe"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "ACCOUNT_A"
        }
      }
    }
  ]
}