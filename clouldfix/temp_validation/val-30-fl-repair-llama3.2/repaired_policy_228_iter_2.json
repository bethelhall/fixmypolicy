{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-1-name/*",
        "arn:aws:s3:::bucket-2-name/*"
      ]
    },
    {
      "Sid": "allow_sqs_list_queues",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_cloudwatch_put_dashboard",
      "Effect": "Allow",
      "Action": "cloudwatch:PutDashboard",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_s3_put_bucket_cors",
      "Effect": "Allow",
      "Action": "s3:PutBucketCors",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_kms_create_key",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_glue_delete_table",
      "Effect": "Allow",
      "Action": "glue:DeleteTable",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_redshift_create_cluster",
      "Effect": "Allow",
      "Action": "redshift:CreateCluster",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_es_delete_elasticsearch_domain",
      "Effect": "Allow",
      "Action": "es:DeleteElasticsearchDomain",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_sagemaker_list_notebook_instances",
      "Effect": "Allow",
      "Action": "sagemaker:ListNotebookInstances",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_sqs_tag_queue",
      "Effect": "Allow",
      "Action": "sqs:TagQueue",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_workspaces_describe_workspaces",
      "Effect": "Allow",
      "Action": "workspaces:DescribeWorkspaces",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_workspaces_delete_workspaces",
      "Effect": "Allow",
      "Action": "workspaces:DeleteWorkspaces",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_codepipeline_start_pipeline_execution",
      "Effect": "Allow",
      "Action": "codepipeline:StartPipelineExecution",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_athena_create_workgroup",
      "Effect": "Allow",
      "Action": "athena:CreateWorkGroup",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_sagemaker_describe_training_job",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeTrainingJob",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_s3_get_bucket_location",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "*",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "deny_s3_get_bucket_versioning",
      "Effect": "Deny",
      "Action": "s3:GetBucketVersioning",
      "Resource": "*",
      "Principal": "arn:aws:iam::999888777666:user/unauthorized",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_rds_create_db_instance",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstance",
      "Resource": "*",
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_s3_delete_bucket_policy",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "*",
      "Principal": "arn:aws:iam::111222333444:user/david",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "deny_s3_put_bucket_lifecycle",
      "Effect": "Deny",
      "Action": "s3:PutBucketLifecycle",
      "Resource": "*",
      "Principal": "arn:aws:iam::111222333444:role/developer-role",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "deny_s3_get_object_tagging",
      "Effect": "Deny",
      "Action": "s3:GetObjectTagging",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}