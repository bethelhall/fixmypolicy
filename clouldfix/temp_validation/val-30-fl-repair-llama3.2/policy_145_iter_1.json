{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "lex:UpdateBot",
        "lex:GetBot",
        "lex:CreateSlot",
        "lex:CreateSlotType"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      }
    },
    {
      "Sid": "allow_cloudwatch_get_dashboard",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetDashboard"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_workspaces_stop_workspaces",
      "Effect": "Allow",
      "Action": [
        "workspaces:StopWorkspaces"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_kinesis_get_records",
      "Effect": "Allow",
      "Action": [
        "kinesis:GetRecords"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_kms_retire_grant",
      "Effect": "Allow",
      "Action": [
        "kms:RetireGrant"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_cloudwatch_get_metric_statistics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_codedeploy_list_deployments",
      "Effect": "Allow",
      "Action": [
        "codedeploy:ListDeployments"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_guardduty_delete_detector",
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteDetector"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_ses_get_identity_dkim_attributes",
      "Effect": "Allow",
      "Action": [
        "ses:GetIdentityDkimAttributes"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_codecommit_get_repository",
      "Effect": "Allow",
      "Action": [
        "codecommit:GetRepository"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_kms_create_grant",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_ec2_detach_volume",
      "Effect": "Allow",
      "Action": [
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_workspaces_describe_workspaces",
      "Effect": "Allow",
      "Action": [
        "workspaces:DescribeWorkspaces"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_sns_publish",
      "Effect": "Deny",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "deny_rds_delete_db_instance",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance"
      ],
      "Resource": "forbidden-arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG-specific",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "deny_ec2_run_instances",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-7/file-7.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "deny_lambda_create_function",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-5/file-5.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "deny_sqs_send_message",
      "Effect": "Deny",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "authorized/arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG/file.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_dynamodb_put_item",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-6/file-6.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_ec2_describe_instances",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_rds_create_db_instance",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "deny_sqs_receive_message",
      "Effect": "Deny",
      "Action": [
        "sqs:ReceiveMessage"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-8/file-8.txt",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_dynamodb_delete_item",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:lex:us-east-1:1234567890:bot/ABCDEFG-forbidden-resource",
      "Principal": {
        "AWS": "arn:aws:iam:1234567890:user/lastname.firstname"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    }
  ]
}