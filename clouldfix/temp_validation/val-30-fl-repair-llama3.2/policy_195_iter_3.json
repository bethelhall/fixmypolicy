{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowKafkaToGetSecrets",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "secretsmanager:getSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z"
    },
    {
      "Sid": "AllowKafkaToPutDynamoDBItems",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AllowKafkaToCreateLambdaFunctions",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowKafkaToReceiveSQSMessages",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-5/file-5.txt",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowKafkaToDeleteDynamoDBItems",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AllowKafkaToSubscribeToSNSTopic",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "AllowKafkaToDeleteUsers",
      "Effect": "Allow",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::denied-bucket-6/file-6.txt",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyKafkaToRunEC2Instances",
      "Effect": "Deny",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "DenyKafkaToPublishToSNSTopic",
      "Effect": "Deny",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-7/file-7.txt",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyKafkaToCreateUsers",
      "Effect": "Deny",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "iam:CreateUser",
      "Resource": "forbidden-arn:aws:secretsmanager:eu-west-3:...............Z-specific",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToStartCodeBuild",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "codebuild:StartBuild",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToUntagSQSQueue",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "sqs:UntagQueue",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyKafkaToSendSQSMessages",
      "Effect": "Deny",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToDescribeKinesisStreams",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "kinesis:DescribeStream",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToListSageMakerEndpoints",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "sagemaker:ListEndpoints",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToCreateLambdaFunctions",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToEnableKMSKeys",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "kms:EnableKey",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToGetIAMRolePolicies",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "iam:GetRolePolicy",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowServiceRoleToDeleteESDomains",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:role/service-role"
      },
      "Action": "es:DeleteElasticsearchDomain",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyKafkaToInvokeLambdaFunctions",
      "Effect": "Deny",
      "Principal": {
        "Service": "kafka.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z-forbidden-resource",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowBobToStartCloudTrail",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "cloudtrail:StartLogging",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAliceToDeleteAccessKeys",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "iam:DeleteAccessKey",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowBobToListKMSGrants",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "kms:ListGrants",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowBobToPutDynamoDBItems",
      "Effect": "Allow",
      "Principal": {
        "Service": "arn:aws:iam::123456789012:user/bob"
      },
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:secretsmanager:eu-west-3:...............Z",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}