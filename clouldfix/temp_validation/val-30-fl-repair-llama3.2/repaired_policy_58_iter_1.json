{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCodeCommitActions",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds",
        "codecommit:GitPull"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowDynamoDBActions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-39-7",
        "arn:aws:dynamodb:*:*:table/*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowIAMActions",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteAccessKey",
        "iam:CreateAccessKey"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-21-2",
        "arn:aws:iam::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKMSActions",
      "Effect": "Allow",
      "Action": [
        "kms:UpdateKeyDescription",
        "kms:CreateKey",
        "kms:RetireGrant"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-19-9",
        "arn:aws:kms:*:*:key/*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontActions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:cloudfront:*:*:distribution/*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLifecycle",
        "sqs:GetQueueUrl",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:s3::*:*",
        "arn:aws:sqs::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowGlueActions",
      "Effect": "Allow",
      "Action": [
        "glue:BatchGetJobs"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-34-14",
        "arn:aws:glue::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowEC2Actions",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:ec2::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowRDSActions",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:rds::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSQSActions",
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteMessage"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-41-13",
        "arn:aws:sqs::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowCrossAccountActions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowKMSActionsForCodeCommit",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncrypt",
        "kms:DescribeKey",
        "kms:ListKeys"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-39-7",
        "arn:aws:kms:*:*:key/*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowGlueActionsForCodeCommit",
      "Effect": "Allow",
      "Action": [
        "glue:BatchGetJobs"
      ],
      "Resource": [
        "arn:aws:codecommit:*:*:resource-34-14",
        "arn:aws:glue::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowEC2ActionsForCodeBuild",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:ec2::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowRDSActionsForCodeBuild",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/*",
        "arn:aws:rds::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSQSActionsForCodeBuild",
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteMessage"
      ],
      "Resource": [
        "arn:aws:codebuild:*:*:project/resource-41-13",
        "arn:aws:sqs::*:*"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActions",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActionsForCodeCommit",
      "Effect": "Deny",
      "Action": [
        "codecommit:CreateRepository",
        "codecommit:ListRepositories"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActionsForSQS",
      "Effect": "Deny",
      "Action": [
        "sqs:Subscribe",
        "sqs:DeleteMessage"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActionsForEC2",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeVolumes"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActionsForRDS",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActionsForSQS",
      "Effect": "Deny",
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-1/*",
        "arn:aws:s3:::denied-bucket-2/*"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:role/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}