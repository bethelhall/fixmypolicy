{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlarmAction",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "account_a"
        },
        "StringLike": {
          "AWS:SourceArn": "arn:aws:cloudwatch:us-east-1:account_a:alarm:canary alarm"
        }
      }
    },
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIAMDeleteGroup",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "iam:DeleteGroup",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "not-account_a"
        }
      }
    },
    {
      "Sid": "AllowKMSListGrants",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "kms:ListGrants",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowWorkspacesDescribeWorkspaces",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "workspaces:DescribeWorkspaces",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetDatabase",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "athena:GetDatabase",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3DeleteBucketPolicy",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "not-account_a"
        }
      }
    },
    {
      "Sid": "AllowSQSSendMessageBatch",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "sqs:SendMessageBatch",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowLogsGetLogEvents",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIAMListRoles",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "iam:ListRoles",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowElasticBeanstalkCreateApplication",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "elasticbeanstalk:CreateApplication",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowGlueStartJobRun",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "glue:StartJobRun",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "not-account_a"
        }
      }
    },
    {
      "Sid": "AllowS3PutBucketWebsite",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetWorkGroup",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "athena:GetWorkGroup",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEC2DescribeInstances",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "not-account_a"
        }
      }
    },
    {
      "Sid": "AllowGlueDeleteDatabase",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "glue:DeleteDatabase",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowEC2DescribeInstances",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowS3ListObjectVersions",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.alarms.cloudwatch.amazonaws.com"
      },
      "Action": "s3:ListObjectVersions",
      "Resource": "arn:aws:lambda:us-east-1:account_b:function:alarmActionLambda",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}