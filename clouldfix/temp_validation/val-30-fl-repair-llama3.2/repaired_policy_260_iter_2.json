      "Action": "redshift:CreateCluster",
      "Resource": "arn:aws:s3:::cik-front-end/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::339712767340:distribution/EQDQLH88I63IN"
        }
      }
    },
    {
      "Sid": "AllowIAMCreateRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "iam.amazonaws.com"
