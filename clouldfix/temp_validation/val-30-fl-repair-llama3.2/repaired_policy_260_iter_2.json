{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2CreateTags",
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:s3:::cik-front-end/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetQueryResults",
      "Effect": "Allow",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "athena:GetQueryResults",
      "Resource": "arn:aws:s3:::cik-front-end/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowCloudTrailGetTrailStatus",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "cloudtrail:GetTrailStatus",
      "Resource": "arn:aws:s3:::cik-front-end/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
