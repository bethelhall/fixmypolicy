{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "ecr:*",
        "logs:CreateLogStream",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:CreateLogGroup",
        "logs:PutLogEvents",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "sns:Publish"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "athena:DeleteWorkGroup",
        "cloudformation:UpdateStack",
        "cloudwatch:ListMetrics",
        "cloud9:DeleteEnvironment",
        "dynamodb:PutItem",
        "elasticloadbalancing:CreateLoadBalancer",
        "glue:GetDatabase",
        "guardduty:GetDetector",
        "iam:DeleteGroup",
        "iam:DeleteUser",
        "kinesis:PutRecord",
        "kms:EnableKey",
        "route53:ChangeResourceRecordSets",
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:ListBucket",
        "s3:PutBucketLifecycle",
        "s3:PutObject",
        "s3:RestoreObject",
        "s3:StoreObjectAcl",
        "ses:SendEmail",
        "sqs:SendMessage"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Deny",
      "Action": [
        "s3:GetObjectVersion",
        "s3:DeleteBucketTagging",
        "s3:DeleteBucketWebsite",
        "s3:GetBucketPolicy",
        "s3:StoreObjectAcl"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}