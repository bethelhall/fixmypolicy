{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketTagging",
        "s3:DeleteObject",
        "s3:GetBucketLifecycle",
        "s3:GetBucketWebsite",
        "s3:PutBucketLogging",
        "s3:PutBucketVersioning",
        "sqs:ListQueueTags",
        "sqs:SendMessageBatch",
        "sqs:ReceiveMessage",
        "ses:SendBulkEmail",
        "ses:SendEmail",
        "ses:SetIdentityDkimEnabled",
        "ses:DeleteIdentity",
        "sns:Publish",
        "config:DescribeConfigRules",
        "autoscaling:CreateAutoScalingGroup",
        "glue:BatchGetJobs",
        "guardduty:ListDetectors",
        "lambda:CreateFunction",
        "sagemaker:StartNotebookInstance",
        "codecommit:CreateRepository"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:ExistingObjectTag/Department": "Finance"
        },
        "StringLike": {
          "aws:userid": "AIDAI"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    }
  ]
}