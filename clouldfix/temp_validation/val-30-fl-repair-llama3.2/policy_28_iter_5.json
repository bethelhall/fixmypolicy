{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "sns:DeleteTopic",
        "ec2:DescribeKeyPairs",
        "athena:GetWorkGroup",
        "s3:GetBucketVersioning",
        "workspaces:StartWorkspaces",
        "cloudsearch:CreateDomain",
        "kms:ListGrants",
        "cloud9:DeleteEnvironment",
        "iam:RemoveUserFromGroup",
        "iam:DeleteGroup",
        "iam:CreateGroup",
        "ec2:ImportKeyPair",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "codepipeline:GetPipeline",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*",
        "arn:aws:sns:::my-sns-topic",
        "arn:aws:ec2:::*",
        "arn:aws:athena:::*",
        "arn:aws:s3:::my-bucket/file-42-15.txt",
        "arn:aws:s3:::my-bucket/file-28-13.txt",
        "arn:aws:s3:::my-bucket/file-30-15.txt",
        "arn:aws:s3:::my-bucket/file-32-1.txt",
        "arn:aws:s3:::my-bucket/file-11-14.txt",
        "arn:aws:s3:::my-bucket/file-37-4.txt",
        "arn:aws:s3:::my-bucket/file-0-16.txt",
        "arn:aws:s3:::my-bucket/file-21-15.txt",
        "arn:aws:s3:::my-bucket/file-3-0.txt",
        "arn:aws:s3:::my-bucket/file-0-7.txt",
        "arn:aws:s3:::my-bucket/file-40-9.txt",
        "arn:aws:s3:::my-bucket/file-45-11.txt",
        "arn:aws:s3:::my-bucket/file-33-1.txt",
        "arn:aws:s3:::my-bucket/file-11-12.txt",
        "arn:aws:s3:::my-bucket/file-18-1.txt",
        "arn:aws:s3:::my-bucket/file-48-18.txt",
        "arn:aws:s3:::my-bucket/file-18-10.txt",
        "arn:aws:kms:::*",
        "arn:aws:cloud9:::*",
        "arn:aws:iam:::*",
        "arn:aws:cloudsearch:::*",
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::555666777888:role/cross-account-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "sqs:SendMessage",
        "dynamodb:PutItem",
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:rds:::*",
        "arn:aws:sqs:::*",
        "arn:aws:dynamodb:::*",
        "arn:aws:lambda:::*",
        "arn:aws:s3:::denied-bucket-1",
        "arn:aws:s3:::denied-bucket-2",
        "arn:aws:s3:::denied-bucket-3",
        "arn:aws:s3:::denied-bucket-4",
        "arn:aws:s3:::denied-bucket-5",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::different-my-bucket"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:iam::111222333444:role/developer-role",
        "arn:aws:iam::555666777888:role/cross-account-role",
        "arn:aws:iam::123456789012:user/blocked-user",
        "arn:aws:iam::123456789012:user/temp-user",
        "arn:aws:iam::111222333444:user/david"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        },
        "NumericLessThan": {
          "s3:max-keys": "10"
        },
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}