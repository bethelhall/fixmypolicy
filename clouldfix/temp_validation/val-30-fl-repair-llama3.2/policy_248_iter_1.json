{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdministratorAccess",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "DenyKMSDecryptAccess",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:ListKeys",
        "kms:ListResourceTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyKMSScheduleDeletion",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyKMSListKeys",
      "Effect": "Deny",
      "Action": [
        "kms:ListKeys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyKMSListResourceTags",
      "Effect": "Deny",
      "Action": [
        "kms:ListResourceTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySNSPublish",
      "Effect": "Deny",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyRDSCreateDBInstance",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBDeleteItem",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyIAMDeleteUser",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
