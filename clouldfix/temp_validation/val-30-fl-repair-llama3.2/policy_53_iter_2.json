{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-bucket*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "AllowAutoscalingServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "autoscaling.amazonaws.com"
      },
      "Action": "autoscaling:CreateAutoScalingGroup",
      "Resource": "arn:aws:s3:::my-bucketresource-1-12",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIAMServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "iam.amazonaws.com"
      },
      "Action": "iam:RemoveUserFromGroup",
      "Resource": "arn:aws:s3:::my-bucketresource-28-3",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGlueServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "glue.amazonaws.com"
      },
      "Action": "glue:StartCrawler",
      "Resource": "arn:aws:s3:::my-bucketresource-20-19",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowLogsServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "logs.amazonaws.com"
      },
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:s3:::my-bucketresource-7-8",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowKinesisServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "kinesis.amazonaws.com"
      },
      "Action": "kinesis:PutRecord",
      "Resource": "arn:aws:s3:::my-bucketresource-5-10",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowSqsServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "sqs.amazonaws.com"
      },
      "Action": "sqs:ChangeMessageVisibilityBatch",
      "Resource": "arn:aws:s3:::my-bucketresource-22-13",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowEC2ServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::my-bucketresource-47-5",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "AllowCloudFormationServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudformation.amazonaws.com"
      },
      "Action": "cloudformation:UpdateStack",
      "Resource": "arn:aws:s3:::my-bucketresource-32-1",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyCloudFrontServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "dynamodb.amazonaws.com"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenySQSServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "sqs.amazonaws.com"
      },
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:s3:::denied-bucket-8/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyRDSServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "rds.amazonaws.com"
      },
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-1/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyS3ServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": "s3:PutBucketWebsite",
      "Resource": "arn:aws:s3:::denied-bucket-3/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyEC2ServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::denied-bucket-5/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::xxxxxxxx:distribution/distributionID"
        }
      }
    },
    {
      "Sid": "DenyAthenaServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "athena:GetQueryResults",
      "Resource": "arn:aws:s3:::denied-bucket-6/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenySNSServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "sns:DeleteTopic",
      "Resource": "arn:aws:s3:::denied-bucket-11/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyIAMServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "iam.amazonaws.com"
      },
      "Action": "iam:DeleteAccessKey",
      "Resource": "arn:aws:s3:::denied-bucket-10/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyKMSServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "kms.amazonaws.com"
      },
      "Action": "kms:ListAliases",
      "Resource": "arn:aws:s3:::denied-bucket-9/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyCloud9ServicePrincipal",
      "Effect": "Deny",
      "Principal": {
        "Service": "cloud9.amazonaws.com"
      },
      "Action": "cloud9:DeleteEnvironment",
      "Resource": "arn:aws:s3:::denied-bucket-7/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}