{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:<My-ID>:topic/$aws/certificates/create/*",
        "arn:aws:iot:us-east-1:<My-ID>:topic/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*"
      ],
      "Principal": "*"
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/certificates/create/*",
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*"
      ],
      "Principal": "*"
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup",
        "iam:GetGroup",
        "logs:CreateLogGroup",
        "ses:VerifyEmailIdentity",
        "cloudwatch:PutDashboard",
        "cloud9:CreateEnvironmentEC2",
        "cloud9:DeleteEnvironment",
        "dynamodb:Query",
        "glue:DeleteDatabase",
        "kms:ReEncrypt",
        "kms:ListKeys",
        "redshift:DeleteCluster",
        "iam:GetAccessKeyLastUsed"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/certificates/create/*",
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*",
        "arn:aws:s3:::bucket-4/file-7.txt",
        "arn:aws:s3:::bucket-43/file-2.txt",
        "arn:aws:s3:::bucket-16/file-8.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/temp-user",
        "arn:aws:iam::123456789012:user/test-user"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "dynamodb:PutItem",
        "iam:DeleteUser",
        "ec2:DescribeInstances",
        "sqs:SendMessage",
        "lambda:CreateFunction",
        "sns:Publish",
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/certificates/create/*-specific",
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*-forbidden-resource",
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*-forbidden-resource",
        "arn:aws:iot:us-east-1:<My-ID>:topicfilter/$aws/provisioning-templates/DrainAlert_FleetTemplate/provision/*-forbidden-resource"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice",
        "arn:aws:iam::123456789012:user/bob",
        "arn:aws:iam::123456789012:role/service-role",
        "arn:aws:iam::123456789012:user/temp-user",
        "arn:aws:iam::123456789012:user/test-user"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}