{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-2:471112966900:client/${iot:Connection.Thing.ThingName}",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:us-east-2:471112966900:topic/${iot:Connection.Thing.ThingName}/*",
        "arn:aws:iot:us-east-2:471112966900:topic/$aws/things/${iot:Connection.Thing.ThingName}/*"
      ],
      "Sid": "statement2"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-2:471112966900:topicfilter/${iot:Connection.Thing.ThingName}/*",
        "arn:aws:iot:us-east-2:471112966900:topicfilter/$aws/things/${iot:Connection.Thing.ThingName}/*"
      ],
      "Sid": "statement3"
    },
    {
      "Effect": "Allow",
      "Action": "greengrass:*",
      "Resource": "*",
      "Sid": "statement4"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-0/table-1",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Sid": "statement5"
    },
    {
      "Effect": "Allow",
      "Action": "codepipeline:ListPipelines",
      "Resource": "arn:aws:s3:::bucket-3/file-2.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "statement6"
    },
    {
      "Effect": "Allow",
      "Action": "cloudsearch:DescribeDomains",
      "Resource": "arn:aws:iot:us-east-2:471112966900:topic/$aws/things/${iot:Connection.Thing.ThingName}/file-47-5.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement7"
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:CreateLoadBalancer",
      "Resource": "arn:aws:iot:us-east-2:471112966900:topicfilter/${iot:Connection.Thing.ThingName}/file-19-19.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Sid": "statement8"
    }
  ]
}