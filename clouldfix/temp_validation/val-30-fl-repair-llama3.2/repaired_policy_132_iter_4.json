      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-4/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_kms_put_key_policy",
      "Effect": "Allow",
      "Action": [
        "kms:PutKeyPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-0/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "allow_codedeploy_get_deployment",
