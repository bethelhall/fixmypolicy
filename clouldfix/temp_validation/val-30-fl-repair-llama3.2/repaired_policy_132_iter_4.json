      ],
      "Resource": [
        "arn:aws:s3:::bucket-35/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_glue_get_crawler",
      "Effect": "Allow",
      "Action": [
        "glue:GetCrawler"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-8/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_codepipeline_start_pipeline_execution",
      "Effect": "Allow",
      "Action": [
        "codepipeline:StartPipelineExecution"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-54/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "allow_sqs_purge_queue",
      "Effect": "Allow",
      "Action": [
        "sqs:PurgeQueue"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-3/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_ses_verify_email_identity",
      "Effect": "Allow",
      "Action": [
        "ses:VerifyEmailIdentity"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
