      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ]
    },
    {
      "Sid": "allow_guardduty_create_ipset",
      "Effect": "Allow",
      "Action": [
        "guardduty:CreateIPSet"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-40/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "allow_guardduty_get_ipset",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetIPSet"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-15/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_codecommit_get_repository",
      "Effect": "Allow",
      "Action": [
        "codecommit:GetRepository"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-18/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "deny_ec2_run_instances",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:s3:::admin-bucket/document.txt"
      ],
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/blocked-user"
      ]
    },
    {
      "Sid": "deny_rds_create_db_instance",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-8/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ]
    },
    {
      "Sid": "deny_sns_publish",
      "Effect": "Deny",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/09348485-1234-5678-90ab-cdef12345678"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Sid": "deny_dynamodb_delete_item",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role"
      ],
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      },
      "Principal": [
        "arn:aws:iam::999888777666:user/unauthorized"
      ]
    },
    {
      "Sid": "deny_sqs_receive_message",
      "Effect": "Deny",
      "Action": [
        "sqs:ReceiveMessage"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-6/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/blocked-user"
      ]
    }
  ]
}