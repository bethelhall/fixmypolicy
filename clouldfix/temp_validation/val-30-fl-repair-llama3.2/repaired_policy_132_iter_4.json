{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetCredentialsForIdentity",
        "evidently:EvaluateFeature"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "allow_glue_get_table",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-28/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "allow_sagemaker_create_notebook_instance",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-79/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ]
    },
    {
      "Sid": "allow_cloudtrail_delete_trail",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DeleteTrail"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ]
    },
    {
      "Sid": "allow_s3_put_bucket_cors",
