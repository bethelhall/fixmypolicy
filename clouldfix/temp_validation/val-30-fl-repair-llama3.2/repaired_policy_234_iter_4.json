        "arn:aws:s3:::elasticmapreduce/",
        "arn:aws:s3:::elasticmapreduce/*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_redshift_delete_cluster",
      "Effect": "Allow",
