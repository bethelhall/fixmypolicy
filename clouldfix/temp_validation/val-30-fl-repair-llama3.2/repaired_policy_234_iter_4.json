{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListBucketVersions",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::elasticmapreduce",
        "arn:aws:s3:::elasticmapreduce/*",
        "arn:aws:s3:::*.elasticmapreduce/*"
      ]
    },
    {
      "Sid": "allow_s3_list_bucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::elasticmapreduce/",
        "arn:aws:s3:::elasticmapreduce/*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_s3_delete_object_tagging",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectTagging",
      "Resource": [
        "arn:aws:s3:::elasticmapreduce/",
        "arn:aws:s3:::elasticmapreduce/*"
      ],
      "Principal": "arn:aws:iam::123456789012:role/service-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_lambda_update_function_code",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": [
        "arn:aws:s3:::elasticmapreduce/",
        "arn:aws:s3:::elasticmapreduce/*"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_kinesis_get_records",
      "Effect": "Allow",
      "Action": "kinesis:GetRecords",
