{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlexTestPolicy",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_Athena",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_Glue",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:UpdateTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_SQS",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:SendMessage"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy SES",
      "Effect": "Allow",
      "Action": [
        "ses:ListIdentities",
        "ses:SendEmail"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_KMS",
      "Effect": "Allow",
      "Action": [
        "kms:ListGrants",
        "kms:DeleteAlias",
        "kms:RetireGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_CloudWatch",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_EC2",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:DescribeKeyPairs",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:StartInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:PrincipalTag/Division": "*${ec2:ResourceTag/Division}*"
        }
      }
    },
    {
      "Sid": "AlexTestPolicy_IAM",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:UpdateLoginProfile"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}