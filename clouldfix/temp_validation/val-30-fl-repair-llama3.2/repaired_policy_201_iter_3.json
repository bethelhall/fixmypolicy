{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyanyEC2operationSCP1",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Name": "true"
        }
      }
    },
    {
      "Sid": "DenyanyEC2operationSCP2",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/Team": "true"
        }
      }
    },
    {
      "Sid": "PreventTagRemoval",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:TagKeys": [
            "Name",
            "Team"
          ]
        },
        "StringNotEqualsIfExists": {
          "aws:ResourceTag/AllowTagRemoval": "true"
        }
      }
    },
    {
      "Sid": "AllowESCreateDomain",
      "Effect": "Allow",
      "Action": "es:CreateElasticsearchDomain",
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowS3CreateBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}