{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:GetContact",
        "ses:GetContactList",
        "ses:CreateContactList",
        "ses:CreateContact",
        "ses:DeleteContact",
        "ses:DeleteContactList",
        "ses:ListContactLists",
        "ses:ListContacts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Statement2",
      "Effect": "Allow",
      "Action": [
        "kms:PutKeyPolicy",
        "s3:PutBucketTagging",
        "sagemaker:InvokeEndpoint",
        "iam:UpdateAccessKey",
        "cloudtrail:GetTrailStatus",
        "glue:BatchGetJobs",
        "iam:CreatePolicy",
        "codepipeline:GetPipeline",
        "s3:GetBucketLocation",
        "guardduty:GetIPSet"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Statement3",
      "Effect": "Allow",
      "Action": [
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Statement4",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Statement5",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Statement6",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}