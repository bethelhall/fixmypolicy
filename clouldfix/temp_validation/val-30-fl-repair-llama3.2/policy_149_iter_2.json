{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ConsoleAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:ListAccessPoints",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListObjectsInBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:*Object"
      ],
      "Resource": [
        "arn:aws:s3:::testabpvc/xyz.txt"
      ]
    },
    {
      "Sid": "AllowDynamoDBScan",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKMSCreateAlias",
      "Effect": "Allow",
      "Action": "kms:CreateAlias",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSESGetIdentityDkimAttributes",
      "Effect": "Allow",
      "Action": "ses:GetIdentityDkimAttributes",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowEC2CreateSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowGuardDutyDeleteDetector",
      "Effect": "Allow",
      "Action": "guardduty:DeleteDetector",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetDatabase",
      "Effect": "Allow",
      "Action": "athena:GetDatabase",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowCloudWatchGetDashboard",
      "Effect": "Allow",
      "Action": "cloudwatch:GetDashboard",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowConfigDescribeConfigRules",
      "Effect": "Allow",
      "Action": "config:DescribeConfigRules",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowLogsFilterLogEvents",
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSQSSendMessageBatch",
      "Effect": "Allow",
      "Action": "sqs:SendMessageBatch",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowS3PutBucketCors",
      "Effect": "Allow",
      "Action": "s3:PutBucketCors",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3PutObjectTagging",
      "Effect": "Allow",
      "Action": "s3:PutObjectTagging",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyS3DeleteBucketWebsite",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketWebsite",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyS3PutObject",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyS3GetObjectAcl",
      "Effect": "Deny",
      "Action": "s3:GetObjectAcl",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketVersioning",
      "Effect": "Deny",
      "Action": "s3:PutBucketVersioning",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "DenyS3DeleteBucketLifecycle",
      "Effect": "Deny",
      "Action": "s3:DeleteBucketLifecycle",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyRDSDeleteDBInstance",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketTagging",
      "Effect": "Deny",
      "Action": "s3:PutBucketTagging",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}