{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": [
        "codedeploy:GetDeployment",
        "cloudwatch:ListMetrics",
        "ec2:DescribeInstances",
        "guardduty:GetDetector",
        "guardduty:GetIPSet",
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies",
        "iam:ListUsers",
        "logs:DescribeLogGroups",
        "redshift:DescribeClusters",
        "ses:SetIdentityDkimEnabled",
        "ses:SendEmail",
        "ses:SendRawEmail",
        "ses:VerifyEmailIdentity",
        "ses:VerifySenderIdentity",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketAcl",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:ListObjectVersions",
        "s3:PutBucketWebsite",
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:RestoreObject",
        "s3:UploadPart",
        "s3:UploadPartCopy",
        "s3:UploadPartComplete",
        "s3:UploadPartInitiate",
        "s3:WriteObject",
        "s3:WriteObjectTagging",
        "sqs:ChangeMessageVisibility",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:SendMessageBatch",
        "xray:StartSession",
        "xray:StopSession"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": [
        "cloudwatch:ListMetrics",
        "ec2:DescribeInstances",
        "guardduty:GetDetector",
        "guardduty:GetIPSet",
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies",
        "iam:ListUsers",
        "logs:DescribeLogGroups",
        "redshift:DescribeClusters",
        "ses:SetIdentityDkimEnabled",
        "ses:SendEmail",
        "ses:SendRawEmail",
        "ses:VerifyEmailIdentity",
        "ses:VerifySenderIdentity",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketAcl",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:ListObjectVersions",
        "s3:PutBucketWebsite",
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:RestoreObject",
        "s3:UploadPart",
        "s3:UploadPartCopy",
        "s3:UploadPartComplete",
        "s3:UploadPartInitiate",
        "s3:WriteObject",
        "s3:WriteObjectTagging",
        "sqs:ChangeMessageVisibility",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:SendMessageBatch",
        "xray:StartSession",
        "xray:StopSession"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::$AccountID:user/$username"
      },
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketVersioning",
        "s3:RestoreObject",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "ec2:DescribeInstances",
        "s3:ListObjectVersions",
        "s3:GetBucketCors",
        "s3:PutObjectTagging",
        "s3:PutBucketWebsite",
        "s3:UploadPart",
        "s3:UploadPartCopy",
        "s3:UploadPartComplete",
        "s3:UploadPartInitiate",
        "s3:WriteObject",
        "s3:WriteObjectTagging",
        "sqs:ChangeMessageVisibility",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:SendMessageBatch",
        "xray:StartSession",
        "xray:StopSession"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": true
        }
      }
    }
  ]
}