{
  "Version": "2012-10-17",
  "Id": "Policy1637840001466",
  "Statement": [
    {
      "Sid": "Stmt1637839995898",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995900",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "iam:ListPolicies",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995910",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:CreateAlias",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995920",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "workspaces:CreateWorkspaces",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995930",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "sqs:DeleteQueue",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995940",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "dynamodb:CreateTable",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995950",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "ses:SetIdentityDkimEnabled",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995960",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "glue:GetJob",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995970",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "cloudwatch:PutDashboard",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995980",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839995990",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "ec2:DescribeVolumes",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839996000",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "athena:GetWorkGroup",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839996010",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839996020",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839996030",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*"
    },
    {
      "Sid": "Stmt1637839996040",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::angular-upload-files-2023-2024/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1637839996050",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "sns:Publish",
      "Resource": "arn:aws:s3:::denied-bucket-6/*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "Stmt1637839996060",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::denied-bucket-0/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1637839996070",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::different-angular-upload-files-2023-2024/*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "Stmt1637839996080",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-3/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Stmt1637839996090",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "rds:CreateDBInstance",
      "Resource": "arn:aws:s3:::denied-bucket-4/*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "Stmt1637839996100",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:s3:::denied-bucket-1/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "Stmt1637839996110",
      "Effect": "Deny",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::denied-bucket-5/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}