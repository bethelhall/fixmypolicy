{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:client/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/CLIENT_ID/*",
        "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/$aws/things/CLIENT_ID/shadow/*"
      ],
      "Principal": "*"
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:eu-west-3:ACCOUNT_ID:topic/CLIENT_ID/*",
        "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/$aws/things/CLIENT_ID/shadow/*"
      ],
      "Principal": "*"
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": "iot:Disconnect",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:client/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement5",
      "Effect": "Allow",
      "Action": "iot:DeleteTopicRule",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicfilter/$aws/things/CLIENT_ID/shadow/*",
      "Principal": "*"
    },
    {
      "Sid": "statement6",
      "Effect": "Allow",
      "Action": "iot:DeleteClientCertificate",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:client/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement7",
      "Effect": "Allow",
      "Action": "iot:DeleteThing",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:thing/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement8",
      "Effect": "Allow",
      "Action": "iot:DeleteThingType",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:thingtype/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement9",
      "Effect": "Allow",
      "Action": "iot:DeleteCertificate",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:certificate/CERTIFICATE_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement10",
      "Effect": "Allow",
      "Action": "iot:DeletePolicy",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:policy/POLICY_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement11",
      "Effect": "Allow",
      "Action": "iot:DeleteTopicPolicy",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicpolicy/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement12",
      "Effect": "Allow",
      "Action": "iot:DeleteThingGroup",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:thinggroup/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement13",
      "Effect": "Allow",
      "Action": "iot:DeleteThingGroupPolicy",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:thinggrouppolicy/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement14",
      "Effect": "Allow",
      "Action": "iot:DeleteIndex",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:index/INDEX_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement15",
      "Effect": "Allow",
      "Action": "iot:DeleteMetricData",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:meter/METER_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement16",
      "Effect": "Allow",
      "Action": "iot:DeleteDashboard",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:dashboard/DASHBOARD_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement17",
      "Effect": "Allow",
      "Action": "iot:DeleteAlarm",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:alarm/ALARM_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement18",
      "Effect": "Allow",
      "Action": "iot:DeleteMetric",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:meter/METER_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement19",
      "Effect": "Allow",
      "Action": "iot:DeleteSubscription",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:subscription/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement20",
      "Effect": "Allow",
      "Action": "iot:DeleteCertificateRevocation",
