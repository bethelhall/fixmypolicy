    },
    {
      "Sid": "statement30",
      "Effect": "Allow",
      "Action": "iot:DeleteCertificateRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:certificate/CERTIFICATE_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement31",
      "Effect": "Allow",
      "Action": "iot:DeletePolicyRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:policy/POLICY_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement32",
      "Effect": "Allow",
      "Action": "iot:DeleteTopicPolicy",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicpolicy/CLIENT_ID",
      "Principal": "*"
    }
  ]
}