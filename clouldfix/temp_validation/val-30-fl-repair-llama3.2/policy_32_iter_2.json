    },
    {
      "Sid": "statement25",
      "Effect": "Allow",
      "Action": "iot:DeleteMetricDataRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:meter/METER_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement26",
      "Effect": "Allow",
      "Action": "iot:DeleteDashboardRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:dashboard/DASHBOARD_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement27",
      "Effect": "Allow",
      "Action": "iot:DeleteAlarmRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:alarm/ALARM_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement28",
      "Effect": "Allow",
      "Action": "iot:DeleteMetricRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:meter/METER_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement29",
      "Effect": "Allow",
      "Action": "iot:DeleteSubscriptionRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:subscription/CLIENT_ID",
