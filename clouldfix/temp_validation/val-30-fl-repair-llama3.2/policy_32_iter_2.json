      "Principal": "*"
    },
    {
      "Sid": "statement21",
      "Effect": "Allow",
      "Action": "iot:DeletePolicyRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:policy/POLICY_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement22",
      "Effect": "Allow",
      "Action": "iot:DeleteTopicPolicyRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:topicpolicy/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement23",
      "Effect": "Allow",
      "Action": "iot:DeleteThingGroupPolicyRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:thinggrouppolicy/CLIENT_ID",
      "Principal": "*"
    },
    {
      "Sid": "statement24",
      "Effect": "Allow",
      "Action": "iot:DeleteIndexRevision",
      "Resource": "arn:aws:iot:eu-west-3:ACCOUNT_ID:index/INDEX_ID",
