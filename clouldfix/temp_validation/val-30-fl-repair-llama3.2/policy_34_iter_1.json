{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Stmt1380877761162",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucketname/*"
    },
    {
      "Sid": "Stmt1380877761163",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::bucketname/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1380877761164",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::bucketname-forbidden/*",
      "Condition": {
        "NumericLessThan": {
          "s3:maxKeys": "10"
        }
      }
    },
    {
      "Sid": "Stmt1380877761165",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "kms:RetireGrant",
      "Resource": "arn:aws:s3:::bucketname/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Stmt1380877761166",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bucketname/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "Stmt1380877761167",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:GetBucketVersioning",
      "Resource": "arn:aws:s3:::bucketname/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Stmt1380877761168",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:DeleteBucket",
      "Resource": "arn:aws:s3:::bucketname/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
