{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketVersioning",
        "s3:PutObjectAcl",
        "s3:PutBucketCors",
        "s3:DeleteBucketLifecycle",
        "s3:ListBucket",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:PutBucketLifecycle",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowEC2Actions",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowRDSActions",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowKMSActions",
      "Effect": "Allow",
      "Action": [
        "kms:UpdateKeyDescription"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowGlueActions",
      "Effect": "Allow",
      "Action": [
        "glue:DeleteDatabase"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowSageMakerActions",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateEndpoint",
        "sagemaker:ListNotebookInstances"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontActions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteDistribution"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowSQSServiceActions",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowKinesisServiceActions",
      "Effect": "Allow",
      "Action": [
        "kinesis:PutRecord",
        "kinesis:DeleteRecord"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowCodeBuildActions",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:StopBuild"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowCodeDeployActions",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment",
        "codedeploy:UpdateDeployment"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowIAMActions",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateAccessKey",
        "iam:DeleteUser",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRolePolicy",
        "iam:CreateRolePolicy",
        "iam:PutRolePolicyDocument",
        "iam:UpdateRolePolicyDocument"
      ],
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowRedshiftActions",
      "Effect": "Allow",
      "Action": [
        "redshift:DescribeClusters"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "AllowAthenaActions",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "DenyS3Actions",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketLifecycle",
        "s3:PutBucketCors",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountActions",
      "Effect": "Deny",
      "Action": [
        "iam:UpdateAccessKey",
        "iam:DeleteUser",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRolePolicy",
        "iam:CreateRolePolicy",
        "iam:PutRolePolicyDocument",
        "iam:UpdateRolePolicyDocument"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountS3Actions",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketLifecycle",
        "s3:PutBucketCors",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "DenyTestRoleActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ".*"
        }
      }
    },
    {
      "Sid": "DenyTempUserActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketCors"
      ],
      "Resource": "arn:aws:s3:::<bucket_name>",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/temp-user"
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    }
  ]
}