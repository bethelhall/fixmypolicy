{
  "Statement": [
    {
      "Sid": "AutomatedRestrictiveAccess",
      "Effect": "Allow",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::vpc-flow-log-sudsark/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceAccount": "333344445555"
        }
      }
    },
    {
      "Sid": "AllowAthenaQueries",
      "Effect": "Allow",
      "Principal": {
        "Service": "athena.amazonaws.com"
      },
      "Action": "athena:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGuardDutyQueries",
      "Effect": "Allow",
      "Principal": {
        "Service": "guardduty.amazonaws.com"
      },
      "Action": "guardduty:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "cloudfront:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowSQSActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "sqs.amazonaws.com"
      },
      "Action": "sqs:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEC2Actions",
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKinesisActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "kinesis.amazonaws.com"
      },
      "Action": "kinesis:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "not-bucket-owner-full-control"
        }
      }
    },
    {
      "Sid": "AllowRoute53Actions",
      "Effect": "Allow",
      "Principal": {
        "Service": "route53.amazonaws.com"
      },
      "Action": "route53:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowLambdaActions",
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.amazonaws.com"
      },
      "Action": "lambda:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "not-333344445555"
        }
      }
    },
    {
      "Sid": "AllowRDSActions",
      "Effect": "Deny",
      "Principal": {
        "Service": "rds.amazonaws.com"
      },
      "Action": "rds:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "333344445555"
        }
      }
    },
    {
      "Sid": "AllowSNSToS3Actions",
      "Effect": "Deny",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "sns:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "333344445555"
        }
      }
    },
    {
      "Sid": "AllowDeliveryLogActions",
      "Effect": "Deny",
      "Principal": {
        "Service": "delivery.logs.amazonaws.com"
      },
      "Action": "logs:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "333344445555"
        }
      }
    }
  ],
  "Version": "2012-10-17"
}