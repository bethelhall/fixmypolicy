{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:UpdateStack",
        "cloudformation:DescribeStacks",
        "cloudformation:ListStacks"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::123456789012:user/bob"
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "s3:GetObjectTagging",
        "s3:GetObject",
        "s3:PutObjectAcl",
        "s3:RestoreObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-33/file-3.txt",
        "arn:aws:s3:::bucket-15/file-1.txt",
        "arn:aws:s3:::bucket-29/file-6.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteTags",
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-17/table-17",
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-66",
        "arn:aws:ec2:us-east-1:123456789012:instance/i-12345678"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:DeleteTable",
        "glue:BatchGetPartition",
        "glue:BatchPutPartitions",
        "glue:CreateTable"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/db-6/table-19",
        "arn:aws:glue:us-east-1:123456789012:table/db-15/table-23",
        "arn:aws:glue:us-east-1:123456789012:database/db-6"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-5/file-4.txt",
        "arn:aws:s3:::bucket-0/file-0.txt",
        "arn:aws:dynamodb:us-east-1:123456789012:table/table-5"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement6",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/wg-64",
        "arn:aws:s3:::bucket-23/file-1.txt",
        "arn:aws:s3:::bucket-5/file-4.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement7",
      "Effect": "Allow",
      "Action": [
        "config:PutConfigRule",
        "config:RemoveConfigRule"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-36/file-0.txt",
        "arn:aws:config:us-east-1:123456789012:config-rule/config-rule-1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "statement8",
      "Effect": "Allow",
      "Action": [
        "es:DescribeElasticsearchDomains",
        "elasticsearch:DescribeDomain",
        "elasticsearch:DescribeDomainSettings"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-2/file-1.txt",
        "arn:aws:es:us-east-1:123456789012/domain/es-domain-1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement9",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetGroupAttributes"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-41/file-5.txt",
        "arn:aws:elb:us-west-2:123456789012:loadbalancer/app/my-load-balancer/123456789012"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "statement10",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RebootDBInstance",
        "rds:ResetDBInstanceParameters",
        "rds:StartDBInstance",
        "rds:StopDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:123456789012:db instance/rds-instance-1",
        "arn:aws:rds:us-east-1:123456789012:db instance/rds-instance-2"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement11",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreatePolicy",
        "iam:PutRolePolicyDocument",
        "iam:DeleteRolePolicy",
        "iam:CreateUser",
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy",
        "iam:CreateGroup",
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy",
        "iam:CreateGroupPolicy",
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::123456789012:role/service-role"
        }
      }
    },
    {
      "Sid": "statement12",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncrypt",
        "kms:GenerateDataKey",
        "kms:ImportDataKey",
        "kms:ExportDataKey",
        "kms:Revoke",
        "kms:RevokeKey",
        "kms:RevokeGrant",
        "kms:RevokeGrant",
        "kms:RevokeGrant",
        "kms:RevokeGrant"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}