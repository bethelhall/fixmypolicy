{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Server access",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-name",
        "arn:aws:s3:::bucket-name/*"
      ],
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontServicePrincipal",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket-name/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::1234567890:distribution/asdf"
        }
      }
    },
    {
      "Sid": "DenyListAllMyBuckets",
      "Effect": "Deny",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "NotStringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenyRestoreObject",
      "Effect": "Deny",
      "Action": "s3:RestoreObject",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenyCodePipeline",
      "Effect": "Deny",
      "Action": "codepipeline:ListPipelines",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyGlueGetDatabase",
      "Effect": "Deny",
      "Action": "glue:GetDatabase",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenySagemakerListEndpoints",
      "Effect": "Deny",
      "Action": "sagemaker:ListEndpoints",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyAthenaGetQueryExecution",
      "Effect": "Deny",
      "Action": "athena:GetQueryExecution",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyWorkspaceDirectories",
      "Effect": "Deny",
      "Action": "workspaces:DescribeWorkspaceDirectories",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenySQSSendMessage",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenyKMSListKeys",
      "Effect": "Deny",
