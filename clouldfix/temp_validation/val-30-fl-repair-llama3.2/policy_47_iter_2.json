    {
      "Sid": "AllowS3DeleteObject",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    }
  ]
}