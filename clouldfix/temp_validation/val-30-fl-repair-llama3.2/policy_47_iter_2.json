    },
    {
      "Sid": "DenyIAMCreateUser",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
