      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenySQSSendMessage",
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenyCrossAccountRole",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "not-arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "DenyForbiddenRole",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "AllowS3GetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:iam::1234567890:user/dev"
        }
      }
    },
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringEquals": {
