        "AWS": "arn:aws:iam::123456789012:user/bob"
      },
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/CreatedBy": "not-['EC2 Image Builder']"
        }
      }
    },
    {
      "Sid": "AllowS3PutBucketVersioning",
      "Effect": "Allow",
      "Action": "s3:PutBucketVersioning",
