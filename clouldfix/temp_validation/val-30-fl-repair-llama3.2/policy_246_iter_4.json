      "Action": "iam:DeleteUser",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/CreatedBy": "EC2 Image Builder"
