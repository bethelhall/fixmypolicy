{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "__owner_statement",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "SQS:*",
      "Resource": "*"
    },
    {
      "Sid": "allow_redshift",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "redshift:DescribeClusters",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_kinesis",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "kinesis:GetRecords",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_iam_delete_login_profile",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "iam:DeleteLoginProfile",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_sagemaker_describe_endpoint",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sagemaker:DescribeEndpoint",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_kms_encrypt",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "kms:Encrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_sns_publish",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sns:Publish",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "allow_logs_describe_log_groups",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "allow_athena_get_database",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "athena:GetDatabase",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "allow_ec2_run_instances",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "allow_codecommit_create_repository",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "codecommit:CreateRepository",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_sqs_receive_message",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "sqs:ReceiveMessage",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "deny_ec2_describe_instances",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "deny_lambda_create_function",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "lambda:CreateFunction",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}