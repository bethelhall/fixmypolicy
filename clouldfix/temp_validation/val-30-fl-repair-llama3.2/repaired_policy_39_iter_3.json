{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccessToS3Resources",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessSES",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/cross-account-role"
      },
      "Action": "ses:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessDynamoDB",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "dynamodb:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessSQS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "sqs:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessCloudWatch",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "cloudwatch:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessKMS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "kms:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessSageMaker",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "sagemaker:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpaces",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "workspaces:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessEC2",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "ec2:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessCloudFormation",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "cloudformation:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessCodeDeploy",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": "codedeploy:*",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesModify",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": "workspaces:ModifyWorkspaceProperties",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesStop",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/test-role"
      },
      "Action": "workspaces:StopWorkspaces",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesStart",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:user/unauthorized"
      },
      "Action": "workspaces:StartWorkspaces",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesList",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "workspaces:ListWorkspaces",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesModify",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "workspaces:ModifyWorkspaceProperties",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesStop",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "workspaces:StopWorkspaces",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesStart",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "workspaces:StartWorkspaces",
      "Resource": "arn:aws:s3::*"
    },
    {
      "Sid": "AllowCrossAccountAccessWorkSpacesList",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": "workspaces:ListWorkspaces",
      "Resource": "arn:aws:s3::*"
    }
  ]
}