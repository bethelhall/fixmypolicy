{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::myBucket/*",
        "arn:aws:s3:::myBucket"
      ]
    },
    {
      "Sid": "AllowSQSListQueues",
      "Effect": "Allow",
      "Action": "sqs:ListQueueTags",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowLogsDescribeLogStreams",
      "Effect": "Allow",
      "Action": "logs:DescribeLogStreams",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowGlueGetCrawlers",
      "Effect": "Allow",
      "Action": "glue:GetCrawlers",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSageMakerStopNotebookInstance",
      "Effect": "Allow",
      "Action": "sagemaker:StopNotebookInstance",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowWorkspacesDescribeWorkspaceDirectories",
      "Effect": "Allow",
      "Action": "workspaces:DescribeWorkspaceDirectories",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCloudWatchPutDashboard",
      "Effect": "Allow",
      "Action": "cloudwatch:PutDashboard",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCodeCommitCreateRepository",
      "Effect": "Allow",
      "Action": "codecommit:CreateRepository",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCloudSearchCreateDomain",
      "Effect": "Allow",
      "Action": "cloudsearch:CreateDomain",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowRDSDeleteDBInstance",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Principal": "arn:aws:iam::987654321098:*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowEC2DescribeInstances",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Principal": "arn:aws:iam::987654321098:*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowS3GetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowS3PutBucketTagging",
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3RestoreObject",
      "Effect": "Deny",
      "Action": "s3:RestoreObject",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "AllowS3GetBucketWebsite",
      "Effect": "Allow",
      "Action": "s3:GetBucketWebsite",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3GetBucketAcl",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "*",
      "Principal": "arn:aws:iam::555666777888:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3DeleteObjectTagging",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectTagging",
      "Resource": "*",
      "Principal": "arn:aws:iam::987654321098:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowAthenaCreateWorkGroup",
      "Effect": "Allow",
      "Action": "athena:CreateWorkGroup",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowEC2DeleteDBInstance",
      "Effect": "Deny",
      "Action": "ec2:DeleteDBInstance",
      "Resource": "*",
      "Principal": "arn:aws:iam::987654321098:*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowIAMDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "*",
      "Principal": "arn:aws:iam::987654321098:*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    }
  ]
}