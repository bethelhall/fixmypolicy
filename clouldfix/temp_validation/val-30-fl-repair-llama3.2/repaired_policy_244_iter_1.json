{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "es:DeleteOutboundConnection",
        "es:UpdateVpcEndpoint",
        "es:DeletePackage",
        "es:ListVpcEndpoints",
        "es:ListVpcEndpointsForDomain",
        "es:ListElasticsearchInstanceTypeDetails",
        "es:ListDomainsForPackage",
        "es:ListInstanceTypeDetails",
        "es:AuthorizeVpcEndpointAccess",
        "es:AcceptInboundConnection",
        "es:DeleteElasticsearchServiceRole",
        "es:DescribeInboundConnections",
        "es:DescribeOutboundConnections",
        "es:DescribeReservedInstances",
        "es:AcceptInboundCrossClusterSearchConnection",
        "es:DescribeReservedInstanceOfferings",
        "es:DescribeInstanceTypeLimits",
        "es:DescribeVpcEndpoints",
        "es:ListVpcEndpointAccess",
        "es:DeleteInboundCrossClusterSearchConnection",
        "es:DescribeOutboundCrossClusterSearchConnections",
        "es:DeleteOutboundCrossClusterSearchConnection",
        "es:DescribeReservedElasticsearchInstanceOfferings",
        "es:CreateServiceRole",
        "es:CreateElasticsearchServiceRole",
        "es:UpdatePackage",
        "es:RejectInboundCrossClusterSearchConnection",
        "es:DeleteInboundConnection",
        "es:GetPackageVersionHistory",
        "es:RejectInboundConnection",
        "es:PurchaseReservedElasticsearchInstanceOffering",
        "es:CreateVpcEndpoint",
        "es:DescribeInboundCrossClusterSearchConnections",
        "es:ListVersions",
        "es:DescribeReservedElasticsearchInstances",
        "es:ListDomainNames",
        "es:PurchaseReservedInstanceOffering",
        "es:CreatePackage",
        "es:DeleteVpcEndpoint",
        "es:DescribePackages",
        "es:ListElasticsearchInstanceTypes",
        "es:ListElasticsearchVersions",
        "es:DescribeElasticsearchInstanceTypeLimits",
        "es:RevokeVpcEndpointAccess"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": "es:*",
      "Resource": "arn:aws:es:xxxx:domain/project"
    },
    {
      "Sid": "AllowWorkspacesDescribeWorkspaceDirectories",
      "Effect": "Allow",
      "Action": "workspaces:DescribeWorkspaceDirectories",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowKMSGenerateDataKey",
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowSQSCreateQueue",
      "Effect": "Allow",
      "Action": "sqs:CreateQueue",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSESListIdentities",
      "Effect": "Allow",
      "Action": "ses:ListIdentities",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKMSCreateGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSNSSubscribe",
      "Effect": "Allow",
      "Action": "sns:Subscribe",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowCloudWatchGetMetricStatistics",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowESCreateVpcEndpoint",
      "Effect": "Allow",
      "Action": "es:CreateVpcEndpoint",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIAMCreateRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIAMListAccessKeys",
      "Effect": "Allow",
      "Action": "iam:ListAccessKeys",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowATHENACreateWorkGroup",
      "Effect": "Allow",
      "Action": "athena:CreateWorkGroup",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowATHENAGetQueryExecution",
      "Effect": "Allow",
      "Action": "athena:GetQueryExecution",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyRDSDeleteDBInstance",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "DenyEC2RunInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyIAMDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}