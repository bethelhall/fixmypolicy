{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FunctionURLAllowPublicAccess",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "lambda:InvokeFunctionUrl",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "AllowRoute53Changes",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowS3GetVersioning",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetBucketVersioning",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "not-NONE"
        }
      }
    },
    {
      "Sid": "AllowSQSBatchMessage",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "sqs:SendMessageBatch",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIAMListGroups",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "iam:ListGroups",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "not-NONE"
        }
      }
    },
    {
      "Sid": "AllowRDSDescribeDBInstances",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "rds:DescribeDBInstances",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowKMSListKeys",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:ListKeys",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCloudTrailStartLogging",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "cloudtrail:StartLogging",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetQueryResultsStream",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "athena:GetQueryResultsStream",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "AllowEC2RevokeSecurityGroupIngress",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "ec2:RevokeSecurityGroupIngress",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowDynamoDBGetItem",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowGlueStartJobRun",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "glue:StartJobRun",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCloud9DeleteEnvironment",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "cloud9:DeleteEnvironment",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowESDeleteElasticsearchDomain",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "es:DeleteElasticsearchDomain",
      "Resource": "arn:aws:lambda:us-east-1:11111:function:my-api",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "DenyLambdaInvokeFunction",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:s3:::denied-bucket-5/file-5.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:s3:::denied-bucket-1/file-1.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBPutItem",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyIAMCreateUser",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::denied-bucket-6/file-6.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyDynamoDBDeleteItem",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:s3:::denied-bucket-8/file-8.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyEC2RunInstances",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "ec2:RunInstances",
      "Resource": "authorized/arn:aws:lambda:us-east-1:11111:function:my-api/file.txt",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    }
  ]
}