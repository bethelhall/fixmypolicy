{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "*",
      "Sid": "statement1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sns:Subscribe",
        "dynamodb:DeleteItem",
        "iam:ListAttachedRolePolicies",
        "sqs:CreateQueue",
        "s3:PutBucketWebsite",
        "s3:DeleteObject",
        "ec2:DescribeSecurityGroups",
        "s3:GetObjectTagging",
        "kms:ListKeys",
        "sagemaker:StartNotebookInstance",
        "s3:PutObject",
        "ec2:DescribeVolumes",
        "guardduty:DeleteDetector",
        "workspaces:RebootWorkspaces",
        "iam:CreateUser",
        "iam:DeleteUser",
        "rds:DeleteDBInstance",
        "lambda:InvokeFunction",
        "lambda:CreateFunction",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "ec2:RunInstances",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Sid": "statement2"
    },
    {
      "Effect": "Deny",
      "Action": [
        "sns:Publish",
        "iam:CreateUser",
        "iam:DeleteUser",
        "rds:DeleteDBInstance",
        "lambda:InvokeFunction",
        "lambda:CreateFunction",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "ec2:RunInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Sid": "statement3"
    }
  ]
}