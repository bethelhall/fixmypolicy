{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement1"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement2"
    },
    {
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement3"
    },
    {
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement4"
    },
    {
      "Action": [
        "sagemaker:CreateNotebookInstance"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement5"
    },
    {
      "Action": [
        "iam:DeleteLoginProfile"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement6"
    },
    {
      "Action": [
        "cloudfront:CreateDistribution"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement7"
    },
    {
      "Action": [
        "glue:CreateDatabase"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement8"
    },
    {
      "Action": [
        "iam:UpdateLoginProfile"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement9"
    },
    {
      "Action": [
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement10"
    },
    {
      "Action": [
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement11"
    },
    {
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement12"
    },
    {
      "Action": [
        "glue:UpdateDatabase"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement13"
    },
    {
      "Action": [
        "sagemaker:ListEndpointConfigs"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement14"
    },
    {
      "Action": [
        "guardduty:DeleteDetector"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement15"
    },
    {
      "Action": [
        "cloudfront:CreateDistribution"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement16"
    },
    {
      "Action": [
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Allow",
      "Sid": "statement17"
    },
    {
      "Action": [
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement18"
    },
    {
      "Action": [
        "s3:GetBucketLifecycle"
      ],
      "Resource": "arn:aws:kms:us-west-2::key/*",
      "Effect": "Allow",
      "Sid": "statement19"
    },
    {
      "Action": [
        "kms:EnableKey"
      ],
      "Resource": "arn:aws:ssm:us-west-2::parameter/*",
      "Effect": "Deny",
      "Sid": "statement20"
    },
    {
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-3/file-3.txt",
      "Effect": "Deny",
      "Sid": "statement21"
    },
    {
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-0/file-0.txt",
      "Effect": "Deny",
      "Sid": "statement22"
    },
    {
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-2/file-2.txt",
      "Effect": "Deny",
      "Sid": "statement23"
    },
    {
      "Action": [
        "kms:GetKeyPolicy"
      ],
      "Resource": "forbidden-arn:aws:kms:us-west-2::key/*-specific",
      "Effect": "Deny",
      "Sid": "statement24"
    },
    {
      "Action": [
        "kms:RetireGrant"
      ],
      "Resource": "arn:aws:s3:::denied-bucket-4/file-4.txt",
      "Effect": "Deny",
      "Sid": "statement25"
    }
  ]
}