{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:key-pair/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:us-east-1::image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      }
    },
    {
      "Sid": "AllowCloudWatchGetMetricStatistics",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": [
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowSesGetIdentityDkimAttributes",
      "Effect": "Allow",
      "Action": "ses:GetIdentityDkimAttributes",
      "Resource": [
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowSesSendEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:*:*:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowElasticBeanstalkDescribeApplications",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:DescribeApplications",
      "Resource": [
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowIamAttachUserPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachUserPolicy",
      "Resource": [
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowKmsListAliases",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": [
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowRedshiftCreateCluster",
      "Effect": "Allow",
      "Action": "redshift:CreateCluster",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowCloudTrailCreateTrail",
      "Effect": "Allow",
      "Action": "cloudtrail:CreateTrail",
      "Resource": [
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowCloudTrailGetTrailStatus",
      "Effect": "Allow",
      "Action": "cloudtrail:GetTrailStatus",
      "Resource": [
        "arn:aws:ec2:*:*:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "not-tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowIamGetRolePolicy",
      "Effect": "Allow",
      "Action": "iam:GetRolePolicy",
      "Resource": [
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "not-tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "not-tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyEc2CreateVolume",
      "Effect": "Deny",
      "Action": "ec2:CreateVolume",
      "Resource": [
        "forbidden-arn:aws:ec2:*:*:volume/*-specific"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "DenyEc2DeleteTags",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": [
        "authorized/arn:aws:ec2:*:*:key-pair/*/file.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "DenyEc2DetachVolume",
      "Effect": "Deny",
      "Action": "ec2:DetachVolume",
      "Resource": [
        "forbidden-arn:aws:ec2:*:*:security-group/*-specific"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "DenyEc2DeleteSecurityGroup",
      "Effect": "Deny",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": [
        "arn:aws:ec2:*:*:vpc/*-forbidden-resource"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::111222333444:user/david"
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": [
        "authorized/arn:aws:ec2:*:*:instance/*/file.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Sid": "DenyDynamoDbPutItem",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": [
        "authorized/arn:aws:ec2:*:*:subnet/*/file.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    },
    {
      "Sid": "DenyRdsDeleteDBInstance",
      "Effect": "Deny",
      "Action": "rds:DeleteDBInstance",
      "Resource": [
        "forbidden-arn:aws:ec2:*:*:key-pair/*-specific"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/blocked-user"
    },
    {
      "Sid": "DenySnsSubscribe",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*-forbidden-resource"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::111222333444:role/developer-role"
    },
    {
      "Sid": "DenyEc2ModifyInstanceAttribute",
      "Effect": "Deny",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": [
        "authorized/arn:aws:ec2:*:*:vpc/*/file.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::555666777888:role/cross-account-role"
    },
    {
      "Sid": "DenyEc2DeleteSecurityGroup",
      "Effect": "Deny",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": [
        "arn:aws:ec2:*:*:security-group/*-forbidden-resource"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::111222333444:user/david"
    },
    {
      "Sid": "DenyEc2DeleteVolume",
      "Effect": "Deny",
      "Action": "ec2:DeleteVolume",
      "Resource": [
        "forbidden-arn:aws:ec2:*:*:volume/*-specific"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/tkey": "tval"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    }
  ]
}