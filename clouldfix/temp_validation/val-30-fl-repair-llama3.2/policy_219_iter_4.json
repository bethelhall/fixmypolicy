{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "statement1",
      "Effect": "Allow",
      "Action": [
        "guardduty:*",
        "config:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "statement2",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "iam:CreateUser"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "statement3",
      "Effect": "Allow",
      "Action": [
        "iam:CreateGroup",
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement4",
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases",
        "kms:ListGrants"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement5",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "rds:CreateDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "statement6",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:RevokeGrant"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement7",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "sqs:SendMessage"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "statement8",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteUser",
        "iam:GetRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement9",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogStream",
        "s3:PutObject"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "statement10",
      "Effect": "Allow",
      "Action": [
        "iam:ListGroupsForUser",
        "iam:ListUsers"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement11",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteGroup",
        "iam:DeleteRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement12",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRoleToGroup",
        "iam:DetachRoleFromGroup"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement13",
      "Effect": "Allow",
      "Action": [
        "iam:CreateGroup",
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "statement14",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteGroup",
        "iam:DeleteRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    }
  ]
}