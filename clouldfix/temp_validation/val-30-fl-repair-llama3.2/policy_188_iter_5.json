{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockCloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListDashboards",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/Bedrock"
        }
      }
    },
    {
      "Sid": "AllowS3PutObjectAcl",
      "Effect": "Allow",
      "Action": "s3:PutObjectAcl",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/bob"
    },
    {
      "Sid": "AllowSESGetIdentityDkimAttributes",
      "Effect": "Allow",
      "Action": "ses:GetIdentityDkimAttributes",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      },
      "Principal": "arn:aws:iam::123456789012:user/alice"
    },
    {
      "Sid": "AllowAutoscalingCreateAutoScalingGroup",
      "Effect": "Allow",
      "Action": "autoscaling:CreateAutoScalingGroup",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "Principal": "arn:aws:iam::123456789012:role/service-role"
    },
    {
      "Sid": "AllowKMSReEncrypt",
      "Effect": "Allow",
      "Action": "kms:ReEncrypt",
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
