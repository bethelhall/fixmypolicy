{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccessToS3Objects",
      "Effect": "Allow",
      "Action": [
        "s3:*Object",
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>/*"
      ]
    },
    {
      "Sid": "AllowSQSServiceActions",
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteQueue",
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>/file-29-8.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:role/service-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowKMSActions",
      "Effect": "Allow",
      "Action": [
        "kms:CancelKeyDeletion",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>/file-2-8.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/bob"
      ],
      "Condition": {
