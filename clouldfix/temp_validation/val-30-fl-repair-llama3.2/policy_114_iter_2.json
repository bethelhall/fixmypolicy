        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:s3:::denied-bucket-8/file-8.txt"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/test-user"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
