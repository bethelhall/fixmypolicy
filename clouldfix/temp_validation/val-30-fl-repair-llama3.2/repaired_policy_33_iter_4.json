{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Allow EC2 Describe Instances",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Allow Athena Create Work Group",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::113080605540:role/EC2_ROLE_4"
      },
      "Action": "athena:CreateWorkGroup",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow CloudTrail Start Logging",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "cloudtrail:StartLogging",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow EC2 Create Tags",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::717091755573:role/EC2_ROLE_4"
      },
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Deny SQS SendMessage",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "sqs:SendMessage",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "Deny DynamoDB Put Item",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "dynamodb:PutItem",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "Allow Config Describe Config Rules",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "config:DescribeConfigRules",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Deny EC2 Run Instances",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Allow S3 Get Bucket Location",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::889156136598:role/EC2_ROLE_4"
      },
      "Action": "s3:GetBucketLocation",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow CodePipeline List Pipelines",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::882801579060:role/EC2_ROLE_4"
      },
      "Action": "codepipeline:ListPipelines",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow Glue Update Database",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::352497408887:role/EC2_ROLE_4"
      },
      "Action": "glue:UpdateDatabase",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow Athena Stop Query Execution",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::447309106135:role/EC2_ROLE_4"
      },
      "Action": "athena:StopQueryExecution",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Deny SNS Publish",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "sns:Publish",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/Department": "Finance"
        }
      }
    },
    {
      "Sid": "Allow S3 Get Object Acl",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::421223228516:role/EC2_ROLE_4"
      },
      "Action": "s3:GetObjectAcl",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Allow KMS ReEncrypt",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "kms:ReEncrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow EC2 Delete Volume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::401941061003:role/EC2_ROLE_4"
      },
      "Action": "ec2:DeleteVolume",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow SQS Add Permission",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "sqs:AddPermission",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow SageMaker List Notebook Instances",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::637025036204:role/EC2_ROLE_4"
      },
      "Action": "sagemaker:ListNotebookInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "Deny RDS Delete DB Instance",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "rds:DeleteDBInstance",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Deny DynamoDB Delete Item",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "dynamodb:DeleteItem",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "Deny Lambda Invoke Function",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNTID:role/EC2_ROLE_4"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "*",
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "Allow Glue Batch Get Jobs",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "glue:BatchGetJobs",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}