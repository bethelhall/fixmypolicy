      "Principal": {
        "AWS": "arn:aws:iam::695616298991:role/roletest1"
      },
      "Action": "ec2:ImportKeyPair",
      "Resource": "arn:aws:s3tables:us-west-2:123:table-bucket/tabletest/table/file-39-18.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowGlueGetJobRun",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Action": "glue:GetJobRun",
      "Resource": "arn:aws:s3tables:us-west-2:123:table-bucket/tabletest/table/file-12-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCloudFrontGetDistribution",
