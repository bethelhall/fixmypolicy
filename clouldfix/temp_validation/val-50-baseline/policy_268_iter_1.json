{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessForFTP",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::image.k-sale.com",
        "arn:aws:s3:::image.k-sale.com/*"
      ]
    },
    {
      "Sid": "AllowCloudWatchActions",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetDashboard",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowCodeCommitActions",
      "Effect": "Allow",
      "Action": [
        "codecommit:GetRepository"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowEC2Actions",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowElasticLoadBalancingActions",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowIAMActions",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowLambdaActions",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowRDSActions",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowSNSActions",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowSQSActions",
      "Effect": "Allow",
      "Action": [
        "sqs:ChangeMessageVisibilityBatch",
        "sqs:DeleteMessage"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowSageMakerActions",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateEndpoint",
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowGuardDutyActions",
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteIPSet"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowKMSActions",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowLogsActions",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketTagging",
        "s3:GetObjectTagging",
        "s3:PutBucketLifecycle",
        "s3:PutObject",
        "s3:ListObjectVersions"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowSESActions",
      "Effect": "Allow",
      "Action": [
        "ses:ListIdentities"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowWorkSpacesActions",
      "Effect": "Allow",
      "Action": [
        "workspaces:StartWorkspaces"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowAthenaActions",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution",
        "athena:GetQueryExecution"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowCloudWatchLogsActions",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents"
      ],
      "Resource": "*",
      "Principal": "*"
    },
    {
      "Sid": "AllowCodePipelineActions",
      "Effect": "Allow",
      "Action": [
        "codepipeline:StartPipelineExecution"
      ],
      "Resource": "*",
      "Principal": "*"
    }
  ]
}