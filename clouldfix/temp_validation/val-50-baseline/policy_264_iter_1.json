{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111222333444:user/temp-user"
      },
      "Action": "es:DescribeElasticsearchDomains",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/file-19-14.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": "es:DeleteDomain",
      "Resource": "arn:aws:es:us-east-1:000000000000:domain/my-domain/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}