{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "iam:RemoveUserFromGroup",
        "iam:DeleteSigningCertificate",
        "iam:GetUserPolicy",
        "iam:ListUsers",
        "iam:DeleteUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "cloudsearch:DescribeDomains"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Deny",
      "Action": [
        "iam:ListGroupsForUser"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::111222333444:role/developer-role"
        ]
      },
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor4",
      "Effect": "Allow",
      "Action": [
        "glue:GetCrawlers",
        "glue:GetCrawler"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "VisualEditor5",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketCors",
        "s3:PutObjectAcl",
        "s3:GetObjectVersion"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "VisualEditor6",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:UpdateKeyDescription",
        "kms:Encrypt",
        "kms:PutKeyPolicy",
        "kms:ListKeys"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "VisualEditor7",
      "Effect": "Allow",
      "Action": [
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor8",
      "Effect": "Deny",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Condition": {
        "NumericLessThan": {
          "s3:max-keys": "10"
        }
      }
    },
    {
      "Sid": "VisualEditor9",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor10",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "VisualEditor11",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "VisualEditor12",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteGroup"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/test-role"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor13",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/blocked-user"
        ]
      },
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Sid": "VisualEditor14",
      "Effect": "Allow",
      "Action": [
        "kinesis:CreateStream"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "VisualEditor15",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "VisualEditor16",
      "Effect": "Deny",
      "Action": [
        "iam:ListAccessKeys"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::111222333444:role/developer-role"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "VisualEditor17",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/service-role"
        ]
      },
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VisualEditor18",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice",
          "arn:aws:iam::123456789012:user/bob"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "eu-west-1"
          ]
        }
      }
    }
  ]
}