{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessForFTP",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::image.k-sale.com",
        "arn:aws:s3:::image.k-sale.com/*"
      ]
    },
    {
      "Sid": "AllowEC2StopInstances",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowIAMCreateLoginProfile",
      "Effect": "Allow",
      "Action": "iam:CreateLoginProfile",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyS3PutBucketPolicy",
      "Effect": "Deny",
      "Action": "s3:PutBucketPolicy",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/admin-role",
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI"
        }
      }
    },
    {
      "Sid": "AllowCloudTrailCreateTrail",
      "Effect": "Allow",
      "Action": "cloudtrail:CreateTrail",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowCodeBuildStartBuild",
      "Effect": "Allow",
      "Action": "codebuild:StartBuild",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "AllowAthenaGetQueryResultsStream",
      "Effect": "Allow",
      "Action": "athena:GetQueryResultsStream",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowS3DeleteBucketLifecycle",
      "Effect": "Allow",
      "Action": "s3:DeleteBucketLifecycle",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DenyIAMCreateUser",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:user/temp-user",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowSQSDeleteMessage",
      "Effect": "Allow",
      "Action": "sqs:DeleteMessage",
