      "Action": "s3:GetObjectTagging",
      "Resource": "*",
      "Principal": "arn:aws:iam::123456789012:role/test-role",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "AllowIAMDeleteGroup",
      "Effect": "Allow",
