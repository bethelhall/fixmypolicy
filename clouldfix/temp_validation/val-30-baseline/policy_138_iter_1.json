{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllTagNotProd",
      "Effect": "Allow",
      "Action": [
        "*"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/env": "prod"
        }
      },
      "Principal": "*"
    },
    {
      "Sid": "DenyAllTagProd",
      "Effect": "Deny",
      "Action": [
        "*"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": "prod"
        }
      },
      "Principal": "*"
    }
  ]
}