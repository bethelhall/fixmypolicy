{
  "Version": "2012-10-17",
  "Id": "auto-sns-1",
  "Statement": [
    {
      "Sid": "Allow access through SNS for all principals in the account that are authorized to use SNS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "xxxxxxxxxxxx",
          "kms:ViaService": "sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow direct access to key metadata to the account",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::xxxxxxxxxxxx:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:RevokeGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Allow access to SNS for all principals in the account that are authorized to use SNS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:s3:::bucket-3/file-8.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow access to SQS for all principals in the account that are authorized to use SQS",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": [
        "sqs:CreateQueue"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-3/table-24",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "not-sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow access to Route53 for all principals in the account that are authorized to use Route53",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/test-user"
      },
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-7/table-16",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "not-sns.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Allow access to CloudWatch for all principals in the account that are authorized to use CloudWatch",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::361567453596:root"
      },
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "arn:aws:s3:::bucket-4/file-9.txt",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to SES for all principals in the account that are authorized to use SES",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::486757821305:root"
      },
      "Action": [
        "ses:ListIdentities"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-13/table-14",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to CloudFormation for all principals in the account that are authorized to use CloudFormation",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::248284580414:root"
      },
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-16",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    },
    {
      "Sid": "Allow access to S3 for all principals in the account that are authorized to use S3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/blocked-user"
      },
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::bucket-38/file-4.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Allow access to GuardDuty for all principals in the account that are authorized to use GuardDuty",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": [
        "guardduty:DeleteDetector"
      ],
      "Resource": "arn:aws:s3:::bucket-39/file-5.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow access to S3 for all principals in the account that are authorized to use S3",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::555666777888:role/cross-account-role"
      },
      "Action": [
        "s3:DeleteBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::bucket-18/file-9.txt",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "Allow access to Glue for all principals in the account that are authorized to use Glue",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/forbidden-role"
      },
      "Action": [
        "glue:StartCrawler"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-9/table-10",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "not-xxxxxxxxxxxx"
        }
      }
    }
  ]
}