      "Principal": "logs.region.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/wg-32",
      "Principal": "arn:aws:iam::984303426895:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sqs:GetQueueUrl",
      "Resource": "arn:aws:s3:::bucket-19/file-3.txt",
      "Principal": "arn:aws:iam::258181709179:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:DescribeEndpoint",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/db-16/table-24",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLogging",
      "Resource": "arn:aws:s3:::bucket-48/file-5.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::bucket-26/file-3.txt",
      "Principal": "arn:aws:iam::656406070718:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:s3:::admin-bucket/document.txt",
      "Principal": "arn:aws:iam::Your_account_ID:root",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:CreateTable",
      "Resource": "arn:aws:s3:::denied-bucket-7/file-7.txt",
      "Principal": "logs.region.amazonaws.com",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
