      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudwatch:ListMetrics",
      "Resource": "arn:aws:s3:::bucket-43/file-1.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
