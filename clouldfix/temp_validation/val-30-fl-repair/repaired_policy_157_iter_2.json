  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2CreationInfraOwnerTag",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/InfraOwner": "true"
        }
      }
    },
