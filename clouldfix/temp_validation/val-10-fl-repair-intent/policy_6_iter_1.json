{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:PutItem",
        "dynamodb:DescribeStream",
        "dynamodb:GetShardIterator"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:123456789012:table/UserActivity/stream/2024-01-15",
        "arn:aws:dynamodb:us-east-1:123456789012:table/OutputTable",
        "arn:aws:dynamodb:us-west-2:123456789012:table/Events/stream/2024-02-01",
        "arn:aws:dynamodb:eu-west-1:123456789012:table/Logs/stream/2024-03-10"
      ]
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/file.txt",
        "arn:aws:s3:::bucket/data.json",
        "arn:aws:s3:::bucket/old-file.log",
        "arn:aws:s3:::bucket"
      ]
    }
  ]
}