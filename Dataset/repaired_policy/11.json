{
    "Sid": "VisualEditor1",
    "Effect": "Allow",
    "Action": [
        "ec2:*"
    ],
    "Resource": "arn:aws:ec2:*:1234567890:*",
    "Condition": {
        "StringEquals": {
            "aws:PrincipalType": "AssumedRole"
        },
        "StringLike": {
            "aws:userid": "*:kalmesh@xyz.com"
        },
        "ArnEquals": {
            "aws:PrincipalArn": "arn:aws:iam::1234567890:role/accounting-role-name"
        }
    }
}