[
  {
    "Sid": "AllowS3AccessToSaveAndReadQueryResults",
    "Effect": "Allow",
    "Action": [
      "s3:Get*",
      "s3:List*",
      "s3:PutObject",
      "s3:DeleteObject"
    ],
    "Resource": [
      "arn:aws:s3:::athena-query-results",
      "arn:aws:s3:::athena-query-results/*"
    ]
  },
  {
    "Sid": "AllowS3AccessForGlueToReadLogs",
    "Effect": "Allow",
    "Action": [
      "s3:*"
    ],
    "Resource": [
      "arn:aws:s3:::bkt_logs",
      "arn:aws:s3:::bkt_logs/*"
    ]
  },
  {
    "Sid": "AllowAthenaAccess",
    "Effect": "Allow",
    "Action": [
      "athena:GetQueryExecution",
      "athena:StartQueryExecution",
      "athena:StopQueryExecution",
      "athena:GetWorkGroup",
      "athena:GetDatabase",
      "athena:BatchGetQueryExecution",
      "athena:GetQueryResults",
      "athena:GetQueryResultsStream",
      "athena:GetTableMetadata"
    ],
    "Resource": "*"
  },
  {
    "Sid": "AllowGlueAccess",
    "Effect": "Allow",
    "Action": [
      "glue:GetTable",
      "glue:GetDatabase",
      "glue:GetPartitions"
    ],
    "Resource": "*"
  },
  {
    "Sid": "AllowKMSAccess",
    "Effect": "Allow",
    "Action": [
      "kms:CreateGrant",
      "kms:DescribeKey",
      "kms:Decrypt"
    ],
    "Resource": "*"
  }
]
