{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::ACCOUNTID:oidc-provider/gitlab-com"
            },
            "Action": [
                "sts:AssumeRoleWithIdentity",
                "sts:TagSessions"             
            ],
            "Condition": {
                "StringEquals": {
                    "gitlab.com:sub": "project_path:{redacted}:ref_type:tag:ref:main"
                }
            }
        }
    ]
}
