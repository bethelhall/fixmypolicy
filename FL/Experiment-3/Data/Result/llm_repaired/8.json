{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllKMS",
      "Effect": "Allow",
      "Action": ["kms:*"],
      "Resource": "*"
    },
    {
      "Sid": "DenyKMSForRestrictedKeys",
      "Effect": "Deny",
      "Action": ["kms:*"],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "kms:RequestAlias": [
            "alias/*restricted*",
            "alias/*RESTRICTED*"
          ],
          "kms:ResourceAliases": [
            "alias/*restricted*",
            "alias/*RESTRICTED*"
          ]
        }
      }
    },
    {
      "Sid": "AllowKMSDecryptForSpecificResources",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:*:*:key/*"
      ]
    },
    {
      "Sid": "AllowAthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:GetWorkGroup",
        "athena:ListWorkGroups"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowS3AccessForDocument",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowKMSGenerateDataKey",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:*:*:key/*"
      ]
    },
    {
      "Sid": "AllowKMSAliasAndGrantOperations",
      "Effect": "Allow",
      "Action": [
        "kms:DeleteAlias",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:kms:*:*:key/*",
        "arn:aws:kms:*:*:alias/*"
      ]
    },
    {
      "Sid": "AllowGlueTableAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetTables"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:glue:us-east-1:123456789012:database/my-database",
        "arn:aws:glue:us-east-1:123456789012:catalog"
      ]
    },
    {
      "Sid": "DenyLambdaOperations",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function/*"
      ]
    },
    {
      "Sid": "DenyKMSDescribeForForbiddenKey",
      "Effect": "Deny",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Sid": "DenyS3AccessToForbiddenBucket",
      "Effect": "Deny",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::forbidden-bucket"
      ]
    }
  ]
}