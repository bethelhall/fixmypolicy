{
    "Requests": [
        {
            "Effect": "allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::bkt_logs/application-logs/",
                "arn:aws:s3:::bkt_logs/error-logs/error.log",
                "arn:aws:s3:::bkt_logs/access-logs/"
            ]
        }
    ]
}
