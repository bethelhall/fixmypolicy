{
  "Requests": [
    {
      "Effect": "allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::project-logs-2025"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::data-archive",
        "arn:aws:s3:::data-archive/2025/report.parquet"
      ]
    }
  ]
}


