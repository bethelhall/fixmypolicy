{
  "Requests": [
    {
      "Effect": "allow",
      "Action": [
        "iam:PassRole"
      ],
         "Resource": [
        ".*"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "lambda:CreateFunction"
      ],
         "Resource": [
        ".*"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s2:ListAllMyBuckets"
        ],
      "Resource": [
        "arn:aws:s3:::bucket-2"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-3"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "iot:CreateRoleAlias",
        "iot:DescribeRoleAlias",
        "iot:DeleteRoleAlias",
        "iot:TagResource",
        "iam:GetRole"
      ],
      "Resource": [
        ".*"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "iot-device-tester:SendMetrics"
      ],
         "Resource": [
        ".*"
      ]
    },
    {
      "Effect": "allow",
      "Action": [
        "greengrass"
      ],
      "Resource": [
        "arn:aws:greengrass/region/account-id/folder1/folder2/"
      ]
    }
  ]
}
