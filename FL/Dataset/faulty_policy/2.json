
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::accountid:user/test-user"
            },
            "Action": "ssm:TerminateSession",
            "Condition": {
                "StringEquals": {
                    "ssm:StartSession/RequireSSH": "True" 
                }
            }
        }
    ]
}