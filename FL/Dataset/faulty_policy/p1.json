{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "bob",
      "Action": "S3:GetObject",
      "Resource": "foobar/*",
      "Condition": {
        "NumericLessThanEquals": {
          "s3:MaxKeys": 100
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "alice",
      "Action": "S3:ListObject",
      "Resource": ["foobar", "foobar/*"],
      "Condition": {
        "NumericLessThanEquals": {
          "s3:MaxKeys": 20
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "dave",
      "Action": "S3:ListObject",
      "Resource": ["foobar", "foobar/*"],
      "Condition": {
        "NumericLessThanEquals": {
          "s3:MaxKeys": 10
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "charlie",
      "Action": "S3:PutObject",
      "Resource": "foobar/*",
      "Condition": {
        "NumericLessThanEquals": {
          "s3:MaxKeys": 50
        }
      }
    }
  ]
}