{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "VisualEditor0",
            "Effect": "Allow",
            "Action": [
                "iam:GetUser",
                "iam:CreateUser",
                "iam:CreateAccessKey"
            ],
            "Resource": "arn:aws:iam::*:user/iot.*"
        },
        {
            "Sid": "VisualEditor1",
            "Effect": "Allow",
            "Action": "iam:AddUserToGroup",
            "Resource": [
                "arn:aws:iam::*:group/CUSTOMGROUP",
                "arn:aws:iam::*:user/iot.*"
            ],
            "Condition": {
                "StringLike": {
                    "iam:nonexistent-key": "iot.*"
                }
            }
        }
    ]
}