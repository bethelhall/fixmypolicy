{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::ACCOUNTID:oidc-provider/gitlab-com"
            },
            "Action": [
                "sts:AssumeRoleWithIdentity"            
            ],
            "Resource": [
                "data:aws:sts:AssumeRoleWithWebIdentity:arn:aws:iam::ACCOUNTID/*"
            ]
        }
    ]
}
