{
   "Version": "2012-10-17",
   "Statement": [
       {
           "Effect": "Allow",
           "Principal": "apigateway.amazonaws.com",
           "Action": [
               "logs:CreateLogGroup",
               "logs:PutLogEvents",
               "logs:GetLogEvents"
           ],
           "Resource": [
               "arn:aws:logs:eu-west-1:123456789:log-group:API-Gateway-Execution-Logs_alphanum",
               "arn:aws:logs:eu-west-1:123456789:log-group:API-Gateway-Execution-Logs_alphanum/stage:log-stream:*"
           ]
         }
    ]
}
