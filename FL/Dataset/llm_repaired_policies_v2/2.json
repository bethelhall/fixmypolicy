{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ec2:Describe*",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIfExists": {
          "ec2:ResourceTag/Username": "${aws:userid}"
        },
        "Null": {
          "aws:RequestTag/Owner": "true"
        }
      }
    }
  ]
}