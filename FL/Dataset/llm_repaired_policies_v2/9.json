{
  "Version": "2012-10-17",
  "Id": "key-policy",
  "Statement": [
    {
      "Sid": "KMS Key Policy",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::AWS Account ID:root",
          "arn:aws:iam::AWS Account ID:role/EC2 IAM Role"
        ]
      },
      "Action": [
        "kms:*"
      ],
      "Resource": "*"
    }
  ]
}