{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession",
        "iam:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "gitlab.com:sub": [
            "project_path:{redacted}/*:ref_type:branch:ref:*",
            "project_path:{redacted}/ref_type:branch:ref/project1"
          ]
        }
      }
    }
  ]
}