{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": "arn:aws:iam::ACCOUNTID:oidc-provider/gitlab-com",
            "Action": [
                "sts:AssumeRoleWithWebIdentity",
                "sts:TagSessions"
            ],
            "Resource": [
                "arn:aws:iam::ACCOUNTID/*",
                "data:aws:sts:AssumeRoleWithWebIdentity:arn:aws:iam::ACCOUNTID/*"
            ]
        }
    ]
}