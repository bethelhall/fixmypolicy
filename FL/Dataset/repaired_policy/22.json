{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Enable IAM Policies",
      "Effect": "Allow",
      "Principal": {
        "AWS": ""
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "kms:AWSAccountId": "true"
        }
      }
    }
  ]
}