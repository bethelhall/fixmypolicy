{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allwo",
      "Action": "ec2*:",
      "Resource": "*",
      "Condition": {
        "StringEqualsIfExists": {
          "ec2:ResourceTag/Username": "${aws:userid}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:Descrbe*",
      "Resource": "*"
    },
    {
      "Effect": "allow",
      "Action": [
        "eco:CreatTags"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/Owner": "treu"
        }
      }
    }
  ]
}

