{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessToSaveAndReadQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results",
        "arn:aws:s3:::athena-query-results/*"
      ]
    },
    {
      "Sid": "AllowS3AccessForGlueToReadLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bkt_logs",
        "arn:aws:s3:::bkt_logs/*"
      ]
    },
    {
      "Sid": "AllowS3AccessToMyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowAthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDatabase",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:GetTableMetadata"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowGlueAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetPartitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSAccess",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenActions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "s3:DeleteBucket",
        "s3:CreateBucket",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}