{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketSpecificPaths",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::*/logs/app.log",
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::document"
      ]
    },
    {
      "Sid": "AllowCreateBucketSpecific",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::file1"
    },
    {
      "Sid": "AllowDeleteOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/temp/upload.tmp",
        "arn:aws:s3:::file1"
      ]
    },
    {
      "Sid": "AllowGetBucketAcl",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "DenyEC2Actions",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyDynamoDBActions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:PutItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::*-forbidden/*",
        "arn:aws:s3:::different-*/*"
      ]
    },
    {
      "Sid": "DenyPutObjectForbidden",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::*-forbidden/*"
    }
  ]
}