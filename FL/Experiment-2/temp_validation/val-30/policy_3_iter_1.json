{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    },
    {
      "Sid": "AllowLambdaOperations",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowLambdaGetFunction",
      "Effect": "Allow",
      "Action": "lambda:GetFunction",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowLambdaPublishVersion",
      "Effect": "Allow",
      "Action": "lambda:PublishVersion",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTCreateThingGroup",
      "Effect": "Allow",
      "Action": "iot:CreateThingGroup",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTDeleteThingGroup",
      "Effect": "Allow",
      "Action": "iot:DeleteThingGroup",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTDeletePolicy",
      "Effect": "Allow",
      "Action": "iot:DeletePolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTDeleteRoleAlias",
      "Effect": "Allow",
      "Action": "iot:DeleteRoleAlias",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTDeleteCertificate",
      "Effect": "Allow",
      "Action": "iot:DeleteCertificate",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTListThingGroupsForThing",
      "Effect": "Allow",
      "Action": "iot:ListThingGroupsForThing",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowIoTGeneralOperations",
      "Effect": "Allow",
      "Action": [
        "iot:CreateThing",
        "iot:DeleteThing",
        "iot:DescribeThing",
        "iot:DescribeThingGroup",
        "iot:AddThingToThingGroup",
        "iot:RemoveThingFromThingGroup",
        "iot:AttachThingPrincipal",
        "iot:DetachThingPrincipal",
        "iot:UpdateCertificate",
        "iot:CreatePolicy",
        "iot:AttachPolicy",
        "iot:DetachPolicy",
        "iot:GetPolicy",
        "iot:Publish",
        "iot:TagResource",
        "iot:ListThingPrincipals",
        "iot:ListAttachedPolicies",
        "iot:ListTargetsForPolicy",
        "iot:ListThingsInThingGroup",
        "iot:CreateJob",
        "iot:DescribeJob",
        "iot:DescribeJobExecution",
        "iot:CancelJob",
        "iot:DescribeCertificate",
        "iot:Subscribe",
        "iot:Receive",
        "iot:GetThingShadow",
        "iot:UpdateThingShadow",
        "iot:ListThings",
        "iot:DescribeEndpoint",
        "iot:CreateKeysAndCertificate",
        "iot:CreateRoleAlias",
        "iot:DescribeRoleAlias"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowLogsCreateLogStream",
      "Effect": "Allow",
      "Action": "logs:CreateLogStream",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowLogsOperations",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowS3CreateBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowS3GeneralOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:DeleteObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowIAMListEntitiesForPolicy",
      "Effect": "Allow",
      "Action": "iam:ListEntitiesForPolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "*"
      ]
    },
    {
      "Sid": "AllowIAMGeneralOperations",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:TagPolicy",
        "iam:GetPolicy",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowIDTOperations",
      "Effect": "Allow",
      "Action": [
        "iot-device-tester:SendMetrics",
        "iot-device-tester:SupportedVersion",
        "iot-device-tester:LatestIdt",
        "iot-device-tester:CheckVersion",
        "iot-device-tester:DownloadTestSuite"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowGreengrassOperations",
      "Effect": "Allow",
      "Action": "greengrass:*",
      "Resource": "*"
    },
    {
      "Sid": "DenyIoTConnectOnForbiddenKey",
      "Effect": "Deny",
      "Action": "iot:Connect",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyS3ListBucketVersionsOnForbiddenKey",
      "Effect": "Deny",
      "Action": "s3:ListBucketVersions",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyS3PutObjectTaggingOnForbiddenResources",
      "Effect": "Deny",
      "Action": "s3:PutObjectTagging",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    }
  ]
}