{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLogging",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/*"
    },
    {
      "Sid": "AllowIoT",
      "Effect": "Allow",
      "Action": [
        "iot:CreateThing",
        "iot:DeleteThing",
        "iot:DescribeThing",
        "iot:CreateThingGroup",
        "iot:DeleteThingGroup",
        "iot:DescribeThingGroup",
        "iot:AddThingToThingGroup",
        "iot:RemoveThingFromThingGroup",
        "iot:AttachThingPrincipal",
        "iot:DetachThingPrincipal",
        "iot:UpdateCertificate",
        "iot:DeleteCertificate",
        "iot:CreatePolicy",
        "iot:AttachPolicy",
        "iot:DetachPolicy",
        "iot:DeletePolicy",
        "iot:GetPolicy",
        "iot:Publish",
        "iot:TagResource",
        "iot:ListThingPrincipals",
        "iot:ListAttachedPolicies",
        "iot:ListTargetsForPolicy",
        "iot:ListThingGroupsForThing",
        "iot:ListThingsInThingGroup"
      ],
      "Resource": [
        "arn:aws:iot:*:*:thing/*",
        "arn:aws:iot:*:*:thinggroup/*",
        "arn:aws:iot:*:*:policy/*",
        "arn:aws:iot:*:*:certificate/*"
      ]
    },
    {
      "Sid": "AllowIoTJobs",
      "Effect": "Allow",
      "Action": [
        "iot:CreateJob",
        "iot:DescribeJob",
        "iot:DescribeJobExecution",
        "iot:CancelJob"
      ],
      "Resource": [
        "arn:aws:iot:*:*:job/*"
      ]
    },
    {
      "Sid": "AllowIoTCertificates",
      "Effect": "Allow",
      "Action": [
        "iot:CreateCertificate",
        "iot:DescribeCertificate",
        "iot:ListCertificates"
      ],
      "Resource": [
        "arn:aws:iot:*:*:certificate/*"
      ]
    },
    {
      "Sid": "AllowIoTThingShadow",
      "Effect": "Allow",
      "Action": [
        "iot:GetThingShadow",
        "iot:UpdateThingShadow"
      ],
      "Resource": [
        "arn:aws:iot:*:*:thing/*"
      ]
    },
    {
      "Sid": "AllowIoTTopicPublish",
      "Effect": "Allow",
      "Action": [
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topic/*"
      ]
    },
    {
      "Sid": "AllowIoTTopicSubscribe",
      "Effect": "Allow",
      "Action": [
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topic/*"
      ]
    }
  ]
}