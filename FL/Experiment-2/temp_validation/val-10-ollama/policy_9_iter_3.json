{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:root"
      },
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "AllowListGrants",
      "Effect": "Allow",
      "Action": "kms:ListGrants",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:role/EC2 IAM Role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowDescribeKey",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    },
    {
      "Sid": "AllowEncrypt",
      "Effect": "Allow",
      "Action": "kms:Encrypt",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    },
    {
      "Sid": "AllowGenerateDataKey",
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    }
  ]
}