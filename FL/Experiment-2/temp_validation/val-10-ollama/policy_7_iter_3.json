{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    }
  ]
}