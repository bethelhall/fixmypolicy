{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIoTListTargetsPolicy",
      "Effect": "allow",
      "Action": "iot:ListTargetsForPolicy",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTUpdateThingShadow",
      "Effect": "allow",
      "Action": "iot:UpdateThingShadow",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTGetThingShadow",
