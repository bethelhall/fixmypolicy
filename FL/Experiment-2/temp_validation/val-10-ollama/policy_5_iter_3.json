{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRoleWithWebIdentity"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/specific-file.txt"
      ],
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2025-12-31T23:59:59Z"
        }
      }
    }
  ]
}