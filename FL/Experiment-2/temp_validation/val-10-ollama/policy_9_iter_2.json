{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ],
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:root"
      },
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:ListGrants"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Principal": {
        "AWS": "arn:aws:iam::999888777666:role/EC2 IAM Role"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::AWS Accout ID:role/EC2 IAM Role"
      }
    }
  ]
}