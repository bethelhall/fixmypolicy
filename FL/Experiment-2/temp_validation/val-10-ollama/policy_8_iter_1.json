{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ],
      "Principal": {
        "AWS": "arn:aws:iam::${aws:admin:032}:root"
      },
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:admin:032}:root"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:admin:032}:root"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    }
  ]
}