{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIoTCreateRoleAlias",
      "Effect": "Allow",
      "Action": "iot:CreateRoleAlias",
      "Resource": "arn:aws:s3:::my-bucket/document.txt",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/service-role"
      },
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "2024-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "AllowIoTUpdateThingShadow",
      "Effect": "Allow",
      "Action": "iot:UpdateThingShadow",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTGetThingShadow",
      "Effect": "Allow",
      "Action": "iot:GetThingShadow",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTListThings",
      "Effect": "Allow",
      "Action": "iot:ListThings",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTDescribeEndpoint",
      "Effect": "Allow",
      "Action": "iot:DescribeEndpoint",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "AllowIoTCreateKeysAndCertificate",
      "Effect": "Allow",
      "Action": "iot:CreateKeysAndCertificate",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}