{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/*"
      ],
      "Principal": {
        "AWS": [
          "arn:aws:iam::987654321098:user/charlie"
        ]
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/*"
      ],
      "Principal": {
        "AWS": [
          "arn:aws:iam::987654321098:user/charlie"
        ]
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/*"
      ],
      "Principal": {
        "AWS": [
          "arn:aws:iam::987654321098:user/charlie"
        ]
      },
      "Condition": {
        "StringLike": {
          "aws:userid": "AIDAI*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDatabase",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:GetTableMetadata"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetPartitions"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:user/alice"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}