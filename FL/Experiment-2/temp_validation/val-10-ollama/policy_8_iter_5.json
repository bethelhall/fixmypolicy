{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowListAllMyBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowGetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowPutObject",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowDeleteObject",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    },
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/alice"
      }
    }
  ]
}