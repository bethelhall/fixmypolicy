{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessToSaveAndReadQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results",
        "arn:aws:s3:::athena-query-results/*"
      ]
    },
    {
      "Sid": "AllowS3AccessForGlueToReadLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bkt_logs",
        "arn:aws:s3:::bkt_logs/*"
      ]
    },
    {
      "Sid": "AllowS3AccessToMyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowAthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDatabase",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetTableMetadata"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowGlueAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetPartitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSAccess",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenS3Access",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::bkt_logs-forbidden",
        "arn:aws:s3:::bkt_logs-forbidden/*",
        "arn:aws:s3:::different-athena-query-results",
        "arn:aws:s3:::different-athena-query-results/*",
        "arn:aws:s3:::different-bkt_logs",
        "arn:aws:s3:::different-bkt_logs/*",
        "arn:aws:s3:::athena-query-results-forbidden",
        "arn:aws:s3:::athena-query-results-forbidden/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "kms:GenerateDataKey",
        "glue:DeleteDatabase",
        "kms:CreateKey",
        "dynamodb:DeleteItem",
        "kms:ScheduleKeyDeletion",
        "dynamodb:PutItem",
        "ec2:RunInstances",
        "glue:DeleteTable",
        "athena:DeleteWorkGroup",
        "glue:UpdateTable"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyQueryResultsStreamOnForbiddenResources",
      "Effect": "Deny",
      "Action": "athena:GetQueryResultsStream",
      "Resource": [
        "arn:aws:s3:::different-athena-query-results/*",
        "arn:aws:s3:::different-bkt_logs/*",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::athena-query-results-forbidden/*"
      ]
    }
  ]
}