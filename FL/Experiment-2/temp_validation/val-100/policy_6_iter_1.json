{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "iot.amazonaws.com",
            "lambda.amazonaws.com",
            "greengrass.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowS3AbortMultipartUploadIoTDeleteCertificateOnAthena",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "iot:DeleteCertificate"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowLambdaGetFunctionOnS3",
      "Effect": "Allow",
      "Action": "lambda:GetFunction",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowLogsCreateLogGroupIoTSubscribeS3GetBucketLocationOnMultiple",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "iot:Subscribe",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowS3DeleteObjectVersionIoTDetachThingPrincipalOnAthena",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectVersion",
        "iot:DetachThingPrincipal"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIoTListAttachedPoliciesOnAthena",
      "Effect": "Allow",
      "Action": "iot:ListAttachedPolicies",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIoTActionsOnS3",
      "Effect": "Allow",
      "Action": [
        "iot:DetachThingPrincipal",
        "iot:RemoveThingFromThingGroup",
        "iot:DeleteCertificate"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIoTCreateThingOnGlue",
      "Effect": "Allow",
      "Action": "iot:CreateThing",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowIoTDescribeJobOnS3",
      "Effect": "Allow",
      "Action": "iot:DescribeJob",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIoTCreateKeysAndCertificateOnAthena",
      "Effect": "Allow",
      "Action": "iot:CreateKeysAndCertificate",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowS3DeleteObjectIoTDeletePolicyOnMultiple",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "iot:DeletePolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIoTDescribeRoleAliasOnGlue",
      "Effect": "Allow",
      "Action": "iot:DescribeRoleAlias",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowIoTListThingsIamGetRoleOnMultiple",
      "Effect": "Allow",
      "Action": [
        "iot:ListThings",
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIoTAttachThingPrincipalOnMultiple",
      "Effect": "Allow",
      "Action": "iot:AttachThingPrincipal",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowIoTPublishOnS3",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIamDetachRolePolicyListEntitiesForPolicyOnMultiple",
      "Effect": "Allow",
      "Action": [
        "iam:DetachRolePolicy",
        "iam:ListEntitiesForPolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowIoTDescribeJobOnGlue",
      "Effect": "Allow",
      "Action": "iot:DescribeJob",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowS3CreateBucketIoTDescribeRoleAliasDeleteThingOnMultiple",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "iot:DescribeRoleAlias",
        "iot:DeleteThing"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowIamAttachRolePolicyOnMultiple",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowS3DeleteObjectVersionLambdaGetFunctionS3PutObjectOnMultiple",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectVersion",
        "lambda:GetFunction",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowLogsDescribeLogStreamsOnMultiple",
      "Effect": "Allow",
      "Action": "logs:DescribeLogStreams",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowS3ListBucketVersionsOnMultiple",
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowIamDeleteRoleOnAthena",
      "Effect": "Allow",
      "Action": "iam:DeleteRole",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIoTDetachThingPrincipalOnGlue",
      "Effect": "Allow",
      "Action": "iot:DetachThingPrincipal",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowIamDeletePolicyOnGlue",
      "Effect": "Allow",
      "Action": "iam:DeletePolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowIamListAttachedRolePoliciesOnS3",
      "Effect": "Allow",
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowLambdaCreateFunctionS3PutObjectOnAthena",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyS3GetBucketAclOnS3",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyIamGetPolicyOnKMS",
      "Effect": "Deny",
      "Action": "iam:GetPolicy",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyEC2RunInstancesIamAttachUserPolicyOnMultiple",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "iam:AttachUserPolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyIoTListAttachedPoliciesOnForbiddenBucket",
      "Effect": "Deny",
      "Action": "iot:ListAttachedPolicies",
      "Resource": "arn:aws:s3:::forbidden-bucket/*"
    },
    {
      "Sid": "DenyLambdaInvokeFunctionDynamoDBDeleteItemIamListUsersOnMultiple",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "dynamodb:DeleteItem",
        "iam:ListUsers"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyS3ListMultipartUploadPartsOnForbiddenResources",
      "Effect": "Deny",
      "Action": "s3:ListMultipartUploadParts",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    },
    {
      "Sid": "DenyS3GetBucketAclIamAttachUserPolicyDeleteUserOnMultiple",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl",
        "iam:AttachUserPolicy",
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyLogsPutLogEventsOnForbiddenBucket",
      "Effect": "Deny",
      "Action": "logs:PutLogEvents",
      "Resource": "arn:aws:s3:::forbidden-bucket/*"
    },
    {
      "Sid": "DenyS3PutBucketPolicyEC2RunInstancesLambdaUpdateFunctionCodeOnS3",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "ec2:RunInstances",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyIoTListThingsInThingGroupDescribeJobExecutionOnAdminRole",
      "Effect": "Deny",
      "Action": [
        "iot:ListThingsInThingGroup",
        "iot:DescribeJobExecution"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "DenyDynamoDBPutItemDeleteItemOnS3",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyIoTCreateJobUpdateCertificateDeleteRoleAliasOnForbiddenResources",
      "Effect": "Deny",
      "Action": [
        "iot:CreateJob",
        "iot:UpdateCertificate",
        "iot:DeleteRoleAlias"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Sid": "DenyLambdaUpdateFunctionCodeOnS3",
      "Effect": "Deny",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyIoTDeviceTesterSupportedVersionIoTPublishOnKMS",
      "Effect": "Deny",
      "Action": [
        "iot-device-tester:SupportedVersion",
        "iot:Publish"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    }
  ]
}