{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket"
      ]
    },
    {
      "Sid": "AllowS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/*",
        "arn:aws:s3:::my-bucket/*",
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowS3ListAllMyBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "AllowCloudWatchOperations",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedEC2Operations",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:RunInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedDynamoDBOperations",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedIAMOperations",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser",
        "iam:CreateUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedLambdaOperations",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBuckets",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    },
    {
      "Sid": "DenyForbiddenKMSKey",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyAdminRole",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    }
  ]
}