{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "AllowS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:*",
        "ec2:*",
        "iam:*",
        "lambda:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*"
      ]
    }
  ]
}