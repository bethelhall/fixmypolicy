{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActionsOnMyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::my_bucket/*"
      ]
    },
    {
      "Sid": "DenyAllActionsOnMyOtherBucket",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::my_other_bucket/*"
      ]
    }
  ]
}