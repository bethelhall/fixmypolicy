{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIotSubscribeOnAthenaWorkgroupPrimary",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIotPublishOnMyBucketDocumentTxt",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIotDeviceTesterLatestIdtOnAthenaWorkgroupPrimary",
      "Effect": "Allow",
      "Action": "iot-device-tester:LatestIdt",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIotDeviceTesterCheckVersionOnAthenaWorkgroupPrimary",
      "Effect": "Allow",
      "Action": "iot-device-tester:CheckVersion",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIotAttachPolicyOnAthenaWorkgroupPrimary",
      "Effect": "Allow",
      "Action": "iot:AttachPolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIotCreateJobOnMyBucketDocumentTxtAndAthenaWorkgroupPrimary",
      "Effect": "Allow",
      "Action": "iot:CreateJob",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowIotGetThingShadowOnAdminRole",
      "Effect": "Allow",
      "Action": "iot:GetThingShadow",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AllowIotUpdateCertificateOnAdminRole",
      "Effect": "Allow",
      "Action": "iot:UpdateCertificate",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AllowIotListThingPrincipalsOnForbiddenKey",
      "Effect": "Allow",
      "Action": "iot:ListThingPrincipals",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "AllowIotDescribeRoleAliasOnForbiddenKey",
      "Effect": "Allow",
      "Action": "iot:DescribeRoleAlias",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "AllowIotListThingsInThingGroupOnForbiddenBucketDocumentTxt",
      "Effect": "Allow",
      "Action": "iot:ListThingsInThingGroup",
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Sid": "AllowIotGetThingShadowOnAdminRole",
      "Effect": "Allow",
      "Action": "iot:GetThingShadow",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AllowIotUpdateCertificateOnAdminRole",
      "Effect": "Allow",
      "Action": "iot:UpdateCertificate",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "AllowIotListThingPrincipalsOnForbiddenKey",
      "Effect": "Allow",
      "Action": "iot:ListThingPrincipals",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "AllowIotDescribeRoleAliasOnForbiddenKey",
      "Effect": "Allow",
      "Action": "iot:DescribeRoleAlias",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "AllowIotListThingsInThingGroupOnForbiddenBucketDocumentTxt",
      "Effect": "Allow",
      "Action": "iot:ListThingsInThingGroup",
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    }
  ]
}