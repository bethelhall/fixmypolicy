{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowGenerateDataKeyGlue",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:GenerateDataKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "glue.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowDescribeKeyAthena",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:DescribeKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "athena.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowCreateKeyS3",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowDescribeKeyCreateGrantS3",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:DescribeKey",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowListGrantsGlue",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:ListGrants",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "glue.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyScheduleKeyDeletion",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyNonKMSActions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "dynamodb:PutItem",
        "iam:DeleteUser",
        "ec2:RunInstances"
      ],
      "Resource": "*"
    }
  ]
}