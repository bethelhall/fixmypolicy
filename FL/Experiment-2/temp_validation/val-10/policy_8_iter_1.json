{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3DeleteObjectMyBucket",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowCloudWatchGetMetricStats",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*"
    },
    {
      "Sid": "AllowS3GetBucketAcl",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowCloudWatchListMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:ListMetrics",
      "Resource": "*"
    },
    {
      "Sid": "DenyDynamoDBDeleteItem",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "*"
    },
    {
      "Sid": "DenyEC2RunInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": "*"
    },
    {
      "Sid": "DenyS3CreateBucket",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::completely-different-bucket"
    }
  ]
}