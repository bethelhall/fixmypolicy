{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket"
      ]
    },
    {
      "Sid": "AllowS3BucketPolicyOperations",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Sid": "AllowS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/*",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowS3BucketManagement",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket"
      ]
    },
    {
      "Sid": "AllowS3ListAllBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "AllowCloudWatchOperations",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedIAMOperations",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedEC2Operations",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:RunInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedDynamoDBOperations",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedLambdaOperations",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAccessToForbiddenBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    },
    {
      "Sid": "DenyAccessToForbiddenKMSKeys",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyS3OperationsOnIAMResources",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    }
  ]
}