{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3DeleteObjectSpecific",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIoTCreateJobSpecific",
      "Effect": "Allow",
      "Action": "iot:CreateJob",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIoTDeviceTesterLatestIdt",
      "Effect": "Allow",
      "Action": "iot-device-tester:LatestIdt",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIoTCreateThingGroup",
      "Effect": "Allow",
      "Action": "iot:CreateThingGroup",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowLambdaDeleteFunction",
      "Effect": "Allow",
      "Action": "lambda:DeleteFunction",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIoTConnect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowIoTListThingGroupsForThing",
      "Effect": "Allow",
      "Action": "iot:ListThingGroupsForThing",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowS3GetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowIoTAttachPolicy",
      "Effect": "Allow",
      "Action": "iot:AttachPolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyDynamoDBDeleteItem",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyS3DeleteObjectForbidden",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Sid": "DenyIAMAndEC2Actions",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser",
        "ec2:DescribeInstances",
        "iam:CreateUser"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyIoTDetachPolicyForbidden",
      "Effect": "Deny",
      "Action": "iot:DetachPolicy",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    }
  ]
}