{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/*",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyIAMOperations",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBucketCreation",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::completely-different-bucket"
      ]
    },
    {
      "Sid": "DenyNonS3Operations",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDifferentBucketAccess",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::completely-different-bucket/*"
    }
  ]
}