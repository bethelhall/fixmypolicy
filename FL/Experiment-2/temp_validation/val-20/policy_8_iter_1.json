{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3PutBucketPolicyOnGlueTable",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowS3CreateBucketOnBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3ObjectOperationsAndCloudWatchOnBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3ObjectOperationsOnGlueTable",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowS3DeleteBucketOnSpecificResources",
      "Effect": "Allow",
      "Action": "s3:DeleteBucket",
      "Resource": [
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowS3GetObjectOnBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3CreateBucketOnMyBucketDocument",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyDynamoDBLambdaEC2OnS3Resources",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "lambda:CreateFunction",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Sid": "DenyS3GetBucketAclOnForbiddenBucket",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::forbidden-bucket/*"
    },
    {
      "Sid": "DenyIAMCreateUserOnS3Bucket",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::bucket"
    }
  ]
}