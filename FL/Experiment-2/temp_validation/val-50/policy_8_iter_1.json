{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ]
    },
    {
      "Sid": "AllowS3ListOperations",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3BucketPolicy",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowS3GetBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowCloudWatchMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:ListMetrics",
      "Resource": "*"
    },
    {
      "Sid": "DenyLambdaOperations",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIAMOperations",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyEC2Operations",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyDynamoDBOperations",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "*"
    },
    {
      "Sid": "DenyCloudWatchGetMetrics",
      "Effect": "Deny",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBuckets",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    }
  ]
}