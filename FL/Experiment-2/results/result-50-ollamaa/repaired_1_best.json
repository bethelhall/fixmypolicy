{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript",
        "secretsmanager:*"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*"
    },
    {
      "Sid": "stmt2",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:StopNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:Describe*",
        "sagemaker:StartNotebookInstance",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:*"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "stmt3",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:Describe*",
        "sagemaker:StartNotebookInstance"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*"
    },
    {
      "Sid": "fix1",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "fix2",
      "Effect": "Allow",
