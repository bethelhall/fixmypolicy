{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript",
        "secretsmanager:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "stmt2",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:StopNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:Describe*",
        "sagemaker:StartNotebookInstance",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:*"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "stmt3",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:Describe*",
        "sagemaker:StartNotebookInstance"
      ],
      "Resource": "*"
    },
    {
      "Sid": "allow_8f7f3575",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "allow_32a011e1",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "allow_0352a626",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "allow_c2d4a0da",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript",
        "sagemaker:CreatePresignedDomainUrl"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_1ffd028a",
      "Effect": "Deny",
      "Action": [
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "forbidden-arn:aws:sagemaker:::notebook-instance/*-specific"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "not-${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_5b7fc015",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Principal": [
        "arn:aws:iam::987654321098:user/charlie"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_2e16213c",
      "Effect": "Deny",
      "Action": [
        "sagemaker:ListTags"
      ],
      "Resource": [
        "unauthorized/arn:aws:sagemaker:::notebook-instance/*/file.txt"
      ],
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "2024-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "deny_7cb0a9ff",
      "Effect": "Deny",
      "Action": [
        "glue:GetDatabase"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log"
      ],
      "Principal": [
        "arn:aws:iam::555666777888:role/cross-account-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_f52dfb8f",
      "Effect": "Deny",
      "Action": [
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/*-forbidden-resource"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_e9807ee6",
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreatePresignedDomainUrl",
        "glue:CreateScript"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/document.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_7fe36354",
      "Effect": "Deny",
      "Action": [
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "not-${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_d257612d",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ],
      "Principal": [
        "arn:aws:iam::123456789012:user/alice"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    }
  ]
}