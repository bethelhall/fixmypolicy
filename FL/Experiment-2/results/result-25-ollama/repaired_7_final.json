{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "allow_4193f4bf",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
