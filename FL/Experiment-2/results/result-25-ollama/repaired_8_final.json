{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:admin:032}:root"
      },
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "stmt2",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "stmt3",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "stmt4",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "stmt5",
      "Effect": "Deny",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "stmt5",
      "Effect": "Deny",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "allow_53db5e5e",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Principal": "arn:aws:iam::999888777666:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "not-['home/${aws:userid}/', 'home/${aws:username}']"
          ]
        }
      }
    },
    {
      "Sid": "allow_312f8eb0",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ],
      "Principal": "arn:aws:iam::${aws:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "allow_822a3d71",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ],
      "Principal": "arn:aws:iam::${aws:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "allow_f59c26d4",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/document.txt"
      ],
      "Principal": "arn:aws:iam::${aws:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "allow_b6af23a1",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_394be10e",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::different-bucket/file.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_60c23b88",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_602a26c5",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::different-bucket/file.txt"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_ea7a5291",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket"
      ],
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "not-${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_e685ea8c",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "not-['home/${aws:userid}/', 'home/${aws:username}']"
          ]
        }
      }
    }
  ]
}