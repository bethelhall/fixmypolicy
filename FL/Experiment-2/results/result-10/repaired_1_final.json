{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGlueCreateScript",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSecretsManagerAccess",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSageMakerSpecificResources",
      "Effect": "Allow",
      "Action": [
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowSageMakerOwnedResources",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:StopNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:Describe*",
        "sagemaker:StartNotebookInstance",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        },
        "StringNotLike": {
          "aws:RequestedRegion": "arn:aws:sagemaker:::notebook-instance/*-forbidden"
        }
      }
    },
    {
      "Sid": "AllowSageMakerDescribeAndList",
      "Effect": "Allow",
      "Action": [
        "sagemaker:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenNotebookInstances",
      "Effect": "Deny",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*-forbidden"
    },
    {
      "Sid": "DenyEC2DescribeInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    }
  ]
}