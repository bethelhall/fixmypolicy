{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActionsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions",
        "iot:CreatePolicy",
        "iot:DeletePolicy",
        "s3:ListMultipartUploadParts",
        "iot:Connect",
        "s3:PutBucketTagging",
        "iot-device-tester:LatestIdt",
        "iot:ListAttachedPolicies",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowSpecificActionsOnGlueTable",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "iot:CreateKeysAndCertificate",
        "iot:Publish",
        "s3:GetObject",
        "logs:CreateLogGroup",
        "iot:AttachThingPrincipal",
        "s3:DeleteObject",
        "iam:CreatePolicy",
        "iot:ListTargetsForPolicy",
        "iot:DeleteThingGroup",
        "iam:GetRole"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowSpecificActionsOnS3Document",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "iot:CreateKeysAndCertificate",
        "iot:Publish",
        "s3:AbortMultipartUpload",
        "logs:PutLogEvents",
        "iot:DescribeThing",
        "lambda:CreateFunction",
        "iot:CancelJob",
        "iot-device-tester:DownloadTestSuite",
        "iot:GetThingShadow"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowPassRoleToSpecificServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "iot.amazonaws.com",
            "lambda.amazonaws.com",
            "greengrass.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyForbiddenActionsOnForbiddenResources",
      "Effect": "Deny",
      "Action": [
        "iot:DeleteThing",
        "s3:DeleteObject",
        "iot:DescribeRoleAlias",
        "iot-device-tester:CheckVersion",
        "iot:GetPolicy"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Sid": "DenySpecificActionsOnAllowedResources",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "iam:CreateUser",
        "dynamodb:PutItem",
        "lambda:UpdateFunctionCode",
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyCreateThingOnAdminRole",
      "Effect": "Deny",
      "Action": "iot:CreateThing",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    }
  ]
}