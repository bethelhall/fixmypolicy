{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGlueCreateScript",
      "Effect": "Allow",
      "Action": "glue:CreateScript",
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowSageMakerListTags",
      "Effect": "Allow",
      "Action": "sagemaker:ListTags",
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:sagemaker:::notebook-instance/logs/app.log"
      ]
    },
    {
      "Sid": "AllowSageMakerStopNotebookInstance",
      "Effect": "Allow",
      "Action": "sagemaker:StopNotebookInstance",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Sid": "AllowSageMakerDeleteNotebookInstance",
      "Effect": "Allow",
      "Action": "sagemaker:DeleteNotebookInstance",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowSageMakerCreatePresignedDomainUrl",
      "Effect": "Allow",
      "Action": "sagemaker:CreatePresignedDomainUrl",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowSageMakerStartNotebookInstance",
      "Effect": "Allow",
      "Action": "sagemaker:StartNotebookInstance",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser",
        "glue:DeleteDatabase",
        "ec2:RunInstances",
        "glue:GetPartitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:iam::123456789012:role/admin-role",
        "forbidden-arn:aws:sagemaker:::notebook-instance/*",
        "unauthorized/arn:aws:sagemaker:::notebook-instance/*"
      ]
    }
  ]
}