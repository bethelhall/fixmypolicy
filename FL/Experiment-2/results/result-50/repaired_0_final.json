{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessToSaveAndReadQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results",
        "arn:aws:s3:::athena-query-results/*"
      ]
    },
    {
      "Sid": "AllowS3AccessForGlueToReadLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bkt_logs",
        "arn:aws:s3:::bkt_logs/*"
      ]
    },
    {
      "Sid": "AllowS3AccessToMyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowAthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDatabase",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:GetTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:athena:*:*:datacatalog/*",
        "arn:aws:athena:*:*:database/*"
      ]
    },
    {
      "Sid": "AllowGlueAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:catalog",
        "arn:aws:glue:us-east-1:123456789012:database/*",
        "arn:aws:glue:us-east-1:123456789012:table/*/*"
      ]
    },
    {
      "Sid": "AllowKMSAccess",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCrossServiceActions",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetBucketAcl",
        "athena:GetDatabase",
        "athena:GetQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetQueryResults",
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bkt_logs/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bkt_logs/temp/upload.tmp",
        "arn:aws:s3:::bkt_logs/document.txt",
        "arn:aws:s3:::athena-query-results/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyUnauthorizedS3Access",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:s3:::different-bkt_logs/*",
        "arn:aws:s3:::different-athena-query-results/*",
        "arn:aws:s3:::athena-query-results-forbidden/*"
      ]
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "glue:UpdateTable",
        "ec2:RunInstances",
        "athena:CreateWorkGroup",
        "iam:DeleteUser",
        "glue:CreateDatabase"
      ],
      "Resource": "*"
    }
  ]
}