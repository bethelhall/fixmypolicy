{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "stmt1",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:admin:032}:root"
      },
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "stmt2",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "stmt3",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "stmt4",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "stmt5",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "stmt6",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_6b6161f1",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:s3:::bucket",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "2024-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "deny_21e36956",
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::bucket/logs/app.log",
      "Principal": "arn:aws:iam::${aws:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_9fdc0fb8",
      "Effect": "Deny",
      "Action": "lambda:CreateFunction",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/logs/app.log"
      ],
      "Principal": "arn:aws:iam::${aws:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_263b4c6d",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/logs/app.log"
      ],
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_6a772e4e",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::bucket-forbidden/file.txt",
      "Principal": "arn:aws:iam::999888777666:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_b76903f1",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "deny_469f051f",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "arn:aws:s3:::bucket-forbidden/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/bob",
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "2024-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "deny_2ec317aa",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:ListMetrics",
        "s3:PutObject",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::different-bucket/file.txt",
      "Principal": "arn:aws:iam::999888777666:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "not-${identitystore:UserId}"
        }
      }
    },
    {
      "Sid": "deny_16a76dee",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::different-bucket/file.txt",
      "Principal": "arn:aws:iam::123456789012:user/alice",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "deny_79e15596",
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role",
      "Principal": "arn:aws:iam::999888777666:admin:032}:root",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "not-${identitystore:UserId}"
        }
      }
    }
  ]
}