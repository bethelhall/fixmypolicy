            "home/${aws:userid}/",
            "home/${aws:username}"
          ]
        }
      }
    },
    {
      "Sid": "stmt3",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricStatistics"
      ],
