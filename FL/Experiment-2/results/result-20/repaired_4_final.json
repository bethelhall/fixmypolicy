{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDocumentBucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:PutBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "AllowDocumentBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::document/*"
    },
    {
      "Sid": "AllowData123BucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::data123"
    },
    {
      "Sid": "AllowDataFileAccess",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::*/data/file.json"
    },
    {
      "Sid": "DenyPutObjectDifferentBuckets",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::different-*/*"
    },
    {
      "Sid": "DenyGetBucketLocationDifferentBucket",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::completely-different-bucket/*"
    }
  ]
}