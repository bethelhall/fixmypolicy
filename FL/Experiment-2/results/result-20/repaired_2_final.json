{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2ActionsOnS3Document",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:CreateSecurityGroup",
        "ec2:RunInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowEC2ActionsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DescribeInstances",
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowEC2ActionsOnGlueTable",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyDynamoDBActions",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyEC2ActionsOnIAMRole",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "DenyEC2CreateSecurityGroupOnForbiddenResources",
      "Effect": "Deny",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Sid": "DenyIAMDeleteUser",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    }
  ]
}