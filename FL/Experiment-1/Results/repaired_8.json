{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "allow_8d8dcbfc",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "cloudwatch:GetMetricStatistics",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "allow_f5645373",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "allow_d367aa44",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "deny_37620eb5",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "deny_cc04d70a",
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}