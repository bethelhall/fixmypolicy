{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRequiredActions1",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "s3:GetBucketLocation",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowRequiredActions2",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeCertificate",
        "iot:ListAttachedPolicies",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowRequiredActions3",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenySpecificActions1",
      "Effect": "Deny",
      "Action": "iam:ListUsers",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenySpecificActions2",
      "Effect": "Deny",
      "Action": [
        "iot:ListTargetsForPolicy",
        "iot-device-tester:SupportedVersion",
        "iot:DeleteCertificate"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}