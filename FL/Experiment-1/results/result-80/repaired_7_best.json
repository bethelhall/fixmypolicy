{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ]
    },
    {
      "Sid": "AllowBucketPolicyOperations",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyDeleteBucket",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyBucketAclOnBucket",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyPutObjectOnSpecificPaths",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Sid": "DenyGetObjectOnBucket",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyDeleteObjectOnBucket",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyPutBucketPolicyOnBucket",
      "Effect": "Deny",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyGetBucketAclOnDocument",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bucket/document.txt"
    },
    {
      "Sid": "DenyListBucketOnSpecificPaths",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Sid": "DenyCreateBucketOnDataFile",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::bucket/data/file.json"
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "ec2:*",
        "lambda:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*"
      ]
    }
  ]
}