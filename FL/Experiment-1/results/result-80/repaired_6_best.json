{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "iot.amazonaws.com",
            "lambda.amazonaws.com",
            "greengrass.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": "iot:ListThingGroupsForThing",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DeleteCertificate",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:TagPolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectTagging",
        "iam:ListAttachedRolePolicies",
        "iot:DescribeThing"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:DeletePolicy",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:DeleteRoleAlias",
        "iam:GetRole"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "iot:CreatePolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DetachPolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:CreateRoleAlias",
        "iot:DescribeJobExecution",
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "lambda:PublishVersion",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:ListEntitiesForPolicy",
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:DeleteThingGroup",
        "iot:DescribeEndpoint",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot-device-tester:CheckVersion",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DeletePolicy",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iam:DetachRolePolicy",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "iot:UpdateThingShadow",
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iot:CreateKeysAndCertificate",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:DeleteFunction",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "iam:AttachUserPolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:AddThingToThingGroup",
        "iot:DescribeThingGroup",
        "iot:ListThingPrincipals"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DeleteCertificate",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:TagResource",
        "iot:ListAttachedPolicies"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iot:DeleteThing",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "lambda:GetFunction",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:CreateRoleAlias",
        "iot:DeleteRoleAlias",
        "iot:ListThingsInThingGroup"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DetachThingPrincipal",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "lambda:PublishVersion",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Effect": "Deny",
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "iot:ListThingsInThingGroup",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "iot:CancelJob",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    }
  ]
}