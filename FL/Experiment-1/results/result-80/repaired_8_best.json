{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:GetBucketAcl",
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:s3:::completely-different-bucket/file.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bucket",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:s3:::bucket/document.txt"
      ]
    }
  ]
}