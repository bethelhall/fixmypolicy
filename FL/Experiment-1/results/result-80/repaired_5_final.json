{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAssumeRoleWithWebIdentity",
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Resource": "arn:aws:s3:::my-bucket/specific-file.txt",
      "Condition": {
        "StringLike": {
          "gitlab.com:sub": "project_path:{redacted}/*:ref_type:branch:ref:*"
        }
      }
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "lambda:InvokeFunction",
        "ec2:RunInstances",
        "ec2:DescribeInstances",
        "iam:CreateUser",
        "iam:DeleteUser",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "*"
    }
  ]
}