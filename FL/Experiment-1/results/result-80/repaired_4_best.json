{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/temp/upload.tmp",
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log",
        "arn:aws:s3:::*/document.txt"
      ]
    },
    {
      "Sid": "DenyForbiddenActions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "iam:DeleteUser",
        "s3:GetBucketAcl",
        "dynamodb:PutItem",
        "ec2:RunInstances",
        "s3:DeleteObject",
        "ec2:DescribeInstances",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketLocation",
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*-forbidden/*",
        "arn:aws:s3:::document",
        "arn:aws:s3:::different-*/*",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/temp/upload.tmp"
      ]
    }
  ]
}