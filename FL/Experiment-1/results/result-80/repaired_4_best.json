{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateBucketDocument",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "AllowCreateBucketFile1",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::file1"
    },
    {
      "Sid": "AllowDeleteObjectData123",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::data123/*"
    },
    {
      "Sid": "AllowPutObjectFile1",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::file1/*"
    },
    {
      "Sid": "AllowGetBucketLocationFile1",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::file1"
    },
    {
      "Sid": "AllowPutObjectDataFile",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::*/data/file.json"
    },
    {
      "Sid": "AllowDeleteBucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::file1",
        "arn:aws:s3:::data123"
      ]
    },
    {
      "Sid": "AllowPutBucketPolicyDocument",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "AllowGetBucketLocationDocument",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "AllowDeleteObjectDocumentTxt",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::*/document.txt"
    },
    {
      "Sid": "AllowPutObjectDocument",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::document/*"
    },
    {
      "Sid": "AllowGetBucketAclOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::data123"
      ]
    },
    {
      "Sid": "AllowPutObjectData123",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::data123/*"
    },
    {
      "Sid": "DenyGetPutObjectFile1",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::file1/*"
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "dynamodb:PutItem",
        "iam:CreateUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyGetBucketLocationData123",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::data123"
    },
    {
      "Sid": "DenyDeleteObjectDocument",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::document/*"
    },
    {
      "Sid": "DenyCreateDeleteBucketDocument",
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::document"
    },
    {
      "Sid": "DenyDifferentBucketOperations",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:DeleteObject",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::different-*/file.txt"
    },
    {
      "Sid": "DenyPutBucketPolicyListBucketData123",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::data123"
    },
    {
      "Sid": "DenyGetBucketLocationFile1LogsApp",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "DenyDeleteBucketFile1TempUpload",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": [
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyGetBucketAclFile1",
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::file1"
    },
    {
      "Sid": "DenyPutBucketPolicyLogsApp",
      "Effect": "Deny",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::*/logs/app.log"
    },
    {
      "Sid": "DenyCreateBucketDocumentTxtData123",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::data123"
      ]
    },
    {
      "Sid": "DenyGetBucketLocationDataFileDocumentTxt",
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::*/document.txt"
      ]
    }
  ]
}