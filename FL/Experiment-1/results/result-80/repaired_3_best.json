{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActions",
      "Effect": "Allow",
      "Action": [
        "iot:CreateThingGroup",
        "iot:ListTargetsForPolicy",
        "iot:DetachPolicy",
        "iot:DescribeRoleAlias",
        "s3:PutBucketTagging",
        "iam:CreateRole",
        "iam:PassRole",
        "iot:DescribeJobExecution",
        "iot:TagResource",
        "iot:RemoveThingFromThingGroup",
        "s3:ListBucketVersions",
        "iot:ListThingsInThingGroup",
        "s3:ListMultipartUploadParts",
        "iot:DescribeJob",
        "iot:Subscribe",
        "iot:UpdateThingShadow",
        "iam:GetRole",
        "s3:PutObjectTagging",
        "iam:AttachRolePolicy",
        "iot:CreateThing",
        "iot:GetThingShadow",
        "iam:TagPolicy",
        "iot-device-tester:SendMetrics",
        "iot:DeleteCertificate",
        "iot-device-tester:SupportedVersion",
        "s3:DeleteBucket",
        "iot-device-tester:CheckVersion"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "iam:ListUsers",
        "dynamodb:DeleteItem",
        "iot:CreateRoleAlias",
        "lambda:UpdateFunctionCode",
        "iot:AttachThingPrincipal",
        "lambda:InvokeFunction",
        "iam:GetPolicy",
        "s3:DeleteObject",
        "ec2:RunInstances",
        "iam:AttachUserPolicy",
        "iot:RemoveThingFromThingGroup",
        "ec2:DescribeInstances",
        "iot:DeleteThing",
        "iam:DeleteUser",
        "iot:ListThingPrincipals"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    },
    {
      "Sid": "DenySpecificActionsOnAdminRole",
      "Effect": "Deny",
      "Action": [
        "iot:AttachThingPrincipal",
        "iam:AttachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}