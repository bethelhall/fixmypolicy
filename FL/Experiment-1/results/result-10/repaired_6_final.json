{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "allow103cd21f",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "iam:CreatePolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "allow1cc501e1",
      "Effect": "Allow",
      "Action": "iot:DescribeEndpoint",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "allowde656c65",
      "Effect": "Allow",
      "Action": "lambda:GetFunction",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "denyd7215614",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "denyb7a6f890",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "deny119826a4",
      "Effect": "Deny",
      "Action": "ec2:DescribeInstances",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    }
  ]
