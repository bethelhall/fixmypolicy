      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Sid": "allow_e7d6727d",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Sid": "allow_021f6cba",
      "Effect": "Allow",
      "Action": [
