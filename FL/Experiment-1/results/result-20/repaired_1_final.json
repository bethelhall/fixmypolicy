{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGlueCreateScript",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSecretsManagerAccess",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowRequiredSageMakerActions",
      "Effect": "Allow",
      "Action": [
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowSageMakerDescribeActions",
      "Effect": "Allow",
      "Action": [
        "sagemaker:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSageMakerStartNotebookInstance",
      "Effect": "Allow",
      "Action": [
        "sagemaker:StartNotebookInstance"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*",
      "Condition": {
        "StringNotLike": {
          "aws:RequestedRegion": "*-forbidden"
        }
      }
    },
    {
      "Sid": "DenyForbiddenSageMakerActions",
      "Effect": "Deny",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": "arn:aws:sagemaker:::notebook-instance/*-forbidden"
    },
    {
      "Sid": "DenyEC2DescribeInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyLambdaCreateFunction",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    }
  ]
}