{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateRoleOnS3Document",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowIoTActionsOnGlueTable",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeEndpoint",
        "iot:AttachPolicy"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowDetachRolePolicyOnAthenaWorkgroup",
      "Effect": "Allow",
      "Action": "iam:DetachRolePolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowDescribeThingOnSpecificResources",
      "Effect": "Allow",
      "Action": "iot:DescribeThing",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyAttachUserPolicyAndGetBucketAclOnGlueTable",
      "Effect": "Deny",
      "Action": [
        "iam:AttachUserPolicy",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyS3GetObjectOnForbiddenResources",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    }
  ]
}