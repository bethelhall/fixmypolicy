      "Action": [
        "iot:DeleteThingGroup",
        "logs:CreateLogStream",
        "lambda:GetFunction"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "Allow888c717b",
      "Effect": "Allow",
      "Action": [
        "lambda:PublishVersion",
        "iot:DeletePolicy",
        "iot:DeleteRoleAlias"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "Allow6a200846",
      "Effect": "Allow",
