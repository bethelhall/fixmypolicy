{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "allow_4308a97f",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "allow_484da217",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket"
      ]
    },
    {
      "Sid": "allow_dc82eb1a",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "allow_cafc34c7",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl",
        "s3:ListAllMyBuckets",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket",
        "*"
      ]
    },
    {
      "Sid": "allow_c4d97c5e",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Sid": "allow_5e00a1f1",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "allow_cf7fb95d",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "allow_7e3e42cc",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bucket/*"
    },
    {
      "Sid": "deny_83f44b79",
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bucket/data/file.json"
      ]
    },
    {
      "Sid": "deny_3f5cc561",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:ListMetrics",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::forbidden-bucket/*"
    },
    {
      "Sid": "deny_5996c4fb",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "deny_cb44fbd9",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    },
    {
      "Sid": "deny_cd27131f",
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::bucket/temp/upload.tmp"
    },
    {
      "Sid": "deny_fdf37fad",
      "Effect": "Deny",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::completely-different-bucket/*"
    },
    {
      "Sid": "deny_822d0231",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:s3:::bucket"
    }
  ]
}