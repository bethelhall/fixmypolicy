{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:PutObject",
        "s3:PutBucketPolicy",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "iam:CreateUser",
        "lambda:CreateFunction",
        "ec2:RunInstances",
        "iam:DeleteUser",
        "ec2:DescribeInstances",
        "lambda:InvokeFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:ListBucket",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    }
  ]
}