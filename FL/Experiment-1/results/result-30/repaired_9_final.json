{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCf7fa08b",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:CreateKey",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "Allow875d8f19",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:CreateGrant",
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowE8489390",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:GenerateDataKeyWithoutPlaintext",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "Allow231528c2",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:ListGrants",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowA2dd3caa",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:GenerateDataKey",
        "kms:RevokeGrant"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowBa380029",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:GenerateDataKeyWithoutPlaintext",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowE8dd7be5",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "kms:DeleteAlias",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyBcafc15d",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "ec2:RunInstances",
        "iam:CreateUser",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "Deny38b76c9c",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:RevokeGrant",
        "kms:ScheduleKeyDeletion",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    }
  ]
}