{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGlueDatabaseAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/logs/app.log"
      ]
    },
    {
      "Sid": "AllowAthenaBatchQueryExecution",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowMultipleActionsOnSpecificResources",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "athena:GetDatabase",
        "athena:GetQueryExecution"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bkt_logs/logs/app.log"
      ]
    },
    {
      "Sid": "AllowS3GetObjectOnQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/data/file.json"
      ]
    },
    {
      "Sid": "AllowS3BucketLocationAndAthenaQuery",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "athena:GetQueryExecution"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bkt_logs/document.txt"
      ]
    },
    {
      "Sid": "AllowGlueGetTableOnQueryResults",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/logs/app.log"
      ]
    },
    {
      "Sid": "AllowAthenaQueryExecutionOnTemp",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyDynamoDBPutItem",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyS3ActionsOnForbiddenResources",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:GetObject",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Sid": "DenyKMSScheduleKeyDeletion",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyActionsOnForbiddenKey",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation",
        "glue:GetTable"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Sid": "DenyDynamoDBDeleteItem",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:s3:::bkt_logs/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyListBucketOnForbiddenBucket",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}