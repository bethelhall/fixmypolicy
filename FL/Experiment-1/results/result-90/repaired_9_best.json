{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSOperationsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:DeleteAlias",
        "kms:ScheduleKeyDeletion",
        "kms:CreateKey",
        "kms:GenerateDataKey",
        "kms:RevokeGrant",
        "kms:ListGrants",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowKMSOperationsOnGlueTable",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GenerateDataKey",
        "kms:CreateKey",
        "kms:Encrypt",
        "kms:DescribeKey",
        "kms:RevokeGrant",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowKMSOperationsOnS3Object",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:GenerateDataKey",
        "kms:ListGrants",
        "kms:ScheduleKeyDeletion",
        "kms:CreateKey",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:CreateGrant",
        "kms:RevokeGrant",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyNonKMSActions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "iam:DeleteUser",
        "dynamodb:DeleteItem",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenKeyAccess",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:DescribeKey",
        "kms:Encrypt"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyForbiddenBucketAccess",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:CreateKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Sid": "DenyAdminRoleAccess",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:DeleteAlias",
        "kms:CreateKey"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    }
  ]
}