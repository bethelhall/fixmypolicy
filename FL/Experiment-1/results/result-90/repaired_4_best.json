{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::data123/*",
        "arn:aws:s3:::document",
        "arn:aws:s3:::document/*",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::file1/*",
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::document"
      ]
    },
    {
      "Sid": "DenyListCreateOnSpecificResources",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyDeleteObjectOnSpecificResources",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::data123/*"
      ]
    },
    {
      "Sid": "DenyGetBucketLocation",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::document"
      ]
    },
    {
      "Sid": "DenyPutObjectGetBucketAcl",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::document"
      ]
    },
    {
      "Sid": "DenyPutBucketPolicyOnSpecific",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "DenyGetObjectListBucketDeleteBucket",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "iam:DeleteUser",
        "dynamodb:DeleteItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenBuckets",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::*-forbidden/*",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    }
  ]
}