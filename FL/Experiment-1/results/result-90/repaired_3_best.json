{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActions",
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:DescribeCertificate",
        "lambda:GetFunction",
        "iot:DeleteThingGroup",
        "iot-device-tester:CheckVersion",
        "iot:ListThingPrincipals",
        "iot:GetThingShadow",
        "iam:PassRole",
        "iot:ListTargetsForPolicy",
        "iot:DescribeJob",
        "iam:TagRole",
        "iot:TagResource",
        "logs:CreateLogGroup",
        "s3:GetBucketLocation",
        "iot:CreateKeysAndCertificate",
        "iot-device-tester:LatestIdt",
        "iam:GetRole",
        "logs:CreateLogStream",
        "iot:DeleteThing",
        "lambda:CreateFunction",
        "s3:GetObject",
        "iot:ListThingsInThingGroup",
        "iam:DeleteRole",
        "iot:UpdateThingShadow",
        "s3:ListBucketVersions",
        "lambda:PublishVersion",
        "iam:DetachRolePolicy",
        "iot:RemoveThingFromThingGroup",
        "iot:DeleteCertificate",
        "iot:Subscribe",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "iot:CancelJob",
        "iot:DeletePolicy",
        "iot:DeleteRoleAlias",
        "iot:CreateThingGroup",
        "s3:AbortMultipartUpload",
        "lambda:InvokeFunction",
        "iot-device-tester:SupportedVersion",
        "s3:PutObject",
        "iot:ListAttachedPolicies",
        "iam:DeletePolicy",
        "iot-device-tester:DownloadTestSuite",
        "iot:GetPolicy",
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Sid": "DenyForbiddenResources",
      "Effect": "Deny",
      "Action": [
        "iam:TagRole",
        "iot:UpdateThingShadow",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Sid": "DenyForbiddenKMSKey",
      "Effect": "Deny",
      "Action": "iam:TagPolicy",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyGlueS3ListBucketVersions",
      "Effect": "Deny",
      "Action": "s3:ListBucketVersions",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    }
  ]
}