{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketOperations",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "ec2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*"
      ]
    },
    {
      "Sid": "DenySpecificBucketActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenySpecificObjectActions",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenyBucketActionsOnObjects",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::bucket/*"
    }
  ]
}