{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Condition": {
        "StringLike": {
          "gitlab.com:sub": "project_path:{redacted}/*:ref_type:branch:ref:*"
        }
      }
    }
  ]
}