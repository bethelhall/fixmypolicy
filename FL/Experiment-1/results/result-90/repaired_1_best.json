{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:StopNotebookInstance",
        "sagemaker:UpdateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:UpdateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:StopNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:UpdateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:CreatePresignedDomainUrl"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:StartNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": [
        "forbidden-arn:aws:sagemaker:::notebook-instance/*-specific"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:UpdateNotebookInstance"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:UpdateNotebookInstance"
      ],
      "Resource": [
        "unauthorized/arn:aws:sagemaker:::notebook-instance/*/file.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "glue:DeleteDatabase"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "glue:CreateScript",
        "sagemaker:CreatePresignedDomainUrl"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "glue:CreateScript"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "glue:CreateScript",
        "sagemaker:ListTags",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp"
      ]
    }
  ]
}