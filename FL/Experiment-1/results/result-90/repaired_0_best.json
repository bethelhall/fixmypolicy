{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3ActionsOnSpecificBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results",
        "arn:aws:s3:::athena-query-results/*",
        "arn:aws:s3:::bkt_logs",
        "arn:aws:s3:::bkt_logs/*",
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowAthenaActions",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution",
        "athena:GetDatabase",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:athena:*:*:datacatalog/*",
        "arn:aws:athena:*:*:database/*"
      ]
    },
    {
      "Sid": "AllowGlueActions",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetPartitions",
        "glue:GetTable"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:catalog",
        "arn:aws:glue:us-east-1:123456789012:database/my-database",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowKMSActions",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnauthorizedS3Actions",
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::different-athena-query-results/*",
        "arn:aws:s3:::bkt_logs-forbidden/*",
        "arn:aws:s3:::completely-different-bucket/*"
      ]
    },
    {
      "Sid": "DenyUnauthorizedKMSActions",
      "Effect": "Deny",
      "Action": [
        "kms:CreateKey",
        "kms:DeleteAlias",
        "kms:Encrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySpecificActionResourceCombinations",
      "Effect": "Deny",
      "Action": [
        "athena:StartQueryExecution",
        "athena:StopQueryExecution"
      ],
      "Resource": "*"
    }
  ]
}