{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificIoTActions",
      "Effect": "Allow",
      "Action": [
        "iot:ListThingGroupsForThing",
        "iot:DeletePolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowS3DeleteObjectVersion",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIoTDescribeJob",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeJob"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowIAMListEntitiesForPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:ListEntitiesForPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIAMGetRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowIAMDeleteRoleAndS3DeleteObject",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowS3PutBucketTaggingAndIoTListThingGroups",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging",
        "iot:ListThingGroupsForThing"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowLambdaPublishVersionAndIoTDetachThingPrincipal",
      "Effect": "Allow",
      "Action": [
        "lambda:PublishVersion",
        "iot:DetachThingPrincipal"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowLogsCreateLogStreamAndIoTDeleteCertificate",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "iot:DeleteCertificate"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowIoTDeviceTesterLatestIdtAndIAMTagPolicy",
      "Effect": "Allow",
      "Action": [
        "iot-device-tester:LatestIdt",
        "iam:TagPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "AllowIoTListTargetsForPolicy",
      "Effect": "Allow",
      "Action": [
        "iot:ListTargetsForPolicy"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyLambdaInvokeFunction",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyActionsOnForbiddenBucket1",
      "Effect": "Deny",
      "Action": [
        "iam:DeletePolicy",
        "iot:Publish",
        "iot:DescribeThingGroup"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    },
    {
      "Sid": "DenyS3GetBucketAclAndIAMAttachUserPolicy",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl",
        "iam:AttachUserPolicy"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyActionsOnForbiddenBucket2",
      "Effect": "Deny",
      "Action": [
        "iot-device-tester:SendMetrics",
        "iot:GetThingShadow"
      ],
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    },
    {
      "Sid": "DenyS3BucketPolicyActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyIoTActionsOnAdminRole",
      "Effect": "Deny",
      "Action": [
        "iot:ListThingPrincipals",
        "iot:AttachPolicy"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Sid": "DenyIAMCreateUser",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    }
  ]
}