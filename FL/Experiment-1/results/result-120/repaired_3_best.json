{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActions",
      "Effect": "Allow",
      "Action": [
        "iot:Connect",
        "iot:ListAttachedPolicies",
        "iot-device-tester:LatestIdt",
        "iot:DeleteCertificate",
        "iam:DeleteRole",
        "iam:GetPolicy",
        "iam:DetachRolePolicy",
        "iot-device-tester:SendMetrics",
        "iot:DescribeJobExecution",
        "iot:DeleteThing",
        "iot:CreateThingGroup",
        "logs:CreateLogGroup",
        "s3:CreateBucket",
        "lambda:PublishVersion",
        "iot:DescribeEndpoint",
        "logs:CreateLogStream",
        "iot:GetThingShadow",
        "iot:DescribeJob",
        "iot:DetachThingPrincipal",
        "lambda:DeleteFunction",
        "iot:RemoveThingFromThingGroup",
        "logs:PutLogEvents",
        "iot:ListThingsInThingGroup",
        "s3:DeleteObject",
        "lambda:GetFunction",
        "s3:AbortMultipartUpload",
        "iam:AttachRolePolicy",
        "s3:GetObject",
        "iot-device-tester:SupportedVersion",
        "iot:DescribeThingGroup",
        "iot:DeletePolicy",
        "iot:CreateRoleAlias",
        "iam:DeletePolicy",
        "iam:CreatePolicy",
        "s3:PutObject",
        "iot-device-tester:DownloadTestSuite",
        "iot:DescribeThing"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "iam:GetRole",
        "logs:DescribeLogStreams",
        "iot:AttachPolicy",
        "iot:DetachPolicy",
        "iot:CreateThing",
        "iot:ListThings",
        "s3:PutBucketTagging",
        "lambda:InvokeFunction",
        "iam:PassRole",
        "s3:DeleteBucket",
        "s3:ListBucketVersions",
        "iam:CreateUser",
        "iot:UpdateCertificate",
        "ec2:DescribeInstances",
        "s3:ListBucket",
        "iot:ListThingGroupsForThing",
        "s3:GetBucketAcl",
        "iot:ListThingPrincipals",
        "iam:DeleteUser",
        "iot:DeleteThingGroup"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/document.txt",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    }
  ]
}