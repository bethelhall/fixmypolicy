{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::data123"
    },
    {
      "Sid": "AllowGetBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*/data/file.json"
      ]
    },
    {
      "Sid": "AllowGetBucketAcl",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/temp/upload.tmp"
      ]
    },
    {
      "Sid": "AllowPutBucketPolicy",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": [
        "arn:aws:s3:::file1",
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::*/logs/app.log"
      ]
    },
    {
      "Sid": "AllowDeleteObject",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::*/temp/upload.tmp",
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*/document.txt"
      ]
    },
    {
      "Sid": "AllowPutObject",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::*/temp/upload.tmp",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::data123"
      ]
    },
    {
      "Sid": "AllowGetObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1"
      ]
    },
    {
      "Sid": "AllowDeleteBucket",
      "Effect": "Allow",
      "Action": "s3:DeleteBucket",
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::document"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "iam:DeleteUser",
        "s3:GetObject",
        "lambda:CreateFunction",
        "s3:ListBucket",
        "ec2:RunInstances",
        "iam:CreateUser",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::*-forbidden/file.txt",
        "arn:aws:s3:::completely-different-bucket/file.txt",
        "arn:aws:s3:::different-*/file.txt"
      ]
    },
    {
      "Sid": "DenyConflictingActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "deny-conflict"
        }
      }
    }
  ]
}