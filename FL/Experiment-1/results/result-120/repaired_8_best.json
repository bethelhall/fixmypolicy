{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/data/file.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:s3:::bucket",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::different-bucket/file.txt",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "s3:GetObject",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket/temp/upload.tmp"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "s3:GetObject",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    }
  ]
}