{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "glue:CreateScript",
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:StopNotebookInstance",
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:ListTags",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:CreatePresignedNotebookInstanceUrl",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:UpdateNotebookInstance",
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:StartNotebookInstance",
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sagemaker:CreatePresignedDomainUrl",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:StopNotebookInstance",
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/data/file.json",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:ListTags",
        "sagemaker:CreatePresignedDomainUrl"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:sagemaker:::notebook-instance/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": [
        "glue:CreateScript",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::forbidden-bucket/document.txt",
        "forbidden-arn:aws:sagemaker:::notebook-instance/*-specific",
        "arn:aws:sagemaker:::notebook-instance/logs/app.log"
      ]
    }
  ]
}