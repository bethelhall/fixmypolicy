{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowObjectOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "AllowBucketPolicyOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/document.txt",
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Sid": "DenySpecificPutObject",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::bucket/data/file.json"
      ]
    },
    {
      "Sid": "DenySpecificDeleteObject",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::bucket/logs/app.log"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "lambda:*",
        "dynamodb:*",
        "ec2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*",
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*"
      ]
    }
  ]
}