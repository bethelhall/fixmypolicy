{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSOperationsOnS3Bucket",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:CreateGrant",
        "kms:DeleteAlias",
        "kms:CreateKey",
        "kms:ScheduleKeyDeletion",
        "kms:ListGrants",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowKMSOperationsOnGlueTable",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:CreateGrant",
        "kms:RevokeGrant",
        "kms:ScheduleKeyDeletion",
        "kms:DeleteAlias",
        "kms:GenerateDataKey",
        "kms:CreateKey"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowKMSOperationsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:RevokeGrant",
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:ListGrants",
        "kms:DeleteAlias",
        "kms:Decrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ScheduleKeyDeletion",
        "kms:CreateKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyScheduleKeyDeletionOnS3Bucket",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyCreateGrantOnS3BucketAndAthena",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:CreateGrant",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyMultipleActionsOnAthenaAndGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyRevokeGrantOnS3BucketAndAthena",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:RevokeGrant",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyAllActionsOnForbiddenKey",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:CreateGrant",
        "kms:Encrypt",
        "kms:CreateKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyDecryptOnAllResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyListGrantsOnGlueTable",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:ListGrants",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyGenerateDataKeyWithoutPlaintextOnS3Bucket",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:GenerateDataKeyWithoutPlaintext",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyCreateKeyOnForbiddenBucket",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:CreateKey",
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Sid": "DenyDeleteAliasOnS3Bucket",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:DeleteAlias",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyGenerateDataKeyOnGlueTable",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:GenerateDataKey",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyListGrantsAndGenerateDataKeyWithoutPlaintextOnAthena",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:GenerateDataKeyWithoutPlaintext"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyDeleteAliasListGrantsDescribeKeyOnAthena",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:DeleteAlias",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyNonKMSActions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "ec2:RunInstances",
        "iam:DeleteUser",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}