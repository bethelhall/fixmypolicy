{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSageMakerActionsOnS3Document",
      "Effect": "Allow",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowSageMakerActionsOnNotebookInstances",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:StartNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:StopNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:::notebook-instance/logs/app.log",
        "arn:aws:sagemaker:::notebook-instance/document.txt",
        "arn:aws:sagemaker:::notebook-instance/temp/upload.tmp",
        "arn:aws:sagemaker:::notebook-instance/data/file.json"
      ]
    },
    {
      "Sid": "AllowGlueAndSageMakerOnGlueTable",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:StopNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:StartNotebookInstance",
        "sagemaker:CreatePresignedNotebookInstanceUrl",
        "sagemaker:ListTags"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowSageMakerActionsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Action": [
        "sagemaker:StopNotebookInstance",
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:StartNotebookInstance",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:DeleteNotebookInstance",
        "sagemaker:ListTags"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "AllowGlueCreateScriptOnAthenaWorkgroup",
      "Effect": "Allow",
      "Action": [
        "glue:CreateScript",
        "sagemaker:CreatePresignedNotebookInstanceUrl"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "ec2:DescribeInstances",
        "glue:UpdateTable",
        "glue:CreateTable",
        "dynamodb:PutItem",
        "iam:CreateUser",
        "lambda:CreateFunction",
        "dynamodb:DeleteItem",
        "glue:GetPartitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "unauthorized/arn:aws:sagemaker:::notebook-instance/*",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:sagemaker:::notebook-instance/*-forbidden",
        "forbidden-arn:aws:sagemaker:::notebook-instance/*"
      ]
    }
  ]
}