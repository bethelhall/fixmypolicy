{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:AttachPolicy",
        "iot:CreatePolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:AttachPolicy",
        "s3:DeleteBucket",
        "iot:DescribeEndpoint"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:GetThingShadow",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iot:AttachThingPrincipal",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreatePolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:GetThingShadow",
        "s3:AbortMultipartUpload",
        "iam:AttachRolePolicy"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:RemoveThingFromThingGroup",
        "iot:ListAttachedPolicies"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DescribeThingGroup",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iot:RemoveThingFromThingGroup",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot-device-tester:DownloadTestSuite",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:DeleteThing",
        "iot:RemoveThingFromThingGroup"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:DetachThingPrincipal",
        "iot:ListTargetsForPolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:DeleteRole",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging",
        "lambda:CreateFunction"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:ListThings",
        "iot:GetThingShadow"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:DescribeJobExecution",
        "iot:DeleteThing",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:GetPolicy",
        "logs:DescribeLogStreams",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DetachThingPrincipal",
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogGroup",
        "iot-device-tester:SendMetrics",
        "iot:CreateJob"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iot:AttachThingPrincipal",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:DetachPolicy",
        "iot:TagResource"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:DescribeJob",
        "iot:DeleteCertificate",
        "logs:CreateLogStream"
      ],
      "Resource": "arn:aws:s3:::forbidden-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DetachPolicy",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:DeletePolicy",
        "iot:ListTargetsForPolicy",
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:CreateKeysAndCertificate",
        "iot:CreateThing"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:ListAttachedPolicies",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Effect": "Deny",
      "Action": "logs:DescribeLogStreams",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iam:GetPolicy",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iot:ListThingPrincipals",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DeleteThing",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iam:ListUsers",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "iam:CreateUser",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    }
  ]
}