{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActions",
      "Effect": "Allow",
      "Action": [
        "iam:ListAttachedRolePolicies",
        "s3:CreateBucket",
        "iot:DeleteThingGroup",
        "iot:ListThingGroupsForThing",
        "iot:DescribeThing",
        "iot:DeletePolicy",
        "iam:GetPolicy",
        "iot:RemoveThingFromThingGroup",
        "iam:TagRole",
        "iot:UpdateThingShadow",
        "s3:DeleteObjectVersion",
        "iot:CreateThing",
        "iot:AddThingToThingGroup",
        "s3:PutObjectTagging",
        "iam:CreatePolicy",
        "iot:AttachPolicy",
        "s3:GetBucketLocation",
        "iot:ListAttachedPolicies",
        "iot:AttachThingPrincipal",
        "iam:AttachRolePolicy",
        "s3:PutObject",
        "iot:DescribeJob",
        "iot-device-tester:SupportedVersion",
        "logs:DescribeLogStreams",
        "iot-device-tester:DownloadTestSuite",
        "lambda:PublishVersion",
        "iam:ListEntitiesForPolicy",
        "iot:ListTargetsForPolicy",
        "lambda:DeleteFunction"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyForbiddenActions",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:DescribeInstances",
        "iam:AttachUserPolicy",
        "iot:DescribeJobExecution",
        "iam:ListUsers",
        "s3:GetBucketAcl",
        "iam:PassRole",
        "iot:CancelJob",
        "iam:DeleteUser",
        "iot:DetachPolicy",
        "iot:ListThings",
        "iam:CreateUser",
        "s3:DeleteObject",
        "s3:PutBucketPolicy",
        "iot-device-tester:LatestIdt"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::forbidden-bucket/*",
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    }
  ]
}