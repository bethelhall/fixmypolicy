{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AccessToSaveAndReadQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::athena-query-results",
        "arn:aws:s3:::athena-query-results/*"
      ]
    },
    {
      "Sid": "AllowS3AccessForGlueToReadLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bkt_logs",
        "arn:aws:s3:::bkt_logs/*"
      ]
    },
    {
      "Sid": "AllowS3AccessMyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket",
        "arn:aws:s3:::my-bucket/*"
      ]
    },
    {
      "Sid": "AllowAthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDatabase",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:GetTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "AllowGlueAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetDatabase",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "AllowKMSAccess",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyUnauthorizedActions",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "athena:CreateWorkGroup",
        "athena:DeleteWorkGroup",
        "ec2:RunInstances",
        "glue:CreateDatabase"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAccessToForbiddenBuckets",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::different-athena-query-results",
        "arn:aws:s3:::different-athena-query-results/*",
        "arn:aws:s3:::bkt_logs-forbidden",
        "arn:aws:s3:::bkt_logs-forbidden/*",
        "arn:aws:s3:::forbidden-bucket",
        "arn:aws:s3:::forbidden-bucket/*"
      ]
    }
  ]
}