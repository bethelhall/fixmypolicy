{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::bucket"
    },
    {
      "Sid": "AllowObjectOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::bucket/*"
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": [
        "ec2:*",
        "iam:*",
        "dynamodb:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::${aws:PrincipalOrgID}:root"
      },
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::different-bucket",
        "arn:aws:s3:::different-bucket/*",
        "arn:aws:s3:::completely-different-bucket",
        "arn:aws:s3:::completely-different-bucket/*",
        "arn:aws:s3:::bucket-forbidden",
        "arn:aws:s3:::bucket-forbidden/*"
      ]
    }
  ]
}