{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3Actions",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:PutBucketPolicy",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::file1",
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::document",
        "arn:aws:s3:::*/logs/app.log",
        "arn:aws:s3:::*/temp/upload.tmp",
        "arn:aws:s3:::*/document.txt"
      ]
    },
    {
      "Sid": "AllowDeleteBucketSpecific",
      "Effect": "Allow",
      "Action": "s3:DeleteBucket",
      "Resource": [
        "arn:aws:s3:::*/logs/app.log",
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::*/temp/upload.tmp"
      ]
    },
    {
      "Sid": "DenyDeleteBucketSpecific",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": [
        "arn:aws:s3:::document",
        "arn:aws:s3:::data123",
        "arn:aws:s3:::file1",
        "arn:aws:s3:::different-*/file.txt"
      ]
    },
    {
      "Sid": "DenySpecificActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::data123",
        "arn:aws:s3:::*/document.txt"
      ]
    },
    {
      "Sid": "DenyNonS3Actions",
      "Effect": "Deny",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:CreateFunction",
        "iam:CreateUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyForbiddenPaths",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::*-forbidden/file.txt"
    },
    {
      "Sid": "DenyCreateBucketData123",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::data123"
    },
    {
      "Sid": "DenyConflictingActions",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::*/document.txt",
        "arn:aws:s3:::*/data/file.json",
        "arn:aws:s3:::file1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "deny-condition"
        }
      }
    }
  ]
}