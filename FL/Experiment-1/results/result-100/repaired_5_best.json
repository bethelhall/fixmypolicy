{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Resource": "arn:aws:s3:::my-bucket/specific-file.txt",
      "Condition": {
        "StringLike": {
          "gitlab.com:sub": "project_path:{redacted}/*:ref_type:branch:ref:*"
        }
      }
    },
    {
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "lambda:CreateFunction",
        "lambda:InvokeFunction",
        "iam:DeleteUser"
      ],
      "Resource": "*"
    },
    {
      "Principal": {
        "Federated": "arn:aws:iam::{account id}:oidc-provider/gitlab.com"
      },
      "Effect": "Deny",
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Resource": "arn:aws:s3:::forbidden-bucket/file.txt"
    }
  ]
}