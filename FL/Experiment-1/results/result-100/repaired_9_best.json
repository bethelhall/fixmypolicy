{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSOperationsOnGlueTable",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:GenerateDataKey",
        "kms:CreateGrant",
        "kms:ScheduleKeyDeletion",
        "kms:Encrypt",
        "kms:RevokeGrant",
        "kms:CreateKey"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "AllowKMSOperationsOnS3Object",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:CreateKey",
        "kms:Encrypt",
        "kms:ScheduleKeyDeletion",
        "kms:ListGrants",
        "kms:DeleteAlias",
        "kms:CreateGrant",
        "kms:RevokeGrant"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "AllowKMSOperationsOnAthenaWorkgroup",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:RevokeGrant",
        "kms:CreateKey",
        "kms:GenerateDataKey",
        "kms:Encrypt",
        "kms:DeleteAlias",
        "kms:ListGrants",
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyKMSDecryptOnSpecificResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyGenerateDataKeyWithoutPlaintextOnGlueTable",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:GenerateDataKeyWithoutPlaintext",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyScheduleKeyDeletionOnAthenaWorkgroup",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyKMSOperationsOnIAMRole",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:CreateKey",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DeleteAlias",
        "kms:ScheduleKeyDeletion",
        "kms:RevokeGrant"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "DenyCreateGrantOnS3Object",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyEncryptGenerateDataKeyOnMultipleResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyScheduleKeyDeletionDescribeKeyOnMultipleResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyListGrantsDecryptOnAthenaWorkgroup",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyEncryptOnAthenaGlueResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Encrypt",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyScheduleKeyDeletionDecryptOnAthenaGlueResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyNonKMSActions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "dynamodb:PutItem",
        "iam:DeleteUser",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    }
  ]
}