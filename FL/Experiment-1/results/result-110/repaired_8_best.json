{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:DeleteObject",
        "s3:CreateBucket",
        "s3:PutObject",
        "s3:GetBucketAcl",
        "s3:DeleteBucket",
        "s3:GetObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::bucket/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:CreateBucket",
        "s3:DeleteObject",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "lambda:CreateFunction",
        "dynamodb:PutItem"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/forbidden-key",
        "arn:aws:s3:::bucket-forbidden/file.txt",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "cloudwatch:ListMetrics"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": [
        "arn:aws:s3:::bucket/data/file.json",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::bucket/temp/upload.tmp",
        "arn:aws:s3:::bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bucket"
      ]
    }
  ]
}