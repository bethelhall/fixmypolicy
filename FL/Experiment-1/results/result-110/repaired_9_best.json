{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableIAMUserPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSOperationsOnSpecificResources",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "kms:Decrypt",
        "kms:ScheduleKeyDeletion",
        "kms:DeleteAlias",
        "kms:GenerateDataKey",
        "kms:CreateKey",
        "kms:CreateGrant",
        "kms:RevokeGrant",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:Encrypt",
        "kms:ListGrants"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyForbiddenKeyAccess",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:Decrypt",
        "kms:ListGrants",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/forbidden-key"
    },
    {
      "Sid": "DenyNonKMSActions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "ec2:DescribeInstances",
        "iam:CreateUser",
        "ec2:RunInstances",
        "dynamodb:DeleteItem",
        "dynamodb:PutItem",
        "lambda:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySpecificKMSOperations",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:GenerateDataKey",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Sid": "DenyDescribeKeyOnAllowedResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:DescribeKey",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Sid": "DenyCreateKeyOnSpecificResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:CreateKey",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Sid": "DenyRevokeGrantOnS3",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:RevokeGrant",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Sid": "DenyEncryptOnGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Encrypt",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyDeleteAliasDecryptCreateKeyOnMultipleResources",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:DeleteAlias",
        "kms:Decrypt",
        "kms:CreateKey"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyEncryptOnIAMRole",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Encrypt",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Sid": "DenyCreateGrantListGrantsCreateKeyOnAthenaGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:CreateKey"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Sid": "DenyGenerateDataKeyOnGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:GenerateDataKey",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyCreateGrantOnGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Sid": "DenyListGrantsDeleteAliasOnGlue",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "kms:ListGrants",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    }
  ]
}