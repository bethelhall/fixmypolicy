{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:CreateThingGroup",
        "iot:ListThingGroupsForThing",
        "iot:DeleteCertificate"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:DescribeJobExecution",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot-device-tester:CheckVersion",
        "iot-device-tester:SendMetrics"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:CreateThing",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DescribeThingGroup",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:DescribeJob",
        "iot:DescribeRoleAlias",
        "iot:DeleteThingGroup"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:UpdateCertificate",
        "iot:DescribeCertificate"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:DeleteCertificate",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": "iam:DetachRolePolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:CreateKeysAndCertificate",
        "iot:GetThingShadow"
      ],
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DeleteRoleAlias",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iot:CancelJob",
        "iam:GetPolicy"
      ],
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot-device-tester:LatestIdt",
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObjectTagging",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Allow",
      "Action": "iot:DetachPolicy",
      "Resource": "arn:aws:s3:::my-bucket/document.txt"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:AttachPolicy",
        "lambda:DeleteFunction"
      ],
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:PutItem",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iam:DeleteUser",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:s3:::forbidden-bucket/document.txt",
        "arn:aws:iam::123456789012:role/admin-role"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "iam:ListUsers",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    },
    {
      "Effect": "Deny",
      "Action": "iot:DeleteRoleAlias",
      "Resource": [
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
        "arn:aws:s3:::my-bucket/document.txt"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iot:CancelJob",
        "lambda:CreateFunction",
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "logs:PutLogEvents",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetBucketAcl",
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketTagging",
        "iot:AddThingToThingGroup",
        "iot:AttachPolicy"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
    },
    {
      "Effect": "Deny",
      "Action": "iot-device-tester:LatestIdt",
      "Resource": "arn:aws:iam::123456789012:role/admin-role"
    },
    {
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogGroup",
        "lambda:CreateFunction",
        "lambda:GetFunction"
      ],
      "Resource": [
        "arn:aws:s3:::my-bucket/document.txt",
        "arn:aws:athena:us-east-1:123456789012:workgroup/primary"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "iot:AttachPolicy",
      "Resource": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table"
    }
  ]
}