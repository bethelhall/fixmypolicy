{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Principal": "AuthorizedUser01",
            "Effect": "Allow",
            "Action": ["sagemaker:ListTags", "sagemaker:TagResource", "sagemaker:UntagResource", 
                       "sagemaker:DeleteTags"],
            "Resource": ["arn:aws:sagemaker:::notebook-instance/*",
                         "arn:aws:sagemaker:::model/*",
                         "arn:aws:sagemaker:::endpoint/*"],
            "Condition": {
                "NumericLessThanEquals": {
                    "s3:MaxKeys": 100
                }
            }
        }
    ]
}